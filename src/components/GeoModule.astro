---
import { SITE_AUTHOR, SITE_URL, PROFILE_IMAGE, SAME_AS, SITE_AUTHOR_ALT } from '../consts';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	lang?: string;
	tags?: string[];
	series?: string;
	heroImage?: string;
	url: string;
	tldr?: string;
	showCitation?: boolean;
}

const { title, description, pubDate, updatedDate, lang = 'en', tags, series, heroImage, url, tldr, showCitation = true } = Astro.props;

const plainTitle = title.replace(/<[^>]+>/g, '');

// BlogPosting structured data makes every article a citable entity for AI answer engines
const blogPostingLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: plainTitle,
	description,
	inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	...(heroImage ? { image: heroImage } : {}),
	...(tags && tags.length ? { keywords: tags.join(', ') } : {}),
	...(series ? { isPartOf: { '@type': 'CreativeWorkSeries', name: series } } : {}),
	author: {
		'@type': 'Person',
		name: SITE_AUTHOR,
		alternateName: SITE_AUTHOR_ALT,
		url: SITE_URL,
		image: PROFILE_IMAGE,
		sameAs: SAME_AS,
	},
	publisher: { '@type': 'Person', name: SITE_AUTHOR, url: SITE_URL },
	mainEntityOfPage: { '@type': 'WebPage', '@id': url },
};

// Generate BibTeX citation for academic and AI reference extraction
const citationId = `${SITE_AUTHOR.split(' ').pop()?.toLowerCase() || 'author'}${pubDate.getFullYear()}`;
const citationText = `@misc{${citationId},
  title = {${plainTitle}},
  author = {${SITE_AUTHOR}},
  year = {${pubDate.getFullYear()}},
  howpublished = {\\url{${url}}}
}`;
---

<!-- JSON-LD Injection -->
<script type="application/ld+json" set:html={JSON.stringify(blogPostingLd)} />

<!-- TL;DR AI Summary Block -->
{tldr && (
	<div class="geo-tldr">
		<div class="geo-tldr-header">
			<span class="geo-icon">🤖</span>
			<strong>TL;DR / AI Summary</strong>
		</div>
		<p>{tldr}</p>
	</div>
)}

<!-- Main Content Slot -->
<slot />

<!-- Citation Block for AI/Academic references -->
{showCitation && (
	<div class="geo-citation">
		<div class="geo-citation-header">
			<span class="geo-icon">🔗</span>
			<strong>Citation (BibTeX)</strong>
		</div>
		<pre><code>{citationText}</code></pre>
	</div>
)}

<style>
	.geo-tldr {
		background: var(--apaper-card);
		border: 1px solid var(--apaper-accent-line);
		border-left: 3px solid var(--apaper-accent);
		padding: 1.15rem 1.25rem;
		margin: 1.5rem 0 2.5rem 0;
		border-radius: 0 12px 12px 0;
	}
	.geo-tldr-header, .geo-citation-header {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.5rem;
		color: var(--apaper-accent);
		font-family: var(--apaper-font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}
	.geo-tldr-header strong, .geo-citation-header strong {
		font-weight: 700;
		letter-spacing: inherit;
	}
	.geo-tldr p {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--apaper-ink-secondary);
		font-family: var(--apaper-font-sans);
	}
	.geo-citation {
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px dashed var(--apaper-line);
	}
	.geo-citation pre {
		background: var(--apaper-bg-alt);
		padding: 1rem 1.25rem;
		border-radius: 8px;
		font-size: 0.85rem;
		overflow-x: auto;
		color: var(--apaper-ink-secondary);
		border: 1px solid var(--apaper-line);
		font-family: var(--apaper-font-mono);
	}
</style>
