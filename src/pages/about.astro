---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, PROFILE_IMAGE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="About Me | Victor Zhang" description={SITE_DESCRIPTION} />
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "ProfilePage",
			"mainEntity": {
				"@type": "Person",
				"name": "Victor Zhang",
				"alternateName": ["Yiwei Zhang", "zywkloo"],
				"jobTitle": "Mobile & Systems Engineer",
				"worksFor": {
					"@type": "Organization",
					"@id": "https://zywkloo.github.io/#goldenarc",
					"name": "GoldenARC Digital"
				},
				"alumniOf": [
					{
						"@type": "EducationalOrganization",
						"name": "University of British Columbia"
					},
					{
						"@type": "EducationalOrganization",
						"name": "Peking University"
					}
				],
				"knowsAbout": ["iOS Development", "Swift", "React Native", "FastAPI", "Agentic Workflows"],
				"sameAs": [
					"https://github.com/zywkloo",
					"https://zywkloo.github.io"
				]
			}
		}
		</script>
	</head>
	<body>
		<Header />
		<main class="about-page">
			<section class="about-hero container" aria-labelledby="about-title">
				<div class="profile-stamp">
					<img src={PROFILE_IMAGE} alt="Victor Zhang" class="about-profile-image" />
					<span>VICTOR ZHANG</span>
					<small>VANCOUVER · BC</small>
				</div>
				<div class="hero-copy">
					<p class="section-kicker">PROFILE // MOBILE &amp; SYSTEMS</p>
					<h1 id="about-title" class="sr-only">Mobile systems, from device signal to cloud</h1>
					<figure class="system-diagram" aria-label="IoT signals pass through a protocol handshake into native interop. Native work forks directly into the render buffer and through gateway control to cloud processing and storage. Stored state reconciles back through the gateway into the render buffer.">
						<svg class="system-flow" viewBox="0 0 1000 260" preserveAspectRatio="none" aria-hidden="true">
							<path class="flow-line" d="M100 7C112 32 130 52 180 70" />
							<path class="flow-line" d="M180 70C225 83 270 101 340 115" />
							<path class="flow-line" d="M340 115C380 150 440 177 500 199" />
							<path class="flow-line" d="M340 115C420 80 580 80 660 115" />
							<path class="flow-line" d="M900 7C888 32 870 52 820 70" />
							<path class="flow-line" d="M820 70C775 83 730 101 660 115" />
							<path class="flow-line" d="M660 115C620 150 560 177 500 199" />
							<path id="flow-local" class="flow-return" d="M100 7C112 32 130 52 180 70C225 83 270 101 340 115C380 150 440 177 500 199" />
							<path id="flow-outbound" class="flow-return" d="M100 7C112 32 130 52 180 70C225 83 270 101 340 115C420 80 580 80 660 115C730 101 775 83 820 70C870 52 888 32 900 7" />
							<path id="flow-return" class="flow-return" d="M900 7C888 32 870 52 820 70C775 83 730 101 660 115C620 150 560 177 500 199" />
							<circle class="local-pulse" r="2.4"><animateMotion dur="8s" repeatCount="indefinite"><mpath href="#flow-local" /></animateMotion></circle>
							<circle class="outbound-pulse" r="2.4"><animateMotion dur="8s" repeatCount="indefinite"><mpath href="#flow-outbound" /></animateMotion></circle>
							<circle class="return-pulse" r="2.6"><animateMotion dur="8s" repeatCount="indefinite"><mpath href="#flow-return" /></animateMotion></circle>
						</svg>
						<ol>
							<li><span>01</span><strong>IoT Signals</strong></li>
							<li><span>02</span><strong>Protocol Handshake</strong></li>
							<li><span>03</span><strong>Native Interop</strong></li>
							<li><span>04</span><strong>Render Buffer</strong></li>
							<li><span>05</span><strong>Gateway Control</strong></li>
							<li><span>06</span><strong>Cloud Processing</strong></li>
							<li><span>07</span><strong>Storage</strong></li>
						</ol>
						<span class="flow-arrow flow-arrow-top-one" aria-hidden="true">&gt;&gt;</span>
						<span class="flow-arrow flow-arrow-top-two" aria-hidden="true">&gt;&gt;</span>
						<span class="flow-arrow flow-arrow-top-three" aria-hidden="true">&gt;&gt;</span>
						<span class="flow-arrow flow-arrow-top-four" aria-hidden="true">&gt;&gt;</span>
						<span class="flow-arrow flow-arrow-top-five" aria-hidden="true">&gt;&gt;</span>
						<span class="flow-arrow flow-arrow-branch-render" aria-hidden="true">&gt;&gt;</span>
						<span class="flow-arrow flow-arrow-return-storage" aria-hidden="true">&gt;&gt;</span>
						<span class="flow-arrow flow-arrow-return-cloud" aria-hidden="true">&gt;&gt;</span>
						<span class="flow-arrow flow-arrow-return-gateway" aria-hidden="true">&gt;&gt;</span>
						<span class="flow-reconcile" aria-hidden="true">RECONCILE</span>
						<figcaption class="system-footnote">7 BRIDGES OF SYSTEMS</figcaption>
					</figure>
					<p class="hero-lead">I translate device capabilities and native boundaries into responsive product interfaces and reliable services—without losing the constraints that matter at each handoff.</p>
					<div class="hero-actions">
						<a href="/#work">Selected work ↗</a>
						<a href="mailto:yiweizhangcool@gmail.com">Direct email ↗</a>
					</div>
				</div>
			</section>

			<section class="signal-strip" aria-label="Professional summary">
				<div class="container signal-grid">
					<div><strong>7+</strong><span>years shipping</span></div>
					<div><strong>3</strong><span>markets: US · Canada · China</span></div>
					<div><strong>Native ↔ Cloud</strong><span>one operating surface</span></div>
				</div>
			</section>

			<section class="about-section container" aria-labelledby="focus-title">
				<div class="section-heading">
					<p class="section-kicker">01 // OPERATING FOCUS</p>
					<h2 id="focus-title">The parts that make a product dependable.</h2>
				</div>
				<div class="focus-list">
					<article><span>01</span><div><h3>Signal → state</h3><p>BLE, APIs, and local persistence become coherent UI—not a collection of race conditions.</p></div></article>
					<article><span>02</span><div><h3>Policies that hold</h3><p>Cache, retry, sync, and observability are designed for intermittent networks and long sessions.</p></div></article>
					<article><span>03</span><div><h3>Product-ready delivery</h3><p>Native depth where it matters; React Native leverage where it helps.</p></div></article>
				</div>
			</section>

			<section class="about-section container" aria-labelledby="experience-title">
				<div class="section-heading">
					<p class="section-kicker">02 // SELECTED EXPERIENCE</p>
					<h2 id="experience-title">A short record of ownership.</h2>
				</div>
				<div class="experience-list">
					<article class="experience-row">
						<p>2025 — NOW</p><div><h3>Medico Supplies</h3><span>Mobile Engineer &amp; Platform Developer</span></div><ul><li>Health-data services: FastAPI, Redis, async processing</li><li>React Native with Swift/Kotlin BLE and sync modules</li></ul>
					</article>
					<article class="experience-row">
						<p>2024 — 2025</p><div><h3>NinjaTech AI</h3><span>Senior Mobile / Frontend Engineer</span></div><ul><li>Mixed-content agent streaming across web and mobile</li><li>60fps React Native research and citation interfaces</li></ul>
					</article>
					<article class="experience-row">
						<p>2020 — 2023</p><div><h3>TutorOcean</h3><span>Mobile Developer</span></div><ul><li>Led React Native iOS/Android maintenance and the SwiftUI/Combine replacement</li><li>Owned auth, WebSocket recovery, cross-platform parity, and App Store delivery</li></ul>
					</article>
					<article class="experience-row">
						<p>2013 — 2015</p><div><h3>KV Games</h3><span>Lead Game Designer &amp; Dev Lead · Wild Dunk</span></div><ul><li><strong>#1</strong> Sports · <strong>#9</strong> Overall, China App Store</li><li>Product, monetization, and cross-functional delivery</li></ul>
					</article>
				</div>
			</section>

			<section class="governance-section" id="agent-governance-workflow" aria-labelledby="governance-title">
				<span id="Vibecodingworkflow"></span><span id="vibe-coding-workflow"></span>
				<div class="container governance-layout">
					<div>
						<p class="section-kicker">03 // AGENT GOVERNANCE</p>
						<h2 id="governance-title">Agents need a contract, not a vibe.</h2>
						<p>I built <strong>wtcraft</strong> to keep parallel agent work scoped, inspectable, and verifiable in plain Git worktrees.</p>
						<div class="hero-actions">
							<a href="/wtcraft">Explore wtcraft ↗</a>
							<a href="https://github.com/zywkloo/wtcraft" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
						</div>
					</div>
					<ol class="governance-steps">
						<li><strong>Contract</strong><span>Scope · off-limits · verification</span></li>
						<li><strong>Isolation</strong><span>One task, one Git worktree</span></li>
						<li><strong>Gate</strong><span>Check every changed surface</span></li>
					</ol>
				</div>
			</section>

			<section class="about-section container capability-section" aria-labelledby="capability-title">
				<div class="section-heading">
					<p class="section-kicker">04 // TOOLKIT</p>
					<h2 id="capability-title">A compact working set.</h2>
				</div>
				<div class="capability-grid">
					<div><h3>Client systems</h3><p>Swift · SwiftUI · UIKit · React Native · CoreBluetooth</p></div>
					<div><h3>Data services</h3><p>Python · FastAPI · Node.js · Redis · Postgres</p></div>
					<div><h3>Production craft</h3><p>State modeling · telemetry · Git · CI/CD · product delivery</p></div>
				</div>
				<p class="education-line"><strong>Education</strong> · MDS, UBC · BCS, Carleton University · BEng, Peking University</p>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.about-page {
		padding: clamp(3rem, 7vw, 5.5rem) 0;
	}

	.container {
		max-width: 820px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.about-profile-image {
		width: 128px;
		height: 128px;
		border-radius: 50%;
		object-fit: cover;
		margin: 0 auto 1.5rem;
		display: block;
		border: 4px solid var(--surface-raised);
		box-shadow: 0 0 0 1px var(--line), var(--shadow-md);
	}

	h1 {
		font-size: clamp(2.2rem, 5vw, 3rem);
		margin-bottom: 2.5rem;
		color: rgb(var(--black));
		text-align: center;
		letter-spacing: -0.02em;
	}

	h2 {
		font-size: clamp(1.5rem, 3vw, 1.9rem);
		margin-top: 3.5rem;
		margin-bottom: 1.25rem;
		color: rgb(var(--black));
		padding-bottom: 0.6rem;
		border-bottom: 1px solid var(--line);
	}

	p {
		font-size: 1.075rem;
		line-height: 1.8;
		margin-bottom: 1.4rem;
		color: rgb(var(--gray-dark));
	}

	p strong {
		color: var(--accent-dark);
	}

	ul {
		font-size: 1.05rem;
		line-height: 1.8;
		margin-bottom: 2rem;
		padding-left: 1.5rem;
	}

	ul li {
		margin-bottom: 0.5rem;
		color: rgb(var(--gray-dark));
	}

	.agent-harness-card {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.35rem;
		margin: 1.25rem 0 2.5rem;
		padding: clamp(1.35rem, 3vw, 1.8rem);
		border: 1px solid var(--line);
		border-left: 3px solid var(--accent);
		border-radius: var(--radius);
		background:
			linear-gradient(135deg, rgba(var(--accent-rgb), 0.08), rgba(255, 255, 255, 0.88)),
			var(--surface-raised);
		box-shadow: var(--shadow-md);
	}

	.agent-harness-card h3 {
		font-size: clamp(1.25rem, 3vw, 1.55rem);
		margin: 0.35rem 0 0.75rem;
		color: rgb(var(--black));
	}

	.agent-harness-card p {
		margin-bottom: 0;
	}

	.harness-bullets {
		list-style: none;
		padding: 0;
		margin: 0.75rem 0 1.1rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.harness-bullets li {
		position: relative;
		padding-left: 1.15rem;
		margin-bottom: 0;
		font-size: 0.92rem;
		line-height: 1.45;
		color: rgb(var(--gray-dark));
	}

	.harness-bullets li::before {
		content: "•";
		position: absolute;
		left: 0;
		top: 0;
		color: var(--accent);
		font-weight: 700;
		font-size: 1.1em;
	}

	.harness-bullets li strong {
		color: rgb(var(--black));
	}

	.harness-bullets li code {
		font-size: 0.88em;
		padding: 0.12em 0.35em;
		border-radius: 4px;
		background: rgba(var(--accent-rgb), 0.08);
	}

	.harness-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.2rem;
	}

	.harness-links a {
		display: inline-flex;
		align-items: center;
		padding: 0.55rem 0.9rem;
		border-radius: 999px;
		background: var(--surface-raised);
		border: 1px solid rgba(var(--accent-rgb), 0.18);
		box-shadow: var(--shadow-sm);
		font-size: 0.9rem;
		font-weight: 700;
	}

	.harness-links .wtcraft-link {
		background: var(--accent);
		color: #fff;
		border-color: transparent;
		box-shadow: var(--shadow-accent);
	}

	.harness-links .wtcraft-link:hover {
		background: var(--accent-dark);
		color: #fff;
		transform: translateY(-1px);
	}

	.wtcraft-link span {
		margin-left: 0.28rem;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 1.05em;
		letter-spacing: 0.01em;
	}

	.handoff-diagram {
		display: grid;
		gap: 0.65rem;
		padding: 1rem;
		border-radius: calc(var(--radius) - 4px);
		background: var(--surface-deep);
		border: 1px solid rgba(255, 255, 255, 0.08);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
	}

	.diagram-node {
		padding: 0.85rem 0.95rem;
		border-radius: 10px;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.09);
	}

	.diagram-node span,
	.diagram-node small {
		display: block;
	}

	.diagram-node span {
		color: #f8fafc;
		font-weight: 700;
	}

	.diagram-node small {
		margin-top: 0.2rem;
		color: #a5b4fc;
		font-size: 0.78rem;
		letter-spacing: 0.02em;
	}

	.diagram-node-contract {
		background: rgba(var(--accent-rgb), 0.22);
		border-color: rgba(165, 180, 252, 0.34);
	}

	.diagram-arrow {
		color: #cbd5e1;
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-align: center;
	}

	.design-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		margin: 1.75rem 0 2.5rem;
	}

	.design-card {
		background: var(--surface-raised);
		padding: 1.4rem 1.5rem;
		border-radius: var(--radius);
		border: 1px solid var(--line);
		border-left: 3px solid var(--accent);
		box-shadow: var(--shadow-sm);
		transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
	}
	.design-card:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-md);
	}

	.design-card h3 {
		font-size: 1.05rem;
		margin-bottom: 0.5rem;
		color: var(--accent-dark);
	}

	.design-card p {
		font-size: 0.97rem;
		line-height: 1.7;
		margin-bottom: 0;
		color: rgb(var(--gray));
	}

	@media (min-width: 768px) {
		.design-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.agent-harness-card {
			grid-template-columns: minmax(0, 1.25fr) minmax(260px, 0.75fr);
			align-items: center;
		}
	}

	.tech-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
		margin-top: 2rem;
	}

	@media (min-width: 640px) {
		.tech-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1000px) {
		.tech-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	.tech-category {
		background: var(--surface-raised);
		padding: 1.5rem;
		border-radius: var(--radius);
		border: 1px solid var(--line);
		box-shadow: var(--shadow-sm);
	}

	.tech-category h3 {
		font-size: 1.05rem;
		margin-bottom: 0.85rem;
		color: var(--accent-dark);
		letter-spacing: 0.01em;
	}

	.tech-category ul {
		list-style: none;
		padding: 0;
		margin: 0;
		font-size: 0.97rem;
	}

	.tech-category li {
		padding: 0.5rem 0;
		border-bottom: 1px solid var(--line);
		color: rgb(var(--gray-dark));
	}

	.tech-category li:last-child {
		border-bottom: none;
	}

	.experience-item {
		margin-bottom: 1.5rem;
		padding: 1.6rem;
		background: var(--surface-raised);
		border-radius: var(--radius);
		border: 1px solid var(--line);
		border-left: 3px solid var(--accent);
		box-shadow: var(--shadow-sm);
	}

	.experience-item h3 {
		font-size: 1.15rem;
		margin-bottom: 0.35rem;
		color: rgb(var(--black));
	}

	.experience-date {
		font-size: 0.82rem;
		color: var(--accent);
		margin-bottom: 1rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		font-style: normal;
	}

	.experience-item ul {
		margin-bottom: 0;
	}

	/* About shares apaper tokens with Home; its distinction comes from content hierarchy, not a separate skin. */
	.about-page {
		--about-ink: var(--apaper-ink);
		--about-muted: var(--apaper-ink-secondary);
		--about-line: var(--apaper-line);
		--about-wash: var(--apaper-bg-alt);
		--about-accent: var(--apaper-accent);
		width: 100%;
		max-width: 100%;
		margin: 0;
		padding: clamp(3rem, 7vw, 6.5rem) 0 0;
		background: var(--apaper-bg);
		color: var(--about-ink);
	}
	.about-page .container {
		width: min(960px, calc(100% - 3rem));
		max-width: none;
		padding: 0;
	}
	.about-hero {
		display: grid;
		grid-template-columns: 210px minmax(0, 1fr);
		gap: clamp(2rem, 6vw, 6rem);
		align-items: center;
		padding-bottom: clamp(3rem, 7vw, 6rem);
	}
	.profile-stamp {
		display: grid;
		justify-items: start;
		gap: 0.45rem;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: var(--about-ink);
	}
	.about-page .about-profile-image {
		width: 164px;
		height: 164px;
		margin: 0 0 0.75rem;
		border: 1px solid var(--about-ink);
		border-radius: 10px;
		box-shadow: 10px 10px 0 var(--about-wash);
	}
	.profile-stamp small {
		font-size: 0.64rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		color: var(--about-muted);
	}
	.section-kicker {
		margin: 0 0 0.9rem;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.13em;
		color: var(--about-accent);
	}
	.about-page h1,
	.about-page h2,
	.about-page h3,
	.about-page p {
		color: var(--about-ink);
	}
	.system-diagram {
		position: relative;
		max-width: 900px;
		margin: 0;
		height: 260px;
	}
	.system-diagram ol {
		position: relative;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.system-diagram li {
		position: relative;
	}
	.system-diagram li::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 0.78rem;
		height: 0.78rem;
		box-sizing: border-box;
		border: 2px solid var(--about-accent);
		border-radius: 50%;
		background: var(--apaper-bg);
	}
	.system-diagram li:not(:last-child)::after {
		position: absolute;
	}
	.system-diagram li > span {
		display: block;
		margin-bottom: 0.35rem;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.63rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: var(--about-accent);
	}
	.system-diagram strong {
		display: block;
		white-space: nowrap;
		font-family: "Atkinson", system-ui, sans-serif;
		font-size: clamp(0.76rem, 1.25vw, 0.98rem);
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: -0.01em;
		color: var(--about-ink);
	}
	/* Client-side render is immediate; persisted cloud state returns through the reconcile loop. */
	.system-diagram {
	}
	.system-diagram ol {
		display: block;
		height: 100%;
	}
	.system-diagram ol::before,
	.system-diagram li:not(:last-child)::after,
	.signal-pair { display: none; }
	.system-diagram li {
		position: absolute;
		width: 20%;
		min-width: 0;
		padding: 1.15rem 0 0;
		text-align: center;
		transform: translateX(-50%);
	}
