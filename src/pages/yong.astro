---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_URL, SITE_AUTHOR_ALT } from '../consts';

const APP_STORE_URL = 'https://apps.apple.com/ca/app/wishes-by-hand/id6774579880';

// MobileApplication structured data for Wishes by Hand (亲笔小卡).
// The app rebranded from "永字八法 / 8 Strokes" (a calligraphy scorer) into a
// gentle-reconnection handwriting-card app; the old names stay as alternateName
// so calligraphy search traffic still resolves here.
const appLd = {
	'@context': 'https://schema.org',
	'@type': 'MobileApplication',
	name: 'Wishes by Hand / 亲笔小卡',
	alternateName: ['亲笔小卡', '親筆小卡', '永字八法', '8 Strokes'],
	applicationCategory: 'LifestyleApplication',
	operatingSystem: 'iOS, iPadOS',
	url: APP_STORE_URL,
	installUrl: APP_STORE_URL,
	downloadUrl: APP_STORE_URL,
	inLanguage: ['zh-Hans', 'zh-Hant', 'en'],
	description:
		'Wishes by Hand (亲笔小卡) — a handwriting app for quiet human reconnection. Write a few words by hand, turn them into a small card, and send it to the people you care about. An optional 永字八法 practice room grades your strokes on-device.',
	screenshot: `${SITE_URL}/images/wishes-who.png`,
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	author: { '@type': 'Person', name: 'Victor Zhang', alternateName: SITE_AUTHOR_ALT, url: SITE_URL },
};
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title="亲笔小卡 · Wishes by Hand | 手写一点心意，给在乎的人"
			description="亲笔小卡 (Wishes by Hand)：亲手写几句话，做成一张小卡片，寄给父母、家人与老朋友。为「轻轻重新联系」而生的手写 App，附带可选的永字八法练习房。"
		/>
		<script type="application/ld+json" is:inline set:html={JSON.stringify(appLd)} />
	</head>
	<body>
		<Header />
		<main class="yong-page">
			<div class="hero-container">
				<div class="hero-content">
					<div class="app-tag">🖌️ App Store · iPhone &amp; iPad · Now Available</div>
					<h1>亲笔小卡 · Wishes by Hand</h1>
					<p class="subtitle">手写一点心意，给在乎的人。</p>
					<p class="tagline">亲手写下几句话，做成一张小卡片，寄给父母、家人，或那个你一直想联系却迟迟没开口的人。<br /><span class="en-sub">Write a few words by hand, turn them into a small card, and send it to someone you care about.</span></p>

					<div class="cta-group">
						<a href={APP_STORE_URL} target="_blank" rel="noopener" class="btn btn-primary">App Store 下载 / Download</a>
						<a href="#features" class="btn btn-secondary">核心特色 / Features</a>
					</div>
					<p class="coming-soon">🕊️ 比一通电话更轻，比一条消息更有温度<br /><span class="en-sub">简体中文 · 繁體中文 · English · iCloud 同步 / Lighter than a call, warmer than a text</span></p>
				</div>

				<div class="hero-preview">
					<img src="/images/04_blessing_card_ipad.png" alt="亲笔小卡 手写祝福卡片预览 / Wishes by Hand handwritten card preview" class="framed-mockup" />
				</div>
			</div>

			<section class="loop-section">
				<h2>从想起一个人开始 / It Starts With Someone on Your Mind</h2>
				<p class="loop-subtitle">当电话太正式、消息太轻，实体贺卡又太麻烦时，夜晚书信模式陪你慢慢写下一点真心话。<br /><span class="en-sub">When a call feels too formal and a text feels too bare, the late-night letter mode helps you write, slowly.</span></p>

				<div class="steps-grid">
					<div class="step-card">
						<div class="phone-frame">
							<img src="/images/wishes-onmind.png" alt="书写提示：有谁忽然浮现在你脑海？ / Prompt: has someone suddenly come to mind?" loading="lazy" />
						</div>
						<div class="step-body">
							<span class="step-num">1</span>
							<h4>想起一个人 / Someone comes to mind</h4>
							<p>从一个忽然浮现的名字开始 —— 父母、伴侣、孩子、家乡，或很久没联系的老友。</p>
							<small>Start from a name that surfaces — a parent, a partner, a child, your hometown, or an old friend.</small>
						</div>
					</div>

					<div class="step-card">
						<div class="phone-frame">
							<img src="/images/wishes-writeslow.png" alt="书写提示：慢慢写，一笔一画，他们会回到你身边 / Prompt: write slowly, stroke by stroke" loading="lazy" />
						</div>
						<div class="step-body">
							<span class="step-num">2</span>
							<h4>亲手慢慢写 / Write it by hand</h4>
							<p>用手指或 Apple Pencil 一笔一画写下心意，墨迹如落在宣纸上，慢一点，也更认真一点。</p>
							<small>Write with your finger or Apple Pencil; your strokes fall like brush ink on rice paper.</small>
						</div>
					</div>

					<div class="step-card">
						<div class="phone-frame">
							<img src="/images/wishes-who.png" alt="选择写给谁：父母 / 伴侣 / 孩子 / 家乡 / 老友 / Choose who to write to" loading="lazy" />
						</div>
						<div class="step-body">
							<span class="step-num">3</span>
							<h4>成卡 · 寄出 / Make a card &amp; send</h4>
							<p>把手写字做成一张国风小卡，一键分享到短信、微信、WhatsApp、Instagram。</p>
							<small>Turn it into a card and share in one tap via Messages, WeChat, WhatsApp, or Instagram.</small>
						</div>
					</div>
				</div>
			</section>

			<section class="demo-section">
				<h2>手写成墨 · 成卡即发 / Ink That Feels Handwritten</h2>
				<p class="demo-subtitle">低延迟渲染引擎让每一笔都有毛笔的顿挫与晕染；写完，就是一张可以发出去的卡。<br /><span class="en-sub">A low-latency engine gives every stroke real brush character — and what you write is already a card worth sending.</span></p>

				<div class="demo-grid">
					<div class="demo-card">
						<div class="video-container">
							<video autoplay loop muted playsinline class="demo-video">
								<source src="/videos/yong-demo-2.mp4" type="video/mp4" />
								Your browser does not support the video tag.
							</video>
						</div>
						<div class="demo-info">
							<h4>指尖即墨 · 实时渲染 / Real-time Ink</h4>
							<p>无缝捕捉压感与轨迹，完美呈现水墨晕染与笔锋顿挫，让你的字有手写的温度。</p>
							<small>Pressure and trajectory are captured seamlessly to produce authentic ink-wash strokes with real handwritten warmth.</small>
						</div>
					</div>

					<div class="demo-card">
						<div class="video-container">
							<video autoplay loop muted playsinline class="demo-video shift-down" aria-label="回放评分卡演示 / Replay card demo">
								<source src="/videos/replay-score-card.mp4" type="video/mp4" />
								Your browser does not support the video tag.
							</video>
						</div>
						<div class="demo-info">
							<h4>逐笔回放 · 一键分享 / Replay &amp; Share</h4>
							<p>把手写小瞬间逐笔回放，配上落款钤印，做成一张温暖体面、值得发出去的小卡片。</p>
							<small>Replay each stroke, add a seal-style signature, and share a card that feels warmer than chat, lighter than a long call.</small>
						</div>
					</div>
				</div>
			</section>

			<section id="features" class="features-section">
				<h2>核心特色 / Core Features</h2>
				<div class="features-grid">
					<div class="feature-card">
						<div class="feature-icon">✍️</div>
						<h3>亲手书写 / Handwriting by Hand</h3>
						<p>无需纸墨，指尖即笔。屏幕上呈现如宣纸般晕染的优美墨迹，还原汉字横折撇捺的骨骼与神韵。</p>
						<small>No ink or paper needed — draw naturally with your finger or Apple Pencil, in a brush-like ink style on rice paper.</small>
					</div>

					<div class="feature-card">
						<div class="feature-icon">🕯️</div>
						<h3>写给谁 · 夜晚书信 / Who Is This For</h3>
						<p>从想到一个人开始，夜晚书信模式陪你慢慢写，把回答拼成一封给父母或老友的手写信。</p>
						<small>A "who is this for" composer and a late-night letter mode help you write, slowly, to the people who matter.</small>
					</div>

					<div class="feature-card">
						<div class="feature-icon">🧧</div>
						<h3>国风手写小卡 / Classic Cards</h3>
						<p>宣纸、朱砂、水墨、洒金等主题，加上落款钤印，让一句小小的话变成一张温暖体面的卡片。</p>
						<small>Rice-paper, cinnabar, ink, and gold-fleck themes with a seal-style signature turn a short line into a heartfelt card.</small>
					</div>

					<div class="feature-card">
						<div class="feature-icon">🕸️</div>
						<h3>亲友图谱 / Relationship Map</h3>
						<p>记住你曾写给谁，把每一次寄出汇成一张关系图谱，让重要的人不被聊天记录淹没。</p>
						<small>A relationship map remembers who you've written to, so care doesn't disappear into the chat scroll.</small>
					</div>

					<div class="feature-card">
						<div class="feature-icon">✉️</div>
						<h3>一键分享 / One-tap Share</h3>
						<p>做好的小卡片可一键分享到短信、微信、WhatsApp、Instagram 等日常渠道，随手相赠。</p>
						<small>Share finished cards in one tap through Messages, WeChat, WhatsApp, Instagram, and more.</small>
					</div>

					<div class="feature-card">
						<div class="feature-icon">🖋️</div>
						<h3>永字八法练习房 / Practice Room</h3>
						<p>想把字写得更好？可选的「永字八法」练习房用端侧评分帮你打磨笔法，纯属自愿，不打扰书信。</p>
						<small>Want to write better? An optional 永字八法 practice room grades your strokes on-device — entirely opt-in.</small>
					</div>
				</div>
			</section>

			<section class="practice-section">
				<h2>永字八法练习房（可选）/ Optional 永字八法 Practice Room</h2>
				<p class="practice-subtitle">如果你想把每一笔写得更稳，练习房用规则与 ML 引擎从笔法、字形、平衡、流势多维度即时打分 —— 全程离线，纯属自愿。<br /><span class="en-sub">Want steadier strokes? The practice room scores Stroke / Shape / Balance / Flow on-device — fully offline, entirely optional.</span></p>

				<div class="practice-grid">
					<div class="video-container practice-video">
						<video autoplay loop muted playsinline class="demo-video demo-video-zoom" aria-label="端侧智能评分演示 / On-device scoring demo">
							<source src="/videos/yong-demo-1.mp4" type="video/mp4" />
							Your browser does not support the video tag.
						</video>
					</div>
					<figure class="practice-shot">
						<img src="/images/wishes-practice-score.png" alt="永字八法练习房 · 四维评分 / Practice room four-dimension scoring" loading="lazy" />
						<figcaption>四维评分：笔法 / 字形 / 平衡 / 流势<br /><span class="en-sub">Scored on Stroke / Shape / Balance / Flow</span></figcaption>
					</figure>
					<figure class="practice-shot">
						<img src="/images/wishes-practice-levels.png" alt="永字八法练习房 · 关卡与祝福短句 / Practice room levels and blessing phrases" loading="lazy" />
						<figcaption>关卡循序渐进，练成一句祝福短句<br /><span class="en-sub">Levels build up to a whole blessing phrase</span></figcaption>
					</figure>
				</div>
			</section>

			<section id="support" class="support-section">
				<div class="section-container">
					<h2>技术支持 / Support</h2>
					<div class="contact-card">
						<h4>✉️ 联系我们 / Contact</h4>
						<p><a href="mailto:victor@goldenarc.digital">victor@goldenarc.digital</a></p>
						<small>使用中有任何疑问、Bug 或功能建议，欢迎来信，我们通常 24 小时内回复。<br />Questions, bugs, or feature ideas? Email us — we usually reply within 24 hours.</small>
					</div>
				</div>
			</section>

			<section id="privacy" class="privacy-section">
				<div class="section-container">
					<h2>隐私政策 / Privacy Policy</h2>
					<p class="update-date">最后更新日期：2026年7月23日 · Last updated: July 23, 2026</p>

					<div class="privacy-content">
						<h3>1. 个人数据收集说明 / No Personal Data Collection</h3>
						<p><strong>亲笔小卡 (Wishes by Hand)</strong> 极其尊重您的个人隐私。我们<strong>不会收集、存储、分享或上传</strong>您的任何个人信息、手写笔迹数据、卡片内容、评分结果或设备标识符。</p>
						<p class="english-law">We do not collect, store, share, or upload any of your personal information, handwriting, card contents, scores, or device identifiers.</p>

						<h3>2. 端侧处理保证 / 100% On-Device Processing</h3>
						<p>应用内所有的轨迹演算、图形网格生成以及练习房的智能评分，均<strong>完全在您的本地设备上进行（On-Device Processing）</strong>。评分模型（包括规则引擎与 CoreML 技术）全部离线运行，无需联网，保证您的书写与卡片绝对私密安全。</p>
						<p class="english-law">All calculations, brush tessellation, and practice-room scoring are computed entirely offline and locally on your device.</p>

						<h3>3. iCloud 同步 / iCloud Sync</h3>
						<p>若您选择开启同步，您的作品与卡片会通过您自己的私人 iCloud 账户在您的设备之间同步。这些数据存放在<strong>您本人的 Apple iCloud 中</strong>，我们无法访问，也不会收集。</p>
						<p class="english-law">If you enable sync, your work and cards sync across your devices through your own private iCloud account, which we cannot access.</p>

						<h3>4. 第三方SDK与广告 / No Third-party SDKs or Ads</h3>
						<p>本应用<strong>不包含任何第三方广告 SDK 或数据分析追踪工具</strong>，我们致力于为您提供纯净无干扰的书写空间。</p>
						<p class="english-law">The application does not integrate any advertising SDKs or tracking tools.</p>

						<h3>5. 隐私政策的更新 / Updates</h3>
						<p>我们可能会不时更新本隐私政策。若有任何重大更改，我们将通过应用内公告或此网页及时告知您。</p>
						<p class="english-law">We may update this privacy policy from time to time. Any material changes will be communicated via in-app announcements or on this page.</p>

						<h3>6. 联系我们 / Contact Us</h3>
						<p>如果您对我们的隐私政策有任何问题，欢迎随时发信联络我们：<a href="mailto:victor@goldenarc.digital">victor@goldenarc.digital</a>。</p>
						<p class="english-law">If you have any questions about our privacy policy, feel free to contact us at <a href="mailto:victor@goldenarc.digital">victor@goldenarc.digital</a>.</p>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.yong-page {
		width: min(1140px, 100%);
		margin: 0 auto;
		padding: 3rem 1.25rem;
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "PingFang SC", "Microsoft YaHei", sans-serif;
		color: #2c2927;
	}

	.en-sub {
		font-size: 0.85rem;
		color: #9c938e;
	}

	/* Hero Section */
	.hero-container {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 3.5rem;
		align-items: center;
		padding: 2rem 0 4rem 0;
	}

	@media (max-width: 900px) {
		.hero-container {
			grid-template-columns: 1fr;
			gap: 2.5rem;
			text-align: center;
		}

		.cta-group {
			justify-content: center;
		}
	}

	.app-tag {
		display: inline-block;
		padding: 0.35rem 0.85rem;
		background: rgba(139, 115, 85, 0.1);
		color: #8b7355;
		border-radius: 99px;
		font-size: 0.85rem;
		font-weight: 600;
		margin-bottom: 1.25rem;
	}

	.hero-content h1 {
		font-size: 2.7rem;
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: -0.02em;
		margin: 0 0 1rem 0;
		color: #1a1716;
	}

	.subtitle {
		font-size: 1.35rem;
		font-weight: 500;
		line-height: 1.5;
		color: #5c5652;
		margin-bottom: 0.75rem;
	}

	.tagline {
		font-size: 1.05rem;
		line-height: 1.6;
		color: #8b837e;
		margin-bottom: 2.25rem;
	}

	.cta-group {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.coming-soon {
		margin-top: 1.25rem;
		font-size: 0.95rem;
		line-height: 1.5;
		color: #8b7355;
	}

	.btn {
		display: inline-block;
		padding: 0.85rem 1.6rem;
		font-size: 0.95rem;
		font-weight: 600;
		border-radius: 99px;
		text-decoration: none;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.btn:hover {
		transform: translateY(-2px);
	}

	.btn-primary {
		background: #8b7355;
		color: #ffffff;
		box-shadow: 0 4px 14px rgba(139, 115, 85, 0.25);
	}

	.btn-primary:hover {
		background: #735f46;
		box-shadow: 0 6px 20px rgba(139, 115, 85, 0.35);
	}

	.btn-secondary {
		background: rgba(139, 115, 85, 0.06);
		color: #8b7355;
		border: 1px solid rgba(139, 115, 85, 0.2);
	}

	.btn-secondary:hover {
		background: rgba(139, 115, 85, 0.12);
	}

	.framed-mockup {
		width: 100%;
		max-width: 440px;
		height: auto;
		border-radius: 24px;
		box-shadow: 0 20px 45px rgba(0, 0, 0, 0.08);
		display: block;
		margin: 0 auto;
	}

	/* Section shared heading rhythm */
	.loop-section,
	.demo-section,
	.features-section,
	.practice-section,
	.support-section,
	.privacy-section {
		padding: 5rem 0;
		border-top: 1px solid rgba(139, 115, 85, 0.15);
	}

	.loop-section h2,
	.demo-section h2,
	.features-section h2,
	.practice-section h2 {
		font-size: 2rem;
		font-weight: 700;
		text-align: center;
		margin-bottom: 0.5rem;
		color: #1a1716;
	}

	.features-section h2 {
		margin-bottom: 3.5rem;
	}

	.loop-subtitle,
	.demo-subtitle,
	.practice-subtitle {
		text-align: center;
		font-size: 1.1rem;
		line-height: 1.6;
		color: #8b837e;
		margin: 0 auto 3.5rem auto;
		max-width: 760px;
	}

	/* Loop / How-it-works steps */
	.steps-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2.5rem;
	}

	@media (max-width: 768px) {
		.steps-grid {
			grid-template-columns: 1fr;
			gap: 3rem;
			max-width: 420px;
			margin: 0 auto;
		}
	}

	.step-card {
		text-align: center;
	}

	.phone-frame {
		width: 78%;
		max-width: 250px;
		margin: 0 auto 1.5rem auto;
		border-radius: 30px;
		padding: 6px;
		background: linear-gradient(160deg, #efe9df, #ddd2c2);
		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);
	}

	.phone-frame img {
		width: 100%;
		height: auto;
		border-radius: 24px;
		display: block;
	}

	.step-body {
		max-width: 300px;
		margin: 0 auto;
	}

	.step-num {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.9rem;
		height: 1.9rem;
		border-radius: 50%;
		background: #8b7355;
		color: #fff;
		font-size: 0.9rem;
		font-weight: 700;
		margin-bottom: 0.85rem;
	}

	.step-body h4 {
		font-size: 1.15rem;
		font-weight: 700;
		margin: 0 0 0.5rem 0;
		color: #1a1716;
	}

	.step-body p {
		font-size: 0.95rem;
		line-height: 1.6;
		color: #5c5652;
		margin: 0 0 0.5rem 0;
	}

	.step-body small {
		display: block;
		font-size: 0.82rem;
		line-height: 1.45;
		color: #9c938e;
	}

	/* Demo Videos Section */
	.demo-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2.5rem;
	}

