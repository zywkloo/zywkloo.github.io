---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { GOLDENARC_LINKEDIN_URL, GOLDENARC_NAME, SITE_URL } from '../consts';

const products = [
	{
		name: 'ARC EDF & BDF Viewer',
		platform: 'iPad + Mac',
		description: 'Open EDF, EDF+ and BDF recordings, explore every channel, and inspect file metadata locally.',
		status: 'Available',
		href: '/edfviewer',
		icon: 'wave',
	},
	{
		name: 'ARC Scanner',
		platform: 'iPhone + iPad',
		description: 'Scan or import pages, review them, and export useful document formats with on-device processing.',
		status: 'In development',
		icon: 'scan',
	},
	{
		name: 'ARC PDF Studio',
		platform: 'iPhone + iPad',
		description: 'Read, annotate, arrange, merge, and export standard PDFs without locking work into one app.',
		status: 'Planned',
		icon: 'pdf',
	},
];

const organizationLd = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	'@id': `${SITE_URL}/#goldenarc`,
	name: GOLDENARC_NAME,
	url: `${SITE_URL}/goldenarc/`,
	sameAs: [GOLDENARC_LINKEDIN_URL],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="GoldenARC Digital | Focused tools for real files"
			description="GoldenARC Digital builds focused, privacy-first utilities for Apple platforms, including ARC EDF Viewer, ARC Scanner, and ARC PDF Studio."
		/>
		<script type="application/ld+json" is:inline set:html={JSON.stringify(organizationLd)} />
	</head>
	<body>
		<Header />
		<main class="arc-page">
			<section class="hero">
				<p class="eyebrow">GoldenARC Digital</p>
				<h1>Focused tools for real files.</h1>
				<p class="lede">
					A family of native, privacy-first utilities for Apple platforms. Each app does one job clearly,
					keeps core work on your device, and produces files you can use elsewhere.
				</p>
			</section>

			<section aria-labelledby="tools-heading">
				<div class="section-heading">
					<div>
						<p class="eyebrow">The ARC series</p>
						<h2 id="tools-heading">Choose a tool</h2>
					</div>
					<p>One product family, separate apps, no forced account.</p>
				</div>

				<div class="product-grid">
					{products.map((product) => (
						<article class:list={['product-card', { available: product.href }]}>
							<div class:list={['product-icon', product.icon]} aria-hidden="true">
								{product.icon === 'wave' && <span class="wave-line">⌁</span>}
								{product.icon === 'scan' && <span class="scan-corners">▣</span>}
								{product.icon === 'pdf' && <span class="pdf-sheet">PDF</span>}
							</div>
							<div class="product-meta">
								<span class:list={['status', { live: product.status === 'Available' }]}>{product.status}</span>
								<span>{product.platform}</span>
							</div>
							<h3>{product.name}</h3>
							<p>{product.description}</p>
							{product.href ? (
								<a class="product-link" href={product.href} aria-label={`Explore ${product.name}`}>
									Explore the app <span aria-hidden="true">→</span>
								</a>
							) : (
								<span class="product-link muted">Details will follow</span>
							)}
						</article>
					))}
				</div>
			</section>

			<section class="principles" aria-labelledby="principles-heading">
				<p class="eyebrow">Product principles</p>
				<h2 id="principles-heading">Useful by default.</h2>
				<div class="principle-grid">
					<div><strong>Local first</strong><span>Core file work stays on your device.</span></div>
					<div><strong>Focused</strong><span>Each app has a clear job and a small surface area.</span></div>
					<div><strong>Portable</strong><span>Exports remain useful outside the ARC family.</span></div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.arc-page {
		--arc-ink: #111827;
		--arc-muted: #556274;
		--arc-teal: #087a61;
		--arc-teal-dark: #065f4d;
		--arc-mint: #2de0a8;
		--arc-navy: #131c33;

		width: min(1080px, calc(100% - 2.5rem));
		max-width: none;
		padding: 5.5rem 0 6rem;
	}
	.hero {
		max-width: 760px;
		padding-bottom: 5rem;
	}
	.eyebrow {
		margin: 0 0 0.8rem;
		color: var(--arc-teal);
	}
	h1 {
		max-width: 720px;
		font-size: clamp(3rem, 8vw, 5.8rem);
		line-height: 0.98;
		letter-spacing: -0.055em;
	}
	.lede {
		max-width: 690px;
		margin: 1.5rem 0 0;
		color: var(--arc-muted);
		font-size: clamp(1.08rem, 2vw, 1.28rem);
		line-height: 1.65;
	}
	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 1.5rem;
	}
	.section-heading h2,
	.principles h2 {
		font-size: clamp(2rem, 4vw, 3rem);
	}
	.section-heading > p {
		max-width: 330px;
		margin: 0 0 0.35rem;
		color: var(--arc-muted);
		font-size: 0.95rem;
		text-align: right;
	}
	.product-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}
	.product-card {
		display: flex;
		min-height: 430px;
		flex-direction: column;
		padding: 1.4rem;
		background: rgba(255, 255, 255, 0.76);
		border: 1px solid var(--line);
		border-radius: 22px;
		box-shadow: var(--shadow-sm);
	}
	.product-card.available {
		border-color: rgba(8, 122, 97, 0.3);
		box-shadow: 0 20px 48px rgba(17, 24, 39, 0.09);
	}
	.product-icon {
		display: grid;
		width: 100%;
		height: 150px;
		place-items: center;
		margin-bottom: 1.25rem;
		overflow: hidden;
		background: var(--arc-navy);
		border-radius: 15px;
		color: var(--arc-mint);
	}
	.wave-line {
		font-family: Georgia, serif;
		font-size: 7rem;
		line-height: 1;
		transform: scaleX(1.45) rotate(-4deg);
	}
	.scan-corners {
		font-size: 5.5rem;
		font-weight: 400;
		line-height: 1;
	}
	.pdf-sheet {
		display: grid;
		width: 76px;
		height: 96px;
		place-items: end center;
		padding-bottom: 0.75rem;
		background: #f8fafc;
		border-radius: 7px 13px 7px 7px;
		color: var(--arc-navy);
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}
	.product-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		color: var(--arc-muted);
		font-size: 0.74rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.status {
		padding: 0.18rem 0.5rem;
		background: var(--surface-muted);
		border-radius: 999px;
	}
	.status.live {
		background: #daf7ed;
		color: var(--arc-teal-dark);
	}
	.product-card h3 {
		margin: 1rem 0 0.55rem;
		font-size: 1.35rem;
	}
	.product-card p {
		margin: 0;
		color: var(--arc-muted);
		font-size: 0.94rem;
		line-height: 1.55;
	}
	.product-link {
		margin-top: auto;
		padding-top: 1.5rem;
		color: var(--arc-teal);
		font-size: 0.9rem;
		font-weight: 700;
	}
	.product-link:hover {
		color: var(--arc-teal-dark);
	}
	.product-link.muted {
		color: var(--arc-muted);
	}
	.principles {
		margin-top: 6rem;
		padding: 2.3rem;
		background: var(--arc-navy);
		border-radius: 24px;
	}
	.principles .eyebrow {
		color: var(--arc-mint);
	}
	.principles h2 {
		color: #f8fafc;
	}
	.principle-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		margin-top: 2rem;
	}
	.principle-grid div {
		display: grid;
		gap: 0.3rem;
	}
	.principle-grid strong {
		color: #f8fafc;
	}
	.principle-grid span {
		color: #b9c4d8;
		font-size: 0.92rem;
		line-height: 1.5;
	}
	@media (max-width: 820px) {
		.product-grid {
			grid-template-columns: 1fr;
		}
		.product-card {
			min-height: 0;
		}
		.product-link {
			margin-top: 1.25rem;
		}
	}
	@media (max-width: 600px) {
		.arc-page {
			width: min(100% - 2rem, 1080px);
			padding-top: 3.5rem;
		}
		.hero {
			padding-bottom: 4rem;
		}
		.section-heading {
			display: block;
		}
		.section-heading > p {
			margin-top: 0.8rem;
			text-align: left;
		}
		.principles {
			padding: 1.5rem;
		}
		.principle-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
