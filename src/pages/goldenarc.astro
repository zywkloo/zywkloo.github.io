---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { GOLDENARC_LINKEDIN_URL, GOLDENARC_NAME, SITE_URL } from '../consts';

const products = [
	{
		name: 'ARC EDF & BDF Viewer',
		platform: 'iPad + Mac',
		description: 'Open EDF, EDF+ and BDF recordings, explore every channel, and inspect file metadata locally.',
		status: 'In App Review',
		statusTone: 'review',
		href: '/edfviewer',
		icon: '/images/goldenarc/arc-edf-viewer.png',
	},
	{
		name: 'ARC Scanner',
		platform: 'iPhone + iPad',
		description: 'Scan or import pages, review them, and export useful document formats with on-device processing.',
		status: 'In development',
		statusTone: 'building',
		icon: '/images/goldenarc/arc-scanner.png',
	},
	{
		name: 'ARC Markdown',
		platform: 'iPhone + iPad',
		description: 'Open local Markdown and TXT files as readable documents, with clean front matter and a reliable outline.',
		status: 'In development',
		statusTone: 'building',
		monogram: 'MD',
	},
	{
		name: 'ARC PDF Studio',
		platform: 'iPad + Mac',
		description: 'Read, annotate, arrange, merge, and export standard PDFs without locking work into one app.',
		status: 'Architecture planned',
		statusTone: 'planned',
		icon: '/images/goldenarc/arc-pdf-studio.png',
	},
];

const organizationLd = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	'@id': `${SITE_URL}/#goldenarc`,
	name: GOLDENARC_NAME,
	url: `${SITE_URL}/goldenarc/`,
	sameAs: [GOLDENARC_LINKEDIN_URL],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="GoldenARC Digital | One Core. Many Arcs."
			description="Plug Once. Grow Everywhere. GoldenARC Digital builds local-first Apple platform tools on a modular Swift package architecture, including ARC EDF & BDF Viewer, ARC Scanner, ARC Markdown, and ARC PDF Studio."
		/>
		<script type="application/ld+json" is:inline set:html={JSON.stringify(organizationLd)} />
	</head>
	<body>
		<Header />
		<div class="arc-stage">
			<main class="arc-page">
			<section class="hero">
				<div class="brand-lockup">
					<img src="/images/goldenarc/brand-mark.png" alt="" width="64" height="64" />
					<span>GoldenARC Digital</span>
				</div>
				<h1>One Core. Many Arcs.</h1>
				<p class="lede">
					Plug Once. Grow Everywhere. GoldenARC tools stay focused at the product layer while shared
					capabilities live in small, testable Swift Package products with explicit dependency boundaries.
				</p>
			</section>

			<section aria-labelledby="tools-heading">
				<div class="section-heading">
					<div>
						<p class="eyebrow">The ARC series</p>
						<h2 id="tools-heading">Choose a tool</h2>
					</div>
					<p>Separate products at different stages, built around the same engineering discipline.</p>
				</div>

				<div class="product-grid">
					{products.map((product) => (
						<article class:list={['product-card', { available: product.href }]}>
							<div class="product-visual">
								{product.icon ? (
									<img src={product.icon} alt={`${product.name} app icon`} width="512" height="512" loading="lazy" />
								) : (
									<div class="product-monogram arc-markdown-icon" role="img" aria-label={`${product.name} app icon concept`}>
										<span class="markdown-wordmark">.{product.monogram}</span>
										<span class="markdown-ruler" aria-hidden="true"></span>
										<span class="markdown-lines" aria-hidden="true"><i></i><i></i><i></i></span>
									</div>
								)}
							</div>
							<div class="product-meta">
								<span class:list={['status', product.statusTone]}>{product.status}</span>
								<span>{product.platform}</span>
							</div>
							<h3>{product.name}</h3>
							<p>{product.description}</p>
							{product.href ? (
								<a class="product-link" href={product.href} aria-label={`Explore ${product.name}`}>
									Explore the app <span aria-hidden="true">→</span>
								</a>
							) : (
								<span class="product-link muted">Details will follow</span>
							)}
						</article>
					))}
				</div>
			</section>

			<section class="architecture" aria-labelledby="architecture-heading">
				<div class="section-heading architecture-heading">
					<div>
						<p class="eyebrow">Engineering under the apps</p>
						<h2 id="architecture-heading">One-way dependencies. No umbrella package.</h2>
					</div>
					<p>
						The graph separates shipped paths, planned domain packages, and future optional import or export work,
						so roadmap ideas are visible without pretending they already exist.
					</p>
				</div>

				<div class="architecture-panel">
					<div class="diagram-legend" aria-label="Architecture diagram legend">
						<span><i class="legend-line solid"></i> Implemented / integrated</span>
						<span><i class="legend-line dashed"></i> Planned dependency</span>
						<span><i class="legend-line future"></i> Future optional path</span>
						<span><i class="legend-box"></i> Independent app stack</span>
					</div>

					<svg class="dependency-graph" viewBox="0 0 1080 770" role="img" aria-labelledby="graph-title graph-desc">
						<title id="graph-title">GoldenARC product and Swift package dependency graph</title>
						<desc id="graph-desc">
							ARC Scanner uses DocumentPipelineKit, which uses ARC Shared Infra and Apple frameworks.
							ARC PDF Studio is planned to use PDFDocumentKit, DocumentPipelineKit, and InkObjectKit.
							ARC Markdown currently uses an independent reader core and may later add an optional OCR and PDF import path through DocumentPipelineKit.
							The ARC EDF &amp; BDF Viewer remains an independent specialized app built directly on Apple frameworks and may later add app-local PDF export or report output.
						</desc>
						<defs>
							<marker id="arrow-solid" markerWidth="10" markerHeight="10" refX="8" refY="4" orient="auto" markerUnits="strokeWidth">
								<path d="M0,0 L8,4 L0,8 Z" class="arrow-head solid" />
							</marker>
							<marker id="arrow-planned" markerWidth="10" markerHeight="10" refX="8" refY="4" orient="auto" markerUnits="strokeWidth">
								<path d="M0,0 L8,4 L0,8 Z" class="arrow-head planned" />
							</marker>
							<marker id="arrow-future" markerWidth="10" markerHeight="10" refX="8" refY="4" orient="auto" markerUnits="strokeWidth">
								<path d="M0,0 L8,4 L0,8 Z" class="arrow-head future" />
							</marker>
						</defs>

						<text class="layer-label" x="18" y="112">PRODUCT APPS</text>
						<text class="layer-label" x="18" y="278">PDF DOMAIN</text>
						<text class="layer-label" x="18" y="438">DOCUMENT DOMAIN</text>
						<text class="layer-label" x="18" y="598">NEUTRAL INFRA</text>
						<text class="layer-label" x="18" y="730">APPLE PLATFORM</text>

						<g class="graph-edges">
							<path class="edge solid" marker-end="url(#arrow-solid)" d="M250 154 C250 390 220 520 250 690" />
							<path class="edge solid" marker-end="url(#arrow-solid)" d="M480 154 L500 385" />
							<path class="edge solid" marker-end="url(#arrow-solid)" d="M710 154 C710 380 675 520 710 690" />
							<path class="edge solid" marker-end="url(#arrow-solid)" d="M500 475 L500 545" />
							<path class="edge solid" marker-end="url(#arrow-solid)" d="M500 635 L500 690" />

							<path class="edge planned" marker-end="url(#arrow-planned)" d="M940 154 L920 225" />
							<path class="edge planned" marker-end="url(#arrow-planned)" d="M865 154 C710 235 675 320 620 385" />
							<path class="edge planned" marker-end="url(#arrow-planned)" d="M1000 154 L1000 545" />
							<path class="edge planned" marker-end="url(#arrow-planned)" d="M800 270 C700 300 675 360 620 405" />
							<path class="edge planned" marker-end="url(#arrow-planned)" d="M920 315 L920 545" />
							<path class="edge planned" marker-end="url(#arrow-planned)" d="M920 635 L920 690" />
							<path class="edge future" marker-end="url(#arrow-future)" d="M250 154 C248 214 242 236 218 255" />
							<path class="edge future" marker-end="url(#arrow-future)" d="M680 154 C638 225 620 310 560 385" />
						</g>

						<g class="graph-node independent">
							<rect x="150" y="65" width="200" height="89" rx="18" />
							<text class="node-title" x="170" y="101">EDF &amp; BDF Viewer</text>
							<text class="node-meta" x="170" y="128">Signals now · PDF later</text>
						</g>
						<g class="graph-node implemented">
							<rect x="380" y="65" width="200" height="89" rx="18" />
							<text class="node-title" x="400" y="101">ARC Scanner</text>
							<text class="node-meta" x="400" y="128">App path integrated</text>
						</g>
						<g class="graph-node independent">
							<rect x="610" y="65" width="200" height="89" rx="18" />
							<text class="node-title" x="630" y="101">ARC Markdown</text>
							<text class="node-meta" x="630" y="128">Reader core now · import later</text>
						</g>
						<g class="graph-node planned">
							<rect x="840" y="65" width="200" height="89" rx="18" />
							<text class="node-title" x="860" y="101">ARC PDF Studio</text>
							<text class="node-meta" x="860" y="128">Architecture planned</text>
						</g>

						<g class="future-label">
							<rect x="116" y="255" width="176" height="44" rx="14" />
							<text x="204" y="273" text-anchor="middle">Future optional</text>
							<text x="204" y="290" text-anchor="middle">PDF export / report</text>
						</g>
						<g class="graph-node planned">
							<rect x="800" y="225" width="240" height="90" rx="18" />
							<text class="node-title" x="824" y="261">PDFDocumentKit</text>
							<text class="node-meta" x="824" y="288">Composition · annotation · text</text>
						</g>
						<g class="graph-node implemented emphasized">
							<rect x="380" y="385" width="240" height="90" rx="18" />
							<text class="node-title" x="404" y="421">DocumentPipelineKit</text>
							<text class="node-meta" x="404" y="448">Contracts · pipeline · export</text>
						</g>
						<g class="future-label">
							<rect x="565" y="255" width="150" height="44" rx="14" />
							<text x="640" y="273" text-anchor="middle">Future optional</text>
							<text x="640" y="290" text-anchor="middle">OCR / PDF import</text>
						</g>
						<g class="graph-node implemented">
							<rect x="380" y="545" width="240" height="90" rx="18" />
							<text class="node-title" x="404" y="581">ARC Shared Infra</text>
							<text class="node-meta" x="404" y="608">File intake · scan · OCR</text>
						</g>
						<g class="graph-node planned">
							<rect x="800" y="545" width="240" height="90" rx="18" />
							<text class="node-title" x="824" y="581">InkObjectKit</text>
							<text class="node-meta" x="824" y="608">Ink · objects · Pencil adapter</text>
						</g>
						<g class="graph-node platform">
							<rect x="150" y="690" width="890" height="62" rx="18" />
							<text class="node-title platform-title" x="595" y="727" text-anchor="middle">Apple frameworks · Files · Vision · VisionKit · PDFKit · PencilKit</text>
						</g>
					</svg>

					<div class="dependency-list" aria-hidden="true">
						<div><strong>ARC Scanner</strong><span>↓ DocumentPipelineKit ↓ ARC Shared Infra ↓ Apple frameworks</span></div>
						<div><strong>ARC PDF Studio <em>planned</em></strong><span>↓ PDFDocumentKit + DocumentPipelineKit + InkObjectKit ↓ Apple frameworks</span></div>
						<div><strong>ARC Markdown</strong><span>Current: independent Markdown reader core ↓ Apple frameworks. Future optional: OCR / PDF import through DocumentPipelineKit.</span></div>
						<div><strong>EDF &amp; BDF Viewer</strong><span>Current: independent specialized stack ↓ Apple frameworks. Future optional: PDF export / report stays app-local.</span></div>
					</div>

					<div class="architecture-note">
						<strong>The important part is the boundary, not the box count.</strong>
						<p>
							Apps depend downward; infrastructure never reaches back into a product. Platform results are
							normalized into contracts, concrete providers are injected at each app's composition root, and
							consumers select individual SPM products instead of linking an all-in-one framework.
						</p>
					</div>
				</div>

				<div class="evidence-grid" aria-label="Architecture implementation evidence">
					<div><strong>12</strong><span>selectable SPM library products across the implemented shared packages</span></div>
					<div><strong>66</strong><span>passing package tests at the documented Scanner integration baseline</span></div>
					<div><strong>iOS 16 → 26+</strong><span>baseline OCR with capability-gated structured document recognition</span></div>
					<div><strong>Local first</strong><span>core intake, scan, OCR, export, and file work require no account or cloud service</span></div>
				</div>
			</section>

			<section class="principles" aria-labelledby="principles-heading">
				<p class="eyebrow">Product and engineering principles</p>
				<h2 id="principles-heading">Built as packages. Shipped as tools.</h2>
				<div class="principle-grid">
					<div><strong>Local first</strong><span>Core file work stays on your device.</span></div>
					<div><strong>Focused products</strong><span>Each app has a clear job and links only the capabilities it needs.</span></div>
					<div><strong>Portable output</strong><span>Exports remain useful outside the ARC family.</span></div>
				</div>
			</section>
			</main>
		</div>
		<Footer />
	</body>
</html>

<style>
	.arc-stage {
		background:
			radial-gradient(42rem 26rem at 8% 8%, rgba(27, 135, 201, 0.18), transparent 72%),
			radial-gradient(38rem 24rem at 94% 26%, rgba(232, 93, 26, 0.13), transparent 74%),
			linear-gradient(180deg, #e9eff5 0%, #f5f7fa 48%, #e8eef4 100%);
		border-bottom: 1px solid #d6dee7;
	}
	.arc-page {
		--arc-ink: #111827;
		--arc-muted: #556274;
		--arc-teal: #087a61;
		--arc-teal-dark: #065f4d;
		--arc-mint: #2de0a8;
		--arc-navy: #131c33;

		width: min(1080px, calc(100% - 2.5rem));
		max-width: none;
		padding: 5.5rem 0 6rem;
	}
	.hero {
		max-width: 760px;
		padding-bottom: 5rem;
	}
	.brand-lockup {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1.35rem;
		color: var(--arc-ink);
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		text-transform: none;
	}
	.brand-lockup img {
		width: 3rem;
		height: 3rem;
		border-radius: 0;
		filter: drop-shadow(0 8px 12px rgba(16, 23, 31, 0.14));
	}
	.arc-page .eyebrow {
		margin: 0 0 0.8rem;
		color: var(--arc-teal);
	}
	h1 {
		max-width: 720px;
		font-size: clamp(3rem, 8vw, 5.8rem);
		line-height: 0.98;
		letter-spacing: -0.055em;
	}
	.lede {
		max-width: 690px;
		margin: 1.5rem 0 0;
		color: var(--arc-muted);
		font-size: clamp(1.08rem, 2vw, 1.28rem);
		line-height: 1.65;
	}
	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 1.5rem;
	}
	.section-heading h2,
	.principles h2 {
		font-size: clamp(2rem, 4vw, 3rem);
	}
	.section-heading > p {
		max-width: 330px;
		margin: 0 0 0.35rem;
		color: var(--arc-muted);
		font-size: 0.95rem;
		text-align: right;
	}
	.product-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}
	.product-card {
		display: flex;
		min-height: 430px;
		flex-direction: column;
		padding: 1.4rem;
		background: rgba(255, 255, 255, 0.94);
		border: 1px solid #cfd8e3;
		border-radius: 22px;
		box-shadow: var(--shadow-sm);
	}
	.product-card.available {
		border-color: rgba(8, 122, 97, 0.3);
		box-shadow: 0 20px 48px rgba(17, 24, 39, 0.09);
	}
	.product-visual {
		display: grid;
		width: 100%;
		height: 176px;
		place-items: center;
		margin-bottom: 1.25rem;
		overflow: hidden;
		background:
			radial-gradient(circle at 50% 30%, rgba(45, 224, 168, 0.14), transparent 58%),
			var(--arc-navy);
		border-radius: 15px;
	}
	.product-visual img {
		width: 126px;
		height: 126px;
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 27px;
		box-shadow: 0 18px 32px rgba(5, 10, 25, 0.38);
		object-fit: cover;
	}
	.product-monogram {
		position: relative;
		width: 126px;
		height: 126px;
		overflow: hidden;
		background: #080e1d;
		border: 1px solid rgba(255, 255, 255, 0.22);
		border-radius: 27px;
		box-shadow: 0 18px 32px rgba(5, 10, 25, 0.38);
	}
	.markdown-wordmark {
		position: absolute;
		top: 13px;
		left: 50%;
		transform: translateX(-50%);
		color: #f8fafc;
		font-family: "DIN Condensed", "Arial Narrow", sans-serif;
		font-size: 3.55rem;
		font-stretch: condensed;
		font-weight: 700;
		letter-spacing: 0.015em;
		line-height: 1;
		white-space: nowrap;
	}
	.markdown-ruler {
		position: absolute;
		top: 72px;
		left: 17px;
		width: 92px;
		height: 8px;
		background: repeating-linear-gradient(90deg, #dbe4ef 0 1px, transparent 1px 15px);
		border-top: 1px solid #dbe4ef;
	}
	.markdown-ruler::after {
		position: absolute;
		top: -1px;
		left: 50%;
		width: 1px;
		height: 11px;
		background: #dbe4ef;
		content: "";
	}
	.markdown-lines {
		position: absolute;
		top: 89px;
		left: 19px;
		display: grid;
		width: 88px;
		gap: 4px;
		transform: rotate(1.5deg);
	}
	.markdown-lines i {
		display: block;
		height: 4px;
		background: #2de0a8;
		border-radius: 2px;
	}
	.markdown-lines i:nth-child(1) {
		width: 68%;
	}
	.markdown-lines i:nth-child(2) {
		width: 100%;
	}
	.markdown-lines i:nth-child(3) {
		width: 82%;
	}
	.product-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		color: var(--arc-muted);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0;
		text-transform: none;
	}
	.status {
		padding: 0.18rem 0.5rem;
		background: var(--surface-muted);
		border-radius: 999px;
	}
	.status.live {
		background: #daf7ed;
		color: var(--arc-teal-dark);
	}
	.status.review {
		background: #e0f2fe;
		color: #075985;
	}
	.status.building {
		background: #dcfce7;
		color: #166534;
	}
	.status.planned {
		background: #f1f5f9;
		color: #475569;
	}
	.product-card h3 {
		margin: 1rem 0 0.55rem;
		font-size: 1.35rem;
	}
	.product-card p {
		margin: 0;
		color: var(--arc-muted);
		font-size: 0.94rem;
		line-height: 1.55;
	}
	.product-link {
		margin-top: auto;
		padding-top: 1.5rem;
		color: var(--arc-teal);
		font-size: 0.9rem;
		font-weight: 700;
	}
	.product-link:hover {
		color: var(--arc-teal-dark);
	}
	.product-link.muted {
		color: var(--arc-muted);
	}
	.architecture {
		margin-top: 6rem;
	}
	.architecture-heading {
		align-items: end;
	}
	.architecture-panel {
		padding: 1.25rem;
		background: rgba(255, 255, 255, 0.92);
		border: 1px solid #cfd8e3;
		border-radius: 24px;
		box-shadow: 0 24px 60px rgba(17, 24, 39, 0.08);
	}
	.diagram-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem 1.35rem;
		padding: 0.45rem 0.35rem 1rem;
		color: var(--arc-muted);
		font-size: 0.78rem;
		font-weight: 700;
	}
	.diagram-legend span {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
	}
	.legend-line {
		display: inline-block;
		width: 1.8rem;
		height: 0;
		border-top: 2px solid var(--arc-teal);
	}
	.legend-line.dashed {
		border-top-color: #8290a3;
		border-top-style: dashed;
	}
	.legend-line.future {
		border-top-color: #b6c0cd;
		border-top-style: dotted;
		opacity: 0.75;
	}
	.legend-box {
		display: inline-block;
		width: 1.1rem;
		height: 0.8rem;
		background: #f8fafc;
		border: 1px solid #94a3b8;
		border-radius: 4px;
	}
	.dependency-graph {
		display: block;
		width: 100%;
		height: auto;
		font-family: inherit;
	}
	.layer-label {
		fill: #718096;
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 0.09em;
	}
	.edge {
		fill: none;
		stroke-width: 2.5;
	}
	.edge.solid {
		stroke: var(--arc-teal);
	}
	.edge.planned {
		stroke: #8290a3;
		stroke-dasharray: 8 7;
	}
	.edge.future {
		stroke: #aab5c4;
		stroke-dasharray: 2 8;
		stroke-linecap: round;
		opacity: 0.72;
	}
	.arrow-head.solid {
		fill: var(--arc-teal);
	}
	.arrow-head.planned {
		fill: #8290a3;
	}
	.arrow-head.future {
		fill: #aab5c4;
		opacity: 0.72;
	}
	.graph-node rect {
		stroke-width: 1.5;
	}
	.graph-node.implemented rect {
		fill: #eefbf7;
