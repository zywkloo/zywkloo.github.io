---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { WTCRAFT_URL, WTCRAFT_NPM_URL, WTCRAFT_PYPI_URL, SITE_URL, SITE_AUTHOR_ALT } from '../consts';

const pageTitle = 'wtcraft — Task Contracts and Deterministic Checks for Git Worktrees | Victor Zhang';
const pageDescription =
	'wtcraft is a lightweight CLI for worktree-based agent workflows. It scaffolds task contracts, creates worktrees, checks changed files against declared scope, runs verification commands, and exposes machine-readable status.';

// FAQ — rendered visibly below AND mirrored into FAQPage structured data
// (Google requires the schema to match on-page content).
const faqs = [
	{
		q: 'What is wtcraft?',
		a: 'wtcraft is a lightweight CLI for worktree-based agent workflows. It scaffolds local task contracts, creates worktrees, checks changed files against declared Scope and Off-limits entries, runs declared verification commands, and exposes status, check, and verify results as JSON.',
	},
	{
		q: "How is wtcraft different from plain git worktrees or Claude Code's --worktree?",
		a: 'Git worktrees isolate branches. wtcraft adds a local .worktree-task.md contract with Scope, Off-limits, Verification, and lifecycle fields, plus commands that compare those declarations with the Git changeset. The checks run only when you invoke them.',
	},
	{
		q: 'Does wtcraft launch or monitor coding agents?',
		a: 'No. It does not launch agents, route models, enforce role handoffs, sandbox an agent runtime, or track token usage. You run your preferred coding tool separately; wtcraft operates on Git changes and local task files.',
	},
	{
		q: 'Is the task contract a security boundary?',
		a: 'No. The current .worktree-task.md is mutable local state. wtcraft check is a deterministic, on-demand signal, not protected authorization or an automatic pull-request gate.',
	},
	{
		q: 'How do I install wtcraft?',
		a: 'Install globally via npm (npm install -g wtcraft), pipx (pipx install wtcraft), or Homebrew, then run `wtcraft init` in your repository root.',
	},
];

const softwareLd = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'wtcraft',
	description: pageDescription,
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'macOS, Linux',
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	license: 'https://github.com/zywkloo/wtcraft/blob/main/LICENSE',
	programmingLanguage: ['Shell', 'Python'],
	codeRepository: WTCRAFT_URL,
	author: { '@type': 'Person', name: 'Victor Zhang', alternateName: SITE_AUTHOR_ALT, url: SITE_URL },
	downloadUrl: [WTCRAFT_NPM_URL, WTCRAFT_PYPI_URL],
	sameAs: [WTCRAFT_URL, WTCRAFT_NPM_URL, WTCRAFT_PYPI_URL],
};
const faqLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} ogImageUrl="/images/wtcraft-icon.PNG" />
		<script type="application/ld+json" set:html={JSON.stringify(softwareLd)} />
			<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero -->
			<section class="hero">
				<img src="/images/wtcraft-icon.PNG" alt="wtcraft" class="hero-logo" />
				<h1 class="hero-title">wtcraft</h1>
				<p class="hero-tagline">Task contracts and deterministic checks for agent worktrees</p>
				<p class="hero-pitch">
					Create a worktree and local task contract, compare its changed files with declared
					Scope and Off-limits entries, and run the verification commands you wrote down.
					No hosted service or custom agent runtime.
				</p>
				<div class="badges">
					<a href={WTCRAFT_NPM_URL}><img src="https://img.shields.io/npm/v/wtcraft.svg?style=flat-square&logo=npm&color=cb3837" alt="npm package" /></a>
					<a href={WTCRAFT_PYPI_URL}><img src="https://img.shields.io/pypi/v/wtcraft.svg?style=flat-square&logo=pypi&color=3775a9" alt="PyPI version" /></a>
					<a href="https://github.com/zywkloo/wtcraft/actions/workflows/ci.yml"><img src="https://github.com/zywkloo/wtcraft/actions/workflows/ci.yml/badge.svg" alt="CI" /></a>
					<a href="https://github.com/zywkloo/wtcraft/blob/main/LICENSE"><img src="https://img.shields.io/github/license/zywkloo/wtcraft?style=flat-square&color=blue" alt="License" /></a>
				</div>
				<div class="hero-cta">
					<a href={WTCRAFT_NPM_URL} target="_blank" class="btn btn-primary">npm</a>
					<a href={WTCRAFT_PYPI_URL} target="_blank" class="btn btn-secondary">PyPI</a>
					<a href={WTCRAFT_URL} target="_blank" class="btn btn-secondary">GitHub</a>
				</div>
			</section>

			<!-- Implemented surface -->
			<section class="block">
				<h2 class="section-title">What the CLI does today</h2>
				<div class="capability-grid">
					<article>
						<code>wtcraft init</code>
						<p>Scaffolds the local harness and task templates without overwriting existing files.</p>
					</article>
					<article>
						<code>wtcraft new</code>
						<p>Creates a Git worktree and seeds a local <code>.worktree-task.md</code> contract.</p>
					</article>
					<article>
						<code>wtcraft check</code>
						<p>Compares committed, staged, unstaged, and untracked paths with Scope and Off-limits entries.</p>
					</article>
					<article>
						<code>wtcraft verify</code>
						<p>Runs the contract's Verification commands and records a pass or fail result.</p>
					</article>
					<article>
						<code>wtcraft status --json</code>
						<p>Lists active worktree contracts through a machine-readable status surface.</p>
					</article>
				</div>
				<div class="boundary-note">
					<strong>Current boundary</strong>
					<p>
						wtcraft does not launch agents, choose models, collect token telemetry, sandbox a process,
						or install a protected pull-request gate. Its checks are explicit commands over local Git facts.
					</p>
				</div>
			</section>

			<!-- Install -->
			<section class="block">
				<h2 class="section-title">Install</h2>
				<pre class="install"><code># Node / npm
npm install -g wtcraft

# Python / pipx (recommended)
pipx install wtcraft

# Homebrew (macOS)
brew tap zywkloo/wtcraft https://github.com/zywkloo/wtcraft && brew install wtcraft</code></pre>
				<p class="install-note">
					Then run <code>wtcraft init</code> in your repository root.
				</p>
			</section>

			<!-- FAQ (mirrors FAQPage structured data) -->
			<section class="block">
				<h2 class="section-title">FAQ</h2>
				<div class="faq">
					{faqs.map((f) => (
						<details>
							<summary>{f.q}</summary>
							<p>{f.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>
		<Footer />
		<style>
			main {
				width: min(900px, 100%);
				margin: 0 auto;
				padding: 0 1rem;
			}
			.hero {
				text-align: center;
				padding: 2.5rem 0 1.5rem;
			}
			.hero-logo {
				display: block;
				margin: 0 auto;
				width: 84px;
				height: 84px;
				border-radius: 22px;
				object-fit: cover;
				box-shadow: var(--shadow-sm);
			}
			.hero-title {
				margin: 1rem 0 0.4rem;
				font-size: 2.6rem;
				font-weight: 800;
				letter-spacing: -0.02em;
			}
			.hero-tagline {
				margin: 0 0 1rem;
				font-size: 1.15rem;
				font-weight: 600;
				color: rgb(var(--black));
			}
			.hero-pitch {
				max-width: 620px;
				margin: 0 auto 1.4rem;
				color: rgb(var(--gray-dark));
				line-height: 1.55;
			}
			.badges {
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
				justify-content: center;
				margin-bottom: 1.4rem;
			}
			.badges img {
				height: 20px;
			}
			.hero-cta {
				display: flex;
				gap: 0.6rem;
				justify-content: center;
				flex-wrap: wrap;
			}
			.btn {
				padding: 0.55rem 1.4rem;
				border-radius: 999px;
				text-decoration: none;
				font-weight: 600;
				font-size: 0.95rem;
				border: 1px solid var(--line);
				transition: 0.2s var(--ease);
			}
			.btn-primary {
				background: var(--accent);
				color: #fff;
				border-color: var(--accent);
			}
			.btn-secondary {
				background: var(--surface-muted);
				color: rgb(var(--gray-dark));
			}
			.btn:hover {
				box-shadow: var(--shadow-sm);
				transform: translateY(-1px);
			}
			.block {
				margin: 2.4rem 0;
			}
			.section-title {
				font-size: 1.4rem;
				font-weight: 700;
				margin-bottom: 1rem;
				border-bottom: 1px solid var(--line);
				padding-bottom: 0.4rem;
			}
			.capability-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 0.85rem;
			}
			.capability-grid article {
				border: 1px solid var(--line);
				border-radius: 12px;
				padding: 1rem;
				background: rgba(255, 255, 255, 0.6);
			}
			.capability-grid article > code {
				font-weight: 700;
			}
			.capability-grid p {
				margin: 0.55rem 0 0;
				font-size: 0.94rem;
				line-height: 1.5;
				color: rgb(var(--gray-dark));
			}
			.boundary-note {
				margin-top: 1rem;
				padding: 1rem 1.1rem;
				border-left: 4px solid var(--accent);
				border-radius: 8px;
				background: var(--surface-muted);
			}
			.boundary-note p {
				margin: 0.35rem 0 0;
				line-height: 1.55;
				color: rgb(var(--gray-dark));
			}
			.install {
				background: #0d1117;
				color: #e6edf3;
				border-radius: 12px;
				padding: 1.1rem 1.3rem;
				overflow-x: auto;
				font-size: 0.9rem;
				line-height: 1.6;
			}
			.install code {
				background: none;
				color: inherit;
				padding: 0;
			}
			.install-note {
				margin-top: 0.8rem;
				color: rgb(var(--gray-dark));
			}
			@media (max-width: 720px) {
				.capability-grid {
					grid-template-columns: 1fr;
				}
				.hero-title {
					font-size: 2.1rem;
				}
			}
			.faq details {
				border: 1px solid var(--line);
				border-radius: 12px;
				background: rgba(255, 255, 255, 0.6);
				padding: 0.5rem 1rem;
				margin-bottom: 0.7rem;
			}
			.faq summary {
				cursor: pointer;
				font-weight: 600;
				color: rgb(var(--black));
				padding: 0.4rem 0;
			}
			.faq details[open] summary {
				color: var(--accent-dark);
			}
			.faq p {
				margin: 0.4rem 0 0.6rem;
				color: rgb(var(--gray-dark));
				font-size: 0.95rem;
				line-height: 1.6;
			}
		</style>
	</body>
</html>
