	}

	/* Left Stack / Previous Card: Prominently peeking on the left */
	.stage-card.is-prev {
		z-index: 2;
		transform: translate3d(-88px, 12px, -70px) scale(0.88) rotateY(6deg);
		opacity: 0.78;
		pointer-events: auto;
		cursor: pointer;
		box-shadow: -10px 12px 28px rgba(32, 34, 33, 0.12);
		filter: brightness(0.96);
	}
	.stage-card.is-prev:hover {
		opacity: 0.96;
		border-color: var(--apaper-accent);
		transform: translate3d(-96px, 8px, -45px) scale(0.9) rotateY(3deg);
	}

	/* Right Stack / Next Card: Prominently peeking on the right */
	.stage-card.is-next {
		z-index: 2;
		transform: translate3d(88px, 12px, -70px) scale(0.88) rotateY(-6deg);
		opacity: 0.78;
		pointer-events: auto;
		cursor: pointer;
		box-shadow: 10px 12px 28px rgba(32, 34, 33, 0.12);
		filter: brightness(0.96);
	}
	.stage-card.is-next:hover {
		opacity: 0.96;
		border-color: var(--apaper-accent);
		transform: translate3d(96px, 8px, -45px) scale(0.9) rotateY(-3deg);
	}

	/* Hidden Cards in Queue */
	.stage-card.is-hidden {
		z-index: 0;
		transform: translate3d(0, 24px, -140px) scale(0.76);
		opacity: 0;
		pointer-events: none;
	}

	/* Card Screen Container */
	.card-screen {
		position: relative;
		flex: 1;
		width: 100%;
		overflow: hidden;
		background: #000;
	}
	.card-screen-yong {
		background: #fdfbf7;
	}
	.card-screen-edf {
		background: #0d1117;
	}
	.card-screen-terminal {
		background: #090a0f;
	}
	.card-screen-arcade {
		background: #111417;
	}
	.stage-video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.card-screen-yong .stage-video {
		object-fit: contain;
	}

	/* Screen Stamp Badges */
	.screen-badge {
		position: absolute;
		top: 12px;
		left: 12px;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 4px 10px;
		background: rgba(248, 246, 240, 0.92);
		backdrop-filter: blur(8px);
		border: 1px solid var(--apaper-line);
		border-radius: 999px;
		font-family: var(--apaper-font-mono);
		font-size: 8.5px;
		letter-spacing: 0.08em;
		color: var(--apaper-ink);
		font-weight: 600;
		z-index: 2;
	}
	.badge-dot {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--apaper-accent);
	}
	.badge-edf {
		background: rgba(13, 17, 23, 0.88);
		border-color: rgba(56, 189, 248, 0.25);
		color: #38bdf8;
	}
	.dot-edf {
		background: #38bdf8;
	}
	.badge-terminal {
		background: rgba(14, 17, 22, 0.88);
		border-color: rgba(255, 255, 255, 0.15);
		color: #4ade80;
	}
	.dot-terminal {
		background: #4ade80;
	}
	.badge-arcade {
		background: rgba(18, 20, 24, 0.88);
		border-color: rgba(255, 255, 255, 0.15);
		color: #f59e0b;
	}
	.dot-arcade {
		background: #f59e0b;
	}

	/* Card Caption Bar */
	.card-caption-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px;
		padding: 12px 16px;
		background: var(--apaper-card);
		border-top: 1px solid var(--apaper-line);
	}
	.caption-copy {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}
	.caption-copy strong {
		font-family: var(--apaper-font-serif);
		font-size: 0.98rem;
		font-weight: 600;
		color: var(--apaper-ink);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.caption-copy span {
		font-family: var(--apaper-font-mono);
		font-size: 0.72rem;
		color: var(--apaper-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.stage-card-link {
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--apaper-accent);
		text-decoration: none;
		font-weight: 700;
		padding: 4px 8px;
		border: 1px solid var(--apaper-accent-line);
		border-radius: 6px;
		white-space: nowrap;
		transition: background 0.2s ease, color 0.2s ease;
	}
	.stage-card-link:hover {
		background: var(--apaper-accent);
		color: #ffffff;
	}

	/* Stage Pagination Indicator Pills */
	.stage-pills {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		margin-top: 4px;
	}
	.stage-pill {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		padding: 4px 10px;
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		border-radius: 999px;
		color: var(--apaper-muted);
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		letter-spacing: 0.05em;
		cursor: pointer;
		transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
	}
	.stage-pill:hover {
		border-color: var(--apaper-accent);
		color: var(--apaper-ink);
	}
	.stage-pill.active {
		border-color: var(--apaper-ink);
		background: var(--apaper-ink);
		color: #ffffff;
	}
	.pill-dot {
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: var(--apaper-muted);
	}
	.stage-pill.active .pill-dot {
		background: var(--apaper-accent);
	}

	/* Chapter 01 Native Video Player */
	.chapter-video-wrap {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: 12px;
		background: #000;
		border: 1px solid var(--apaper-line);
		box-shadow: 0 6px 20px rgba(32, 34, 33, 0.08);
	}
	.chapter-native-video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	/* Chapter 01 Rank Card */
	.rank-card {
		margin: 16px 0 0;
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		border-radius: 12px;
		padding: 10px;
		box-shadow: 0 4px 14px rgba(32, 34, 33, 0.04);
	}
	.rank-card img {
		width: 100%;
		height: auto;
		border-radius: 8px;
		border: 1px solid var(--apaper-line);
		display: block;
	}
	.rank-card figcaption {
		font-family: var(--apaper-font-mono);
		font-size: 8.5px;
		letter-spacing: 0.04em;
		color: var(--apaper-muted);
		line-height: 1.5;
		margin-top: 8px;
		padding: 0 2px;
	}

	/* Proof — Archival Exhibit Plates */
	.proof {
		padding: clamp(4rem, 7vw, 6rem) 1.5rem;
		background: var(--apaper-bg);
	}
	.proof-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(14px, 2vw, 22px);
		max-width: 1180px;
		margin: 0 auto;
	}
	.proof-card {
		display: flex;
		flex-direction: column;
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		border-radius: 14px;
		overflow: hidden;
		color: inherit;
		text-decoration: none;
		transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
	}
	.proof-card:hover {
		border-color: var(--apaper-accent);
		transform: translateY(-3px);
		box-shadow: 0 10px 24px rgba(32, 34, 33, 0.06);
	}
	.proof-card-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 12px 16px;
		border-bottom: 1px solid var(--apaper-line);
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.proof-card-id {
		color: var(--apaper-accent);
		font-weight: 700;
	}
	.proof-card-scope {
		color: var(--apaper-muted);
	}
	.proof-media {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 200px;
		overflow: hidden;
		background: var(--apaper-bg-alt);
		border-bottom: 1px solid var(--apaper-line-light);
	}
	.proof-media img {
		display: block;
		width: 100%;
		height: 100%;
	}
	.proof-medal {
		background: #151515;
	}
	.proof-medal img {
		object-fit: cover;
		object-position: center;
	}
	.proof-rank {
		padding: 1.2rem;
	}
	.proof-rank img {
		height: auto;
		max-height: 100%;
		object-fit: contain;
		border-radius: 8px;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
	}
	.proof-devpost {
		background: #eef2f3;
	}
	.proof-devpost img {
		object-fit: cover;
		object-position: top center;
	}
	.proof-copy {
		display: grid;
		gap: 4px;
		padding: 14px 16px 18px;
	}
	.proof-copy strong {
		font-family: var(--apaper-font-serif);
		font-size: 1.08rem;
		font-weight: 600;
		color: var(--apaper-ink);
		line-height: 1.3;
	}
	.proof-copy span {
		font-family: var(--apaper-font-mono);
		color: var(--apaper-muted);
		font-size: 0.78rem;
		letter-spacing: 0.02em;
	}

	.signature {
		background: var(--apaper-bg);
		color: var(--apaper-ink);
		border-top: 1px solid var(--apaper-line);
		border-bottom: 1px solid var(--apaper-line);
		padding: clamp(5rem, 8vw, 7.5rem) 1.5rem clamp(6rem, 10vw, 9rem);
		position: relative;
	}

	/* Section Lead Header */
	.sig-editorial-header {
		max-width: 1180px;
		margin: 0 auto clamp(3.5rem, 6vw, 5.5rem);
	}
	.sig-meta-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
		padding-bottom: 16px;
		border-bottom: 1px solid var(--apaper-line);
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--apaper-muted);
	}
	.sig-wordmark {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--apaper-ink);
		font-weight: 500;
	}
	.sig-mark-glyph {
		width: 26px;
		height: 26px;
		border: 1px solid var(--apaper-ink);
		border-radius: 8px;
		display: grid;
		place-items: center;
		font-family: var(--apaper-font-serif);
		font-size: 13px;
		color: var(--apaper-ink);
		background: #ffffff60;
	}
	.sig-timeframe {
		color: var(--apaper-muted);
	}
	.sig-status-tag {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		color: var(--apaper-accent);
		font-weight: 700;
	}
	.sig-pulse-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--apaper-accent);
		box-shadow: 0 0 0 3px var(--apaper-accent-soft);
	}
	.sig-eyebrow {
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.16em;
		color: var(--apaper-accent);
		text-transform: uppercase;
		margin: 26px 0 10px;
	}
	.sig-title-block h2 {
		font-family: var(--apaper-font-serif);
		font-size: clamp(2.4rem, 4.5vw, 3.4rem);
		font-weight: 500;
		letter-spacing: -0.04em;
		line-height: 1.05;
		color: var(--apaper-ink);
		margin: 0 0 18px;
	}
	.sig-lead-text {
		font-family: var(--apaper-font-serif);
		font-size: clamp(1.02rem, 1.5vw, 1.18rem);
		line-height: 1.8;
		color: var(--apaper-muted);
		max-width: 840px;
		border-left: 2px solid var(--apaper-accent);
		padding-left: 18px;
		margin: 0;
	}

	/* The Editorial Flow & Rail Spine */
	.editorial-flow {
		max-width: 1180px;
		margin: 0 auto;
		position: relative;
	}
	.editorial-milestones {
		display: flex;
		flex-direction: column;
		gap: clamp(4rem, 7vw, 6.5rem);
		position: relative;
	}

	/* Individual Milestone Node */
	.editorial-node {
		display: grid;
		grid-template-columns: 56px 1fr;
		gap: clamp(18px, 3.5vw, 42px);
		position: relative;
	}
	.node-rail {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.node-marker {
		position: sticky;
		top: 96px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		background: var(--apaper-bg);
		padding: 6px 0;
		z-index: 2;
	}
	.node-num {
		font-family: var(--apaper-font-mono);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--apaper-muted);
	}
	.node-dot {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		border: 1px solid var(--apaper-accent);
		background: var(--apaper-bg);
		box-shadow: 0 0 0 3px var(--apaper-accent-soft);
	}
	.node-line-seg {
		position: absolute;
		top: 36px;
		bottom: -7rem;
		width: 1px;
		background: linear-gradient(180deg, var(--apaper-accent), var(--apaper-line) 30%, var(--apaper-line));
		opacity: 0.65;
		z-index: 1;
	}

	.node-content {
		min-width: 0;
	}
	.node-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px;
		padding-bottom: 12px;
		margin-bottom: 16px;
		border-bottom: 1px solid var(--apaper-line);
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.node-badge {
		color: var(--apaper-accent);
		font-weight: 700;
	}
	.node-date {
		color: var(--apaper-muted);
	}

	/* Card Plate */
	.node-plate {
		display: grid;
		grid-template-columns: minmax(300px, 1fr) minmax(320px, 1.1fr);
		gap: clamp(24px, 3.5vw, 44px);
		align-items: start;
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		border-radius: 18px;
		padding: clamp(20px, 3vw, 36px);
		box-shadow: 0 10px 24px rgba(32, 34, 33, 0.04);
		transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
	}
	.node-plate:hover {
		border-color: rgba(196, 94, 73, 0.35);
		box-shadow: 0 16px 36px rgba(32, 34, 33, 0.07);
		transform: translateY(-2px);
	}
	.node-plate.plate-reverse {
		grid-template-columns: minmax(320px, 1.1fr) minmax(300px, 1fr);
	}
	.node-plate.plate-reverse .plate-media {
		order: 2;
	}
	.node-plate.plate-reverse .plate-story {
		order: 1;
	}

	.plate-media {
		min-width: 0;
	}
	.media-frame {
		position: relative;
		overflow: hidden;
		border-radius: 12px;
		border: 1px solid var(--apaper-line);
		background: #111;
	}
	.media-frame img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0;
	}
	.media-stamp {
		position: absolute;
		top: 12px;
		right: 12px;
		z-index: 2;
		background: rgba(27, 33, 35, 0.85);
		color: #f8f5ef;
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		letter-spacing: 0.14em;
		padding: 4px 8px;
		border: 1px solid rgba(255, 255, 255, 0.25);
		border-radius: 4px;
		backdrop-filter: blur(8px);
	}

	.plate-story {
		min-width: 0;
	}
	.plate-kicker {
		display: inline-block;
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.14em;
		color: var(--apaper-accent);
		text-transform: uppercase;
		margin-bottom: 6px;
	}
	.plate-story h3 {
		font-family: var(--apaper-font-serif);
		font-size: clamp(1.45rem, 2.2vw, 1.85rem);
		font-weight: 500;
		letter-spacing: -0.025em;
		color: var(--apaper-ink);
		margin: 0 0 12px;
		line-height: 1.22;
	}
	.plate-p {
		font-family: var(--apaper-font-serif);
		font-size: 0.98rem;
		line-height: 1.8;
		color: var(--apaper-ink-secondary);
		margin: 0 0 14px;
	}
	.plate-p strong {
		color: var(--apaper-ink);
	}
	.editorial-quote {
		margin: 14px 0 18px;
		padding: 10px 0 10px 14px;
		border-left: 2px solid var(--apaper-line);
		background: transparent;
		font-family: var(--apaper-font-serif);
		font-size: 0.94rem;
		line-height: 1.75;
		color: var(--apaper-ink-secondary);
		font-style: normal;
	}
	.editorial-quote p {
		margin: 0;
	}

	/* Buttons in apaper style */
	.plate-cta {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
		margin-bottom: 16px;
	}
	.btn-apaper {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 7px 16px;
		border-radius: 999px;
		background: var(--apaper-ink);
		color: #ffffff;
		font-family: var(--apaper-font-mono);
		font-size: 11px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-decoration: none;
		border: 1px solid var(--apaper-ink);
		transition: background 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
	}
	.btn-apaper:hover {
		background: var(--apaper-accent);
		border-color: var(--apaper-accent);
		color: #ffffff;
		transform: translateY(-1px);
	}
	.btn-apaper-ghost {
		background: transparent;
		color: var(--apaper-ink);
		border-color: var(--apaper-line);
	}
	.btn-apaper-ghost:hover {
		background: rgba(32, 34, 33, 0.05);
		border-color: var(--apaper-ink);
		color: var(--apaper-ink);
	}

	/* Tags in apaper style */
	.plate-tags, .spec-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 14px;
	}
	.plate-tags span, .spec-tags span {
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		letter-spacing: 0.03em;
		padding: 3px 9px;
		border: 1px solid var(--apaper-line);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.6);
		color: var(--apaper-muted);
	}

	.terminal-title {
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		color: rgba(255, 255, 255, 0.5);
		margin-left: auto;
		letter-spacing: 0.06em;
	}

	/* ─────────────────────────────────────────────────────────────
	   Chapter 05: The Seven Bridges Inflection Point & Topological Fork
	   ───────────────────────────────────────────────────────────── */
	.node-pivot .node-dot-pivot {
		border-color: var(--apaper-accent);
		background: var(--apaper-accent);
		box-shadow: 0 0 0 4px var(--apaper-accent-soft);
	}
	.badge-pivot {
		color: var(--apaper-accent);
		font-weight: 700;
	}

	.pivot-stage {
		display: flex;
		flex-direction: column;
		width: 100%;
		position: relative;
	}

	/* Map Canvas Frame */
	.stage-canvas-frame {
		position: relative;
		border-radius: 18px;
		overflow: hidden;
		border: 1px solid var(--apaper-line);
		aspect-ratio: 720 / 490;
		background: #e8e3d6;
		box-shadow: 0 14px 34px rgba(32, 34, 33, 0.06);
	}
	.stage-map-bg {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		filter: saturate(0.96) contrast(1.02);
	}
	.stage-map-vignette {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 1;
		background: linear-gradient(180deg, rgba(248, 246, 240, 0.45) 0%, rgba(248, 246, 240, 0) 45%, rgba(248, 246, 240, 0.25) 100%);
	}

	/* Overlaid Transition Title */
	.pivot-overlay {
		position: absolute;
		top: clamp(14px, 2.5vw, 24px);
		left: clamp(14px, 2.5vw, 24px);
		right: clamp(14px, 2.5vw, 24px);
		max-width: 640px;
		background: rgba(248, 246, 240, 0.88);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border: 1px solid var(--apaper-line);
		border-radius: 14px;
		padding: clamp(14px, 2vw, 20px) clamp(16px, 2.5vw, 24px);
		box-shadow: 0 10px 28px rgba(32, 34, 33, 0.08);
		z-index: 4;
		opacity: 0;
		transform: translateY(16px);
		transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.pivot-stage.is-active .pivot-overlay {
		opacity: 1;
		transform: translateY(0);
	}
	.overlay-meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 8px;
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		letter-spacing: 0.12em;
	}
	.overlay-kicker {
		color: var(--apaper-accent);
		font-weight: 700;
		text-transform: uppercase;
	}
	.overlay-stamp {
		color: var(--apaper-muted);
		background: rgba(32, 34, 33, 0.04);
		padding: 2px 8px;
		border-radius: 4px;
		border: 1px solid var(--apaper-line);
	}
	.overlay-title {
		font-family: var(--apaper-font-serif);
		font-size: clamp(1.4rem, 2.4vw, 1.95rem);
		font-weight: 600;
		letter-spacing: -0.025em;
		color: var(--apaper-ink);
		margin: 0 0 6px;
		line-height: 1.25;
	}
	.overlay-subtitle {
		display: block;
		font-weight: 400;
		font-style: italic;
		color: var(--apaper-ink-secondary);
		font-size: 0.9em;
	}
	.overlay-summary {
		font-family: var(--apaper-font-serif);
		font-size: 0.92rem;
		line-height: 1.6;
		color: var(--apaper-ink-secondary);
		margin: 0;
	}

	/* Footer Caption inside map frame */
	.stage-footer-caption {
		position: absolute;
		bottom: 12px;
		left: 16px;
		right: 16px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-family: var(--apaper-font-mono);
		font-size: 8.5px;
		letter-spacing: 0.1em;
		color: rgba(32, 34, 33, 0.6);
		z-index: 3;
		pointer-events: none;
	}
	.caption-indicator {
		color: var(--apaper-accent);
		font-weight: 700;
	}

	/* SVG Euler Traversal Layer */
	.stage-euler-svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 2;
	}
	.euler-track {
		fill: none;
		stroke: var(--apaper-accent);
		stroke-width: 1.5;
		stroke-dasharray: 4 6;
		stroke-opacity: 0.25;
	}
	.euler-stroke {
		fill: none;
		stroke: var(--apaper-accent);
		stroke-width: 3.5;
		stroke-linecap: round;
		stroke-linejoin: round;
		filter: drop-shadow(0 0 4px rgba(196, 94, 73, 0.5));
	}
	.bridge-pin {
		fill: #fdfbf7;
		stroke: var(--apaper-accent);
		stroke-width: 2;
		transition: transform 0.35s ease, fill 0.35s ease, filter 0.35s ease;
		transform-origin: center;
	}
	.bridge-pin.is-passed {
		fill: #f59e0b;
		filter: drop-shadow(0 0 6px rgba(245, 158, 11, 0.9));
		transform: scale(1.35);
	}
	.euler-runner {
		fill: #f59e0b;
		filter: drop-shadow(0 0 6px #f59e0b);
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	/* Connective Topological Fork */
	.topological-fork {
		position: relative;
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-top: 14px;
		margin-bottom: 6px;
	}
	.fork-banner {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 3px 12px;
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		border-radius: 999px;
		font-family: var(--apaper-font-mono);
		font-size: 8.5px;
		letter-spacing: 0.12em;
		color: var(--apaper-accent);
		font-weight: 700;
		margin-bottom: 2px;
		box-shadow: 0 2px 8px rgba(32, 34, 33, 0.04);
	}
	.fork-pulse {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--apaper-accent);
		animation: pulse-glow 2s infinite ease-in-out;
	}
	.fork-svg {
		width: 100%;
		overflow: visible;
		display: block;
	}
	.fork-desktop {
		height: 68px;
	}
	.fork-mobile {
		display: none;
		height: 50px;
	}
	.fork-trunk {
		fill: none;
		stroke: var(--apaper-accent);
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-opacity: 0.4;
		transition: stroke-opacity 0.5s ease;
	}
	.fork-junction {
		fill: var(--apaper-accent);
		filter: drop-shadow(0 0 4px var(--apaper-accent));
	}
	.fork-branch {
		fill: none;
		stroke: var(--apaper-accent);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-opacity: 0.35;
		transition: stroke-opacity 0.6s ease;
	}
	.topological-fork.is-active .fork-trunk,
	.topological-fork.is-active .fork-branch {
		stroke-opacity: 0.9;
		filter: drop-shadow(0 0 3px rgba(196, 94, 73, 0.35));
	}

	/* 4 Systematic Competency Spec Cards */
	.specs-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: clamp(14px, 2vw, 22px);
		margin-top: 4px;
	}
	.spec-card {
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		border-radius: 16px;
		padding: 22px 20px;
		display: flex;
		flex-direction: column;
		position: relative;
		box-shadow: 0 6px 18px rgba(32, 34, 33, 0.03);
		opacity: 0.4;
		transform: translateY(14px);
		filter: grayscale(0.35);
		transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
		            transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
		            filter 0.6s cubic-bezier(0.22, 1, 0.36, 1),
		            border-color 0.25s ease,
		            box-shadow 0.25s ease;
	}
	.spec-card.is-revealed {
		opacity: 1;
		transform: translateY(0);
		filter: grayscale(0);
		border-color: rgba(196, 94, 73, 0.3);
		box-shadow: 0 10px 26px rgba(32, 34, 33, 0.06);
	}
	.spec-card:hover {
		border-color: var(--apaper-accent);
		transform: translateY(-3px);
		box-shadow: 0 14px 30px rgba(32, 34, 33, 0.09);
	}
	.card-connector-dot {
		position: absolute;
		top: -5px;
		left: 50%;
		transform: translateX(-50%);
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--apaper-card);
		border: 2px solid var(--apaper-accent);
		box-shadow: 0 0 0 2px rgba(196, 94, 73, 0.1);
		transition: background 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
		z-index: 2;
	}
	.spec-card.is-revealed .card-connector-dot {
		background: var(--apaper-accent);
		box-shadow: 0 0 0 4px var(--apaper-accent-soft);
	}
	.spec-card-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		letter-spacing: 0.12em;
		padding-bottom: 12px;
		margin-bottom: 14px;
		border-bottom: 1px solid var(--apaper-line);
	}
	.spec-id {
		color: var(--apaper-accent);
		font-weight: 700;
	}
	.spec-scope {
		color: var(--apaper-muted);
	}
	.spec-title {
		font-family: var(--apaper-font-serif);
		font-size: 1.18rem;
		font-weight: 600;
		color: var(--apaper-ink);
		margin: 0 0 10px;
		line-height: 1.25;
	}
	.spec-desc {
		font-family: var(--apaper-font-serif);
		font-size: 0.88rem;
		line-height: 1.65;
		color: var(--apaper-ink-secondary);
		margin: 0 0 16px;
	}


	/* ─────────────────────────────────────────────────────────────
	   SECONDARY CATALOG // More Work (apaper archival index)
	   ───────────────────────────────────────────────────────────── */
	.projects {
		background: var(--apaper-bg);
		color: var(--apaper-ink);
		border-bottom: 1px solid var(--apaper-line);
		padding: clamp(4.5rem, 8vw, 7rem) 1.5rem;
		position: relative;
	}
	.projects-editorial-header {
		max-width: 1180px;
		margin: 0 auto clamp(2.5rem, 5vw, 4rem);
	}
	.projects-meta-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
		padding-bottom: 16px;
		border-bottom: 1px solid var(--apaper-line);
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--apaper-muted);
	}
	.projects-wordmark {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--apaper-ink);
		font-weight: 500;
	}
	.projects-mark-glyph {
		width: 26px;
		height: 26px;
		border: 1px solid var(--apaper-ink);
		border-radius: 8px;
		display: grid;
		place-items: center;
		font-family: var(--apaper-font-serif);
		font-size: 13px;
		font-weight: 600;
		color: var(--apaper-ink);
		background: var(--apaper-card);
	}
	.projects-status-tag {
		color: var(--apaper-muted);
	}
	.projects-title {
		font-family: var(--apaper-font-serif);
		font-size: clamp(2.2rem, 4vw, 3.2rem);
		font-weight: 500;
		letter-spacing: -0.03em;
		color: var(--apaper-ink);
		margin: 1.5rem 0 0.8rem;
		line-height: 1.1;
	}
	.projects-lead {
		font-family: var(--apaper-font-serif);
		font-size: clamp(1rem, 1.3vw, 1.12rem);
		color: var(--apaper-muted);
		max-width: 680px;
		line-height: 1.7;
		margin: 0;
	}
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: clamp(14px, 2vw, 22px);
		max-width: 1180px;
		margin: 0 auto;
	}
	.project-card {
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		border-radius: 16px;
		padding: 22px 22px 20px;
		display: flex;
		flex-direction: column;
		position: relative;
		box-shadow: 0 4px 16px rgba(32, 34, 33, 0.03);
		transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
	}
	.project-card:hover {
		border-color: var(--apaper-accent);
		transform: translateY(-3px);
		box-shadow: 0 12px 28px rgba(32, 34, 33, 0.07);
	}
	.project-card-featured {
		border-color: rgba(196, 94, 73, 0.28);
		background: linear-gradient(180deg, var(--apaper-card) 0%, rgba(248, 246, 240, 0.6) 100%);
	}
	.project-card-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-bottom: 12px;
		margin-bottom: 14px;
		border-bottom: 1px solid var(--apaper-line);
	}
	.header-id-group {
		display: flex;
		align-items: center;
		gap: 8px;
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		letter-spacing: 0.12em;
	}
	.project-id {
		color: var(--apaper-accent);
		font-weight: 700;
	}
	.project-scope {
		color: var(--apaper-muted);
	}
	.project-glyph {
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		border-radius: 6px;
		background: rgba(32, 34, 33, 0.03);
		border: 1px solid var(--apaper-line-light);
		color: var(--apaper-accent);
		transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
		flex-shrink: 0;
	}
	.project-card:hover .project-glyph {
		background: rgba(196, 94, 73, 0.08);
		transform: scale(1.08);
	}
	.card-rebrand-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 8px;
		margin-bottom: 8px;
	}
	.card-rebrand-row .project-card-title {
		margin-bottom: 0;
	}
	.rebrand-tag {
		font-family: var(--apaper-font-mono);
		font-size: 7.5px;
		letter-spacing: 0.14em;
		font-weight: 700;
		color: var(--apaper-accent);
		background: rgba(196, 94, 73, 0.08);
		border: 1px solid rgba(196, 94, 73, 0.28);
		padding: 2px 6px;
		border-radius: 4px;
		text-transform: uppercase;
		flex-shrink: 0;
	}
	.project-card-title {
		font-family: var(--apaper-font-serif);
		font-size: 1.18rem;
		font-weight: 600;
		color: var(--apaper-ink);
		margin: 0 0 8px;
		line-height: 1.25;
	}
	.project-card-desc {
		font-family: var(--apaper-font-serif);
		font-size: 0.88rem;
		line-height: 1.65;
		color: var(--apaper-ink-secondary);
		margin: 0 0 14px;
		flex-grow: 1;
	}
	.project-card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-bottom: 16px;
	}
	.project-card-tags span {
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		letter-spacing: 0.02em;
		padding: 2.5px 8px;
		border-radius: 999px;
		background: rgba(32, 34, 33, 0.03);
		border: 1px solid var(--apaper-line);
		color: var(--apaper-muted);
	}
	.project-card-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 8px;
		margin-top: auto;
		padding-top: 14px;
		border-top: 1px solid var(--apaper-line-light);
	}
	.dual-actions {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}
	.project-status-stamp {
		font-family: var(--apaper-font-mono);
		font-size: 8px;
		letter-spacing: 0.12em;
		font-weight: 700;
		color: var(--apaper-muted);
		text-transform: uppercase;
	}
	.stamp-live {
		color: #059669;
	}
	.stamp-award {
		color: var(--apaper-accent);
	}

	/* ─────────────────────────────────────────────────────────────
	   CORRESPONDENCE & COLOPHON // Contact (apaper Dispatch Plate)
	   ───────────────────────────────────────────────────────────── */
	.contact {
		background: var(--apaper-bg-alt);
		color: var(--apaper-ink);
		padding: clamp(5rem, 8vw, 7.5rem) 1.5rem clamp(4rem, 6vw, 6rem);
		border-bottom: 1px solid var(--apaper-line);
		position: relative;
	}
	.contact-plate {
		max-width: 920px;
		margin: 0 auto;
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		border-radius: 18px;
		padding: clamp(2.5rem, 5vw, 4.2rem) clamp(1.8rem, 4vw, 3.8rem);
		box-shadow: 0 12px 36px rgba(32, 34, 33, 0.05);
		text-align: center;
	}
	.contact-meta-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
		padding-bottom: 16px;
		margin-bottom: 2rem;
		border-bottom: 1px solid var(--apaper-line);
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--apaper-muted);
	}
	.contact-wordmark {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--apaper-ink);
		font-weight: 500;
	}
	.contact-mark-glyph {
		width: 26px;
		height: 26px;
		border: 1px solid var(--apaper-ink);
		border-radius: 8px;
		display: grid;
		place-items: center;
		font-family: var(--apaper-font-serif);
		font-size: 13px;
		font-weight: 600;
		color: var(--apaper-ink);
		background: var(--apaper-bg);
	}
	.contact-status-tag {
		color: var(--apaper-accent);
		font-weight: 600;
	}
	.contact-title {
		font-family: var(--apaper-font-serif);
		font-size: clamp(2.2rem, 4vw, 3.4rem);
		font-weight: 600;
		letter-spacing: -0.03em;
		color: var(--apaper-ink);
		margin: 0 0 1rem;
		line-height: 1.15;
	}
	.contact-text {
		font-family: var(--apaper-font-serif);
		font-size: clamp(1.05rem, 1.4vw, 1.18rem);
		line-height: 1.75;
		color: var(--apaper-ink-secondary);
		max-width: 620px;
		margin: 0 auto 2.4rem;
	}
	.contact-buttons {
		display: flex;
		justify-content: center;
		gap: 10px;
		flex-wrap: wrap;
		margin-bottom: 2.5rem;
	}
	.contact-buttons .btn-apaper {
		padding: 9px 20px;
		font-size: 12px;
	}
	.contact-colophon-sub {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 10px;
		padding-top: 18px;
		border-top: 1px solid var(--apaper-line);
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--apaper-muted);
	}

	/* ─────────────────────────────────────────────────────────────
	   THEME PALETTE BAR (Interactive Color Preset Switcher)
	   ───────────────────────────────────────────────────────────── */
	.theme-palette-bar {
		max-width: 920px;
		margin: 2.5rem auto 0;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 14px;
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		letter-spacing: 0.12em;
	}
	.theme-bar-label {
		color: var(--apaper-muted);
		text-transform: uppercase;
		font-weight: 600;
	}
	.theme-pills {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
	}
	.theme-pill {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 5px 12px;
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		border-radius: 999px;
		color: var(--apaper-ink-secondary);
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		cursor: pointer;
		transition: border-color 0.2s ease, transform 0.2s ease, background 0.2s ease, color 0.2s ease;
	}
	.theme-pill:hover {
		border-color: var(--apaper-accent);
		color: var(--apaper-ink);
		transform: translateY(-1px);
	}
	.theme-pill.active {
		border-color: var(--apaper-ink);
		background: var(--apaper-ink);
		color: #ffffff;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
	}
	.pill-swatch {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		flex-shrink: 0;
	}
	.theme-pill.active .pill-swatch {
		box-shadow: 0 0 0 1px #fff;
	}

	/* Responsive media queries */
	@media (max-width: 1040px) {
		.fork-desktop {
			display: none;
		}
		.fork-mobile {
			display: block;
		}
		.specs-grid,
		.projects-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 980px) {
		.hero-inner {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
		.hero h1 {
			font-size: clamp(2.6rem, 6vw, 3.8rem);
		}
		.hero-visual {
			width: min(100%, 460px);
		}
	}

	@media (max-width: 859px) {
		.proof-grid {
			grid-template-columns: 1fr;
			max-width: 560px;
