---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL, SITE_AUTHOR, PROFILE_IMAGE, USER_TITLE, GITHUB_URL, WTCRAFT_URL, LINKEDIN_URL, EMAIL, MEDIUM_URL, SAME_AS, SITE_AUTHOR_ALT, GOLDENARC_NAME, GOLDENARC_SAME_AS } from '../consts';

// Signature-work links kept local to this page (mirrors the pattern used by
// edfviewer.astro / yong.astro, which each define their own APP_STORE_URL).
const WISHES_APP_STORE_URL = 'https://apps.apple.com/ca/app/wishes-by-hand/id6774579880';
const EDF_APP_STORE_URL = 'https://apps.apple.com/app/id6801383472';
const WILDDUNK_YT_ID = 'ysmp5vK4R_c';

// Identity knowledge graph for AI/search engines: who Victor Zhang is and what
// this site is. Person + WebSite, cross-linked by @id.
const personLd = {
	'@type': 'Person',
	'@id': `${SITE_URL}/#person`,
	name: SITE_AUTHOR,
	alternateName: SITE_AUTHOR_ALT,
	url: SITE_URL,
	image: PROFILE_IMAGE,
	jobTitle: USER_TITLE,
	email: `mailto:${EMAIL}`,
	knowsAbout: [
		'iOS Development', 'Swift', 'SwiftUI', 'React Native',
		'BLE / IoT device sync', 'Backend data pipelines', 'Telemetry',
		'Agentic AI workflows', 'Metal GPU programming',
		'On-device ML (CoreML)', 'Handwriting scoring',
	],
	alumniOf: [
		{ '@type': 'CollegeOrUniversity', name: 'University of British Columbia' },
		{ '@type': 'CollegeOrUniversity', name: 'Carleton University' },
		{ '@type': 'CollegeOrUniversity', name: 'Peking University' },
	],
	award: 'University Medal in Computer Science, Carleton University (2020)',
	worksFor: { '@id': `${SITE_URL}/#goldenarc` },
	sameAs: SAME_AS,
};
const organizationLd = {
	'@type': 'Organization',
	'@id': `${SITE_URL}/#goldenarc`,
	name: GOLDENARC_NAME,
	description: 'Independent digital studio founded by Victor Zhang (pre-launch).',
	founder: { '@id': `${SITE_URL}/#person` },
	...(GOLDENARC_SAME_AS.length ? { sameAs: GOLDENARC_SAME_AS } : {}),
};
const websiteLd = {
	'@type': 'WebSite',
	'@id': `${SITE_URL}/#website`,
	url: SITE_URL,
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	inLanguage: ['en', 'zh-CN'],
	author: { '@id': `${SITE_URL}/#person` },
	publisher: { '@id': `${SITE_URL}/#person` },
};
const homeLd = { '@context': 'https://schema.org', '@graph': [websiteLd, personLd, organizationLd] };
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify(homeLd)} />
	</head>
	<body>
		<Header />
		<main class="homepage">
			<!-- Hero Section -->
			<section class="hero">
				<div class="hero-content">
					<img src={PROFILE_IMAGE} alt="Victor Zhang" class="profile-image" />
					<h1 class="hero-title">Hi, I'm <span class="highlight">Victor Zhang</span></h1>
					<p class="hero-subtitle">{USER_TITLE}</p>
					<p class="hero-subtitle hero-subtitle-secondary">Building end-to-end data systems, from IoT to cloud — 10+ years in tech, 6 in software engineering.</p>
					<p class="hero-description">
						I build mobile products where data flows cleanly between devices and backend services. My work spans iOS, React Native, BLE sync, backend data pipelines, and telemetry, with a strong focus on correctness, resilience, and the control policies that keep real systems stable.
					</p>
					<div class="hero-cta">
						<a href="#work" class="btn btn-primary">See My Work ↓</a>
						<a href="/about" class="btn btn-secondary">About Me</a>
					</div>
				</div>
			</section>

			<!-- Proof Strip: the receipts, up front -->
			<section class="proof">
				<div class="container">
					<div class="proof-grid">
						<a href="#story" class="proof-tile">
							<img src="/images/proof/carleton-university-medal.webp" alt="Carleton University Medal in Computer Science, engraved with Yiwei Zhang, 2020" class="proof-thumb proof-thumb-medal" loading="lazy" />
							<div class="proof-text">
								<div class="proof-title">University Medal in Computer Science</div>
								<div class="proof-sub">Carleton University · 2020</div>
							</div>
						</a>
						<a href="#wilddunk" class="proof-tile">
							<img src="/images/proof/wilddunk-appannie-2015.webp" alt="App Annie Highest Ranks report for 全民大灌篮 / Wild Dunk showing #1 Sports (Games) in China, May 3 2015" class="proof-thumb proof-thumb-rank" loading="lazy" />
							<div class="proof-text">
								<div class="proof-title">#1 Sports · China App Store</div>
								<div class="proof-sub">Wild Dunk · May 3, 2015</div>
							</div>
						</a>
						<a href="#projects" class="proof-tile proof-tile-icon">
							<div class="proof-icon">🏆</div>
							<div class="proof-text">
								<div class="proof-title">2× Hackathon Winner</div>
								<div class="proof-sub">cuHacking · 2019 &amp; 2020</div>
							</div>
						</a>
					</div>
				</div>
			</section>

			<!-- Signature Work: the career arc, game design to production systems -->
			<section class="signature" id="work">
				<div class="container">
					<h2 class="section-title">Signature Work</h2>
					<p class="signature-intro">
						Four projects that trace one arc — from ranking and economy design in a mobile game to the production data systems I build today.
					</p>

					<div class="signature-grid">
						<div class="timeline-rail" aria-hidden="true">
							<svg class="timeline-path" viewBox="0 0 100 440" preserveAspectRatio="none">
								<path
									d="M50 10 C 92 40, 92 100, 50 132 C 8 164, 8 218, 50 250 C 92 282, 92 336, 50 368 C 24 390, 10 402, 46 424"
									vector-effect="non-scaling-stroke"
								/>
							</svg>
							<div class="timeline-node" style="top:5%">
								<span class="node-dot"></span>
								<span class="node-label">Started as<br />Mobile Game</span>
							</div>
							<div class="timeline-node" style="top:34%">
								<span class="node-dot"></span>
								<span class="node-label">Into Mobile<br />Engineering</span>
							</div>
							<div class="timeline-node" style="top:63%">
								<span class="node-dot"></span>
								<span class="node-label">Data &amp; Agentic<br />Pipeline Governance</span>
							</div>
							<div class="timeline-node" style="top:92%">
								<span class="node-dot"></span>
								<span class="node-label">Then Developer<br />Tooling</span>
							</div>
						</div>

						<!-- 1. Wild Dunk — game design origin -->
						<article class="sig-block" id="wilddunk">
							<div class="sig-media">
								<div class="video-facade" data-video-id={WILDDUNK_YT_ID} role="button" tabindex="0" aria-label="Play Wild Dunk gameplay video">
									<img src="/images/wilddunk/video-poster.webp" alt="全民大灌篮 / Wild Dunk gameplay artwork" loading="lazy" />
									<span class="play-btn" aria-hidden="true">
										<svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M8 5v14l11-7z" /></svg>
									</span>
								</div>
								<figure class="rank-card">
									<img src="/images/proof/wilddunk-appannie-2015.webp" alt="App Annie Highest Ranks report: #9 Overall, #1 Sports (Games), China, May 3 2015" loading="lazy" />
									<figcaption>
										Archived App Annie report · China · May 3, 2015. App Annie (now Sensor Tower) discontinued public app reports; Wild Dunk was later delisted from the App Store. App Store ID 949338049.
									</figcaption>
								</figure>
							</div>
							<div class="sig-body">
								<p class="eyebrow">Game Design · 2015</p>
								<h3>全民大灌篮 · Wild Dunk</h3>
								<p>
									As game design lead I owned core gameplay, ranking, and monetization for this basketball title — it reached <strong>#9 Overall</strong> and <strong>#1 in Sports</strong> on the China App Store. Designing its ranking ladders, seasonal economy, and retention loops is where I first learned to think in the state machines and control policies I now apply to production data systems.
								</p>
							</div>
						</article>

						<!-- 2. Wishes by Hand — emotional craft product -->
						<article class="sig-block sig-reverse" id="wishes">
							<div class="sig-media">
								<div class="phone-frame">
									<video autoplay loop muted playsinline class="sig-video" aria-label="亲笔小卡 handwriting demo">
										<source src="/videos/yong-demo-1.mp4" type="video/mp4" />
									</video>
								</div>
							</div>
							<div class="sig-body">
								<p class="eyebrow">Signature Project · App Store</p>
								<h3>亲笔小卡 · Wishes by Hand</h3>
								<p>
									A handwriting app for quiet reconnection: write by finger or Apple Pencil, watch a low-latency ink engine render real brush character, then send a finished card in one tap via Messages, WeChat, WhatsApp, or Instagram.
								</p>
								<div class="sig-cta">
									<a href={WISHES_APP_STORE_URL} target="_blank" rel="noopener" class="btn btn-primary btn-sm">App Store ↗</a>
									<a href="/yong" class="btn btn-secondary btn-sm">Full Story →</a>
								</div>
							</div>
						</article>

						<!-- 3. wtcraft — developer tool -->
						<article class="sig-block" id="wtcraft-sig">
							<div class="sig-media">
								<div class="terminal-card" aria-hidden="true">
									<div class="terminal-titlebar">
										<span></span><span></span><span></span>
									</div>
									<pre class="terminal-body"><code><span class="t-prompt">$</span> wtcraft init
<span class="t-prompt">$</span> wtcraft check
<span class="t-ok">✓</span> scope respected
<span class="t-ok">✓</span> off-limits clear
<span class="t-prompt">$</span> wtcraft verify
<span class="t-ok">✓</span> tests passed</code></pre>
								</div>
							</div>
							<div class="sig-body">
								<p class="eyebrow">Developer Tool · Open Source</p>
								<h3>wtcraft</h3>
								<p>
									A git-native CLI for multi-agent coding workflows. It scaffolds task contracts per worktree — Scope, Off-limits, Verification — then checks the actual changeset against them and runs deterministic verification, so a solo developer can hand bounded work to Claude, Codex, or any coding agent without losing the handoff.
								</p>
								<div class="sig-cta">
									<a href={WTCRAFT_URL} target="_blank" rel="noopener" class="btn btn-primary btn-sm">GitHub ↗</a>
									<a href="/wtcraft" class="btn btn-secondary btn-sm">Full Page →</a>
								</div>
							</div>
						</article>

						<!-- 4. EDF & BDF Viewer — professional tool -->
						<article class="sig-block sig-reverse" id="edfviewer-sig">
							<div class="sig-media">
								<img src="/images/edfviewer/hero-preview.webp" alt="ARC EDF & BDF Viewer on macOS — All-Channels Montage View" class="sig-frame" loading="lazy" />
							</div>
							<div class="sig-body">
								<p class="eyebrow">Mac App Store · macOS &amp; iPadOS</p>
								<h3>EDF &amp; BDF Viewer</h3>
								<p>
									A native SwiftUI viewer for European Data Format (EDF, EDF+) and BioSemi Data Format (BDF) biosignal recordings — EEG, ECG, sleep, and electrophysiology research. Zero runtime dependencies, no Java/Python environment, 100% on-device and private.
								</p>
								<div class="sig-cta">
									<a href={EDF_APP_STORE_URL} target="_blank" rel="noopener" class="btn btn-primary btn-sm">Mac App Store ↗</a>
									<a href="/edfviewer" class="btn btn-secondary btn-sm">Full Page →</a>
								</div>
							</div>
						</article>
					</div>

					<!-- Where the arc leads: the path forks into the current skill set -->
					<div class="skills-fanout">
						<p class="fanout-caption">Where the arc leads</p>
						<svg class="fanout-svg" viewBox="0 0 1000 90" preserveAspectRatio="none" aria-hidden="true">
							<path d="M500 4 C 500 34, 200 34, 125 84" vector-effect="non-scaling-stroke" />
							<path d="M500 4 C 500 30, 330 44, 375 84" vector-effect="non-scaling-stroke" />
							<path d="M500 4 C 500 30, 670 44, 625 84" vector-effect="non-scaling-stroke" />
							<path d="M500 4 C 500 34, 800 34, 875 84" vector-effect="non-scaling-stroke" />
						</svg>
						<div class="skills-row">
							<div class="skill-chip">
								<span class="skill-icon">📱</span>
								<span class="skill-label">Mobile Engineering</span>
							</div>
							<div class="skill-chip">
								<span class="skill-icon">🔄</span>
								<span class="skill-label">Data &amp; Pipeline Systems</span>
							</div>
							<div class="skill-chip">
								<span class="skill-icon">🤖</span>
								<span class="skill-label">Agentic Workflows</span>
							</div>
							<div class="skill-chip">
								<span class="skill-icon">🛠️</span>
								<span class="skill-label">Developer Tooling</span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Medal + Intro: bridge from Home's "what" to About's "how I think" -->
			<section class="story" id="story">
				<div class="container story-grid">
					<img src="/images/proof/carleton-university-medal.webp" alt="Carleton University Medal in Computer Science, engraved with Yiwei Zhang, 2020, held open in its presentation box" class="story-image" loading="lazy" />
					<div class="story-body">
						<h2>From Ranking Systems to System Design</h2>
						<p>
							In 2020 I graduated top of my Computer Science class at Carleton University, awarded the University Medal.
						</p>
						<p>
							My path ran through urban planning at Peking University, then four years of mobile game design — where Wild Dunk taught me to design ranking ladders and economy systems — before I moved fully into software engineering.
						</p>
						<p>
							<a href="/about" class="story-link">Curious how I break down mobile systems today? →</a>
						</p>
					</div>
				</div>
			</section>

			<!-- More Work -->
			<section class="projects" id="projects">
				<div class="container">
					<h2 class="section-title">More Work</h2>
					<div class="projects-grid">
						<div class="project-card">
							<div class="project-icon">🏥</div>
							<h3>VitalMark Wellness</h3>
							<p>HealthKit Integration &amp; SwiftUI</p>
							<a href="https://apps.apple.com/us/app/vitalmark-wellness-fitness/id6745228850" target="_blank" class="project-link">View on App Store →</a>
						</div>
						<div class="project-card">
							<div class="project-icon">🤖</div>
							<h3>Ninja AI Agentic App</h3>
							<p>LLM Streaming &amp; Multi-Model AI</p>
							<a href="https://apps.apple.com/us/app/ninja-ai-chat-code-create/id6702030312" target="_blank" class="project-link">View on App Store →</a>
						</div>
						<div class="project-card">
							<div class="project-icon">🎬</div>
							<h3>ZZZ Movie Rec System</h3>
							<p>ML-powered Movie Recommendations</p>
							<a href="https://zzz-movie-rec-system.vercel.app/" target="_blank" class="project-link">View Project →</a>
						</div>
						<div class="project-card">
							<div class="project-icon">📚</div>
							<h3>TutorOcean iOS App</h3>
							<p>Professional Tutoring Platform</p>
							<a href="https://apps.apple.com/ca/app/tutorocean/id1480876532" target="_blank" class="project-link">View on App Store →</a>
						</div>
						<div class="project-card">
							<div class="project-icon">🔍</div>
							<h3>cuHacking 2020 Winner</h3>
							<p>Crime Scene Forensic Analyzer</p>
							<a href="https://devpost.com/software/murder-on-2nd-floor-web-forensic-analyzer" target="_blank" class="project-link">View on Devpost →</a>
						</div>
						<div class="project-card">
							<div class="project-icon">🏆</div>
							<h3>cuHacking 2019 Winner</h3>
							<p>Amazon Connect Pizza Order System</p>
							<a href="https://devpost.com/software/cuhackingamazonconnect" target="_blank" class="project-link">View on Devpost →</a>
						</div>
					</div>
				</div>
			</section>

			<!-- Contact Section -->
			<section class="contact">
				<div class="container">
					<h2 class="section-title">Let's Connect</h2>
					<p class="contact-text">Interested in collaborating or just want to chat? I'd love to hear from you!</p>
					<div class="contact-buttons">
						<a href={`mailto:${EMAIL}`} class="btn btn-primary">Email Me</a>
						<a href={GITHUB_URL} target="_blank" class="btn btn-secondary">GitHub</a>
						<a href={WTCRAFT_URL} target="_blank" class="btn btn-secondary">wtcraft</a>
						<a href={LINKEDIN_URL} target="_blank" class="btn btn-secondary">LinkedIn</a>
						<a href={MEDIUM_URL} target="_blank" class="btn btn-secondary">Medium</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			// Click-to-play facade for the Wild Dunk video: no third-party iframe/JS
			// is loaded until the visitor actually asks to watch.
			document.querySelectorAll('.video-facade').forEach((facade) => {
				const play = () => {
					const videoId = facade.getAttribute('data-video-id');
					if (!videoId) return;
					const iframe = document.createElement('iframe');
					iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1`;
					iframe.title = 'Wild Dunk gameplay';
					iframe.setAttribute('frameborder', '0');
					iframe.setAttribute(
						'allow',
						'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture'
					);
					iframe.setAttribute('allowfullscreen', '');
					iframe.loading = 'lazy';
					facade.replaceChildren(iframe);
					facade.classList.add('is-playing');
				};
				facade.addEventListener('click', play);
				facade.addEventListener('keydown', (e) => {
					if (e instanceof KeyboardEvent && (e.key === 'Enter' || e.key === ' ')) {
						e.preventDefault();
						play();
					}
				});
			});
		</script>
	</body>
</html>

<style>
	.homepage {
		width: 100%;
		max-width: 100%;
		padding: 0;
	}

	/* Hero */
	.hero {
		position: relative;
		overflow: hidden;
		padding: clamp(4rem, 11vw, 8rem) 1.5rem clamp(3rem, 7vw, 5rem);
		background:
			radial-gradient(720px 420px at 50% -10%, var(--accent-soft) 0%, rgba(227, 244, 239, 0) 70%);
	}

	.hero::after {
		content: '';
		position: absolute;
		inset: auto 0 0 0;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--line), transparent);
	}

	.hero-content {
		position: relative;
		z-index: 2;
		text-align: center;
		max-width: 720px;
		margin: 0 auto;
	}

	.profile-image {
		width: 132px;
		height: 132px;
		border-radius: 50%;
		object-fit: cover;
		border: 4px solid var(--surface-raised);
		box-shadow: 0 0 0 1px var(--line), var(--shadow-lg);
		margin: 0 auto 1.75rem;
		display: block;
		transition: transform var(--dur) var(--ease);
	}
	.profile-image:hover {
		transform: scale(1.04);
	}

	.hero-title {
		font-size: clamp(2.5rem, 6vw, 3.6rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		margin-bottom: 0.6rem;
		color: rgb(var(--black));
	}
	.highlight {
		background: linear-gradient(120deg, var(--accent) 0%, var(--accent-bright) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-subtitle {
		font-size: 1.3rem;
		margin: 0 0 0.2rem;
		font-weight: 700;
		color: var(--accent-dark);
	}
	.hero-subtitle-secondary {
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		color: rgb(var(--gray));
		margin-bottom: 1.5rem;
	}

	.hero-description {
		font-size: 1.075rem;
		line-height: 1.7;
		color: rgb(var(--gray-dark));
		max-width: 620px;
		margin: 0 auto 2rem;
	}

	.hero-cta {
		display: flex;
		gap: 0.85rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	/* Proof strip */
	.proof {
		padding: 0 0 clamp(3rem, 7vw, 5rem);
	}
	.proof-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		max-width: 900px;
		margin: 0 auto;
	}
	@media (min-width: 700px) {
		.proof-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	.proof-tile {
		display: flex;
		align-items: center;
		gap: 1rem;
		background: var(--surface-raised);
		padding: 1rem;
		border-radius: var(--radius);
		border: 1px solid var(--line);
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease), border-color 0.25s var(--ease);
	}
	.proof-tile:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-md);
		border-color: rgba(var(--accent-rgb), 0.32);
	}
	.proof-thumb {
		width: 52px;
		height: 52px;
		object-fit: cover;
		border-radius: 10px;
		flex-shrink: 0;
		box-shadow: 0 0 0 1px var(--line);
	}
	.proof-thumb-medal {
		object-position: center 30%;
	}
	.proof-icon {
		width: 52px;
		height: 52px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 1.5rem;
		border-radius: 10px;
		background: var(--accent-soft);
		flex-shrink: 0;
	}
	.proof-title {
		font-size: 0.9rem;
		font-weight: 700;
		color: rgb(var(--black));
		line-height: 1.3;
	}
	.proof-sub {
		font-size: 0.78rem;
		color: rgb(var(--gray));
		margin-top: 0.15rem;
	}

	/* Sections */
	section {
		padding: var(--space-section) 0;
	}
	.container {
		max-width: var(--content);
		margin: 0 auto;
		padding: 0 1.5rem;
	}
	.section-title {
		text-align: center;
		font-size: clamp(1.9rem, 3.6vw, 2.5rem);
		margin: 0 0 1rem;
		position: relative;
		padding-bottom: 1rem;
	}
