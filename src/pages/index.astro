---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL, SITE_AUTHOR, PROFILE_IMAGE, USER_TITLE, GITHUB_URL, WTCRAFT_URL, LINKEDIN_URL, EMAIL, MEDIUM_URL, SAME_AS, SITE_AUTHOR_ALT, GOLDENARC_NAME, GOLDENARC_SAME_AS } from '../consts';

// Signature-work links kept local to this page (mirrors the pattern used by
// edfviewer.astro / yong.astro, which each define their own APP_STORE_URL).
const WISHES_APP_STORE_URL = 'https://apps.apple.com/ca/app/wishes-by-hand/id6774579880';
const EDF_APP_STORE_URL = 'https://apps.apple.com/app/id6801383472';
const WILDDUNK_YT_ID = 'ysmp5vK4R_c';

// Identity knowledge graph for AI/search engines: who Victor Zhang is and what
// this site is. Person + WebSite, cross-linked by @id.
const personLd = {
	'@type': 'Person',
	'@id': `${SITE_URL}/#person`,
	name: SITE_AUTHOR,
	alternateName: SITE_AUTHOR_ALT,
	url: SITE_URL,
	image: PROFILE_IMAGE,
	jobTitle: USER_TITLE,
	email: `mailto:${EMAIL}`,
	knowsAbout: [
		'iOS Development', 'Swift', 'SwiftUI', 'React Native',
		'BLE / IoT device sync', 'Backend data pipelines', 'Telemetry',
		'Agentic AI workflows', 'Metal GPU programming',
		'On-device ML (CoreML)', 'Handwriting scoring',
	],
	alumniOf: [
		{ '@type': 'CollegeOrUniversity', name: 'University of British Columbia' },
		{ '@type': 'CollegeOrUniversity', name: 'Carleton University' },
		{ '@type': 'CollegeOrUniversity', name: 'Peking University' },
	],
	award: 'University Medal in Computer Science, Carleton University (2020)',
	worksFor: { '@id': `${SITE_URL}/#goldenarc` },
	sameAs: SAME_AS,
};
const organizationLd = {
	'@type': 'Organization',
	'@id': `${SITE_URL}/#goldenarc`,
	name: GOLDENARC_NAME,
	description: 'Independent digital studio founded by Victor Zhang (pre-launch).',
	founder: { '@id': `${SITE_URL}/#person` },
	...(GOLDENARC_SAME_AS.length ? { sameAs: GOLDENARC_SAME_AS } : {}),
};
const websiteLd = {
	'@type': 'WebSite',
	'@id': `${SITE_URL}/#website`,
	url: SITE_URL,
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	inLanguage: ['en', 'zh-CN'],
	author: { '@id': `${SITE_URL}/#person` },
	publisher: { '@id': `${SITE_URL}/#person` },
};
const homeLd = { '@context': 'https://schema.org', '@graph': [websiteLd, personLd, organizationLd] };
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify(homeLd)} />
	</head>
	<body>
		<Header />
		<main class="homepage">
			<section class="hero" aria-labelledby="home-title">
				<div class="hero-inner container">
					<div class="hero-copy">
						<div class="hero-kicker-wrap">
							<span class="hero-kicker-glyph">弧</span>
							<span class="hero-kicker">[ARCHIVE // SYSTEMS &amp; MOBILE ARCHITECTURE]</span>
						</div>
						<h1 id="home-title">I build the data systems inside mobile products.</h1>
						<p class="hero-description">iOS, React Native, BLE sync, backend pipelines, and telemetry — engineered for correctness and resilience under real-world conditions, from device to cloud.</p>
						<div class="hero-cta">
							<a href="#work" class="btn-apaper btn-apaper-primary">See My Work ↓</a>
							<a href="/about" class="btn-apaper btn-apaper-ghost">How I Think →</a>
						</div>
						<div class="hero-credibility">
							<span class="cred-dot"></span>
							<span>10+ YEARS IN TECH // 7 YEARS IN SOFTWARE ENGINEERING</span>
						</div>
					</div>
					<div class="hero-visual">
						<div class="stage-container" id="hero-stage" aria-label="Interactive Systems Showcase">
							<div class="stage-meta-strip">
								<div class="stage-title-wrap">
									<span class="stage-pulse"></span>
									<span class="stage-label" id="stage-active-label">SYS // 01 · 亲笔小卡 (WISHES BY HAND)</span>
								</div>
								<button type="button" class="stage-shift-btn" id="stage-shift-btn" title="Shift to next artifact">
									<span class="shift-icon">⇄</span>
									<span>SHIFT</span>
								</button>
							</div>

							<!-- Layered Card Deck -->
							<div class="stage-deck">
								<!-- Card 0: Wishes by Hand (亲笔小卡) -->
								<div class="stage-card is-front" data-index="0" data-label="SYS // 01 · 亲笔小卡 (WISHES BY HAND)">
									<div class="card-screen card-screen-yong">
										<video
											src="/videos/replay-score-card.mp4"
											autoplay
											muted
											playsinline
											class="stage-video"
											aria-label="亲笔小卡 手写评分与回放演示"
										></video>
										<div class="screen-badge">
											<span class="badge-dot"></span>
											<span>01 · 亲笔落墨 · METAL BRUSH</span>
										</div>
									</div>
									<div class="card-caption-bar">
										<div class="caption-copy">
											<strong>Wishes by Hand · 亲笔小卡</strong>
											<span>Low-latency Metal brush engine &amp; stroke scoring</span>
										</div>
										<a href="/yong" class="stage-card-link">Story →</a>
									</div>
								</div>

								<!-- Card 1: Google Foobar Challenge Animation -->
								<div class="stage-card is-back" data-index="1" data-label="LAB // 02 · GOOGLE FOOBAR CHALLENGE">
									<div class="card-screen card-screen-terminal">
										<video
											src="/videos/google-foobar.mp4"
											muted
											playsinline
											class="stage-video"
											aria-label="Google Foobar challenge Level 1 animation"
										></video>
										<div class="screen-badge badge-terminal">
											<span class="badge-dot dot-terminal"></span>
											<span>02 · GOOGLE FOOBAR · SECRET LAB</span>
										</div>
									</div>
									<div class="card-caption-bar">
										<div class="caption-copy">
											<strong>Google Foobar Challenge</strong>
											<span>Algorithmic labyrinth &amp; terminal state animation</span>
										</div>
										<a href="https://www.youtube.com/watch?v=-rBEy82xzQc" target="_blank" rel="noopener" class="stage-card-link">Video ↗</a>
									</div>
								</div>

								<!-- Card 2: Wild Dunk (2015 Genesis Mobile System) -->
								<div class="stage-card is-hidden" data-index="2" data-label="NODE // 03 · 全民大灌篮 (WILD DUNK 2015)">
									<div class="card-screen card-screen-arcade">
										<video
											src="/videos/wilddunk-gameplay.mp4"
											poster="/images/wilddunk/video-poster.webp"
											muted
											playsinline
											class="stage-video"
											aria-label="Wild Dunk gameplay archive"
										></video>
										<div class="screen-badge badge-arcade">
											<span class="badge-dot dot-arcade"></span>
											<span>03 · WILD DUNK · GENESIS ARCHIVE</span>
										</div>
									</div>
									<div class="card-caption-bar">
										<div class="caption-copy">
											<strong>全民大灌篮 · Wild Dunk</strong>
											<span>China App Store #1 Sports · Real-time ranking state machine</span>
										</div>
										<a href="#wilddunk" class="stage-card-link">Archive ↓</a>
									</div>
								</div>
							</div>

							<!-- Stage Indicator Pills -->
							<div class="stage-pills" role="tablist">
								<button type="button" class="stage-pill active" data-target="0" role="tab" aria-selected="true">
									<span class="pill-dot"></span>
									<span>01 亲笔小卡</span>
								</button>
								<button type="button" class="stage-pill" data-target="1" role="tab" aria-selected="false">
									<span class="pill-dot"></span>
									<span>02 Google Foobar</span>
								</button>
								<button type="button" class="stage-pill" data-target="2" role="tab" aria-selected="false">
									<span class="pill-dot"></span>
									<span>03 全民大灌篮</span>
								</button>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="proof" id="proof" aria-label="Selected proof points">
				<div class="container proof-grid">
					<article class="proof-card">
						<div class="proof-card-header">
							<span class="proof-card-id">EXHIBIT // 01</span>
							<span class="proof-card-scope">HONOR RECORD</span>
						</div>
						<div class="proof-media proof-medal">
							<img src="/images/proof/carleton-university-medal-detail.webp" alt="Carleton University Medal in Computer Science, engraved with Yiwei Zhang, 2020" />
						</div>
						<div class="proof-copy">
							<strong>University Medal in Computer Science</strong>
							<span>Carleton University · Highest Graduation Standing · 2020</span>
						</div>
					</article>
					<a href="#wilddunk" class="proof-card">
						<div class="proof-card-header">
							<span class="proof-card-id">EXHIBIT // 02</span>
							<span class="proof-card-scope">CHART RECORD</span>
						</div>
						<div class="proof-media proof-rank">
							<img src="/images/proof/wilddunk-appannie-2015.webp" alt="App Annie Highest Ranks report showing Wild Dunk at number 1 in Sports in China" />
						</div>
						<div class="proof-copy">
							<strong>#1 Sports · China App Store</strong>
							<span>Wild Dunk · App Annie Peak Rank · May 3, 2015</span>
						</div>
					</a>
					<a href="https://devpost.com/zywkloo" target="_blank" rel="noopener" class="proof-card">
						<div class="proof-card-header">
							<span class="proof-card-id">EXHIBIT // 03</span>
							<span class="proof-card-scope">COMPETITION</span>
						</div>
						<div class="proof-media proof-devpost">
							<img src="/images/proof/devpost-hackathon-winners.webp" alt="Victor Zhang's Devpost portfolio showing two projects marked Winner" />
						</div>
						<div class="proof-copy">
							<strong>2× Hackathon Winner</strong>
							<span>cuHacking 2019 &amp; 2020 · Devpost Verified</span>
						</div>
					</a>
				</div>
			</section>

			<section class="signature" id="work" aria-labelledby="signature-title">
				<!-- Section Lead: apaper editorial atmosphere -->
				<div class="sig-editorial-header container">
					<div class="sig-meta-bar">
						<span class="sig-wordmark">
							<span class="sig-mark-glyph">弧</span>
							<span>SYSTEM ARCHIVE / VOL. 01</span>
						</span>
						<span class="sig-timeframe">2015 — 2026 / DECADE IN CRAFT</span>
						<span class="sig-status-tag"><span class="sig-pulse-dot"></span>05 NODES</span>
					</div>

					<div class="sig-title-block">
						<p class="sig-eyebrow">CAREER TRAJECTORY &amp; TOPOLOGICAL ARC</p>
						<h2 id="signature-title">Signature Work</h2>
						<p class="sig-lead-text">
							A single continuous trajectory: from leading game dev teams and product economies in a top-charting mobile hit, to tactile brush engines, agentic boundary contracts, and zero-dependency biosignal viewers — culminating in topological systems clarity.
						</p>
					</div>
				</div>

				<!-- The Streamlined Spine Flow -->
				<div class="editorial-flow container">
					<!-- Milestones List -->
					<div class="editorial-milestones">

						<!-- Chapter 01: Wild Dunk -->
						<article class="editorial-node" id="wilddunk">
							<div class="node-rail" aria-hidden="true">
								<div class="node-marker">
									<span class="node-num">01</span>
									<span class="node-dot"></span>
								</div>
								<span class="node-line-seg"></span>
							</div>
							<div class="node-content">
								<div class="node-header">
									<span class="node-badge">CHAPTER // 01</span>
									<span class="node-date">2015 · PRODUCT MANAGEMENT &amp; DEV LEAD</span>
								</div>
								<div class="node-plate">
									<div class="plate-media">
										<div class="chapter-video-wrap">
											<video
												src="/videos/wilddunk-gameplay.mp4"
												poster="/images/wilddunk/video-poster.webp"
												controls
												preload="metadata"
												playsinline
												class="chapter-native-video"
												aria-label="Wild Dunk gameplay video"
											></video>
											<span class="media-stamp">ARCHIVE // 2015 · LOCAL HD</span>
										</div>
										<figure class="rank-card">
											<img src="/images/proof/wilddunk-appannie-2015.webp" alt="App Annie report: Wild Dunk ranked number 9 overall and number 1 in Sports in China on May 3, 2015" loading="lazy" />
											<figcaption>Archived App Annie report · China · May 3, 2015. App Store ID 949338049.</figcaption>
										</figure>
									</div>
									<div class="plate-story">
										<span class="plate-kicker">PRODUCT MANAGEMENT &amp; MONETIZATION</span>
										<h3>全民大灌篮 · Wild Dunk</h3>
										<p class="plate-p">
											As Lead Game Designer (主策划), I spearheaded the cross-functional mobile game development team across engineering, 3D art, and QA — owning product design, core basketball gameplay, and monetization loops for this title, reaching <strong>#1 in Sports</strong> and <strong>#9 Overall</strong> on the China App Store.
										</p>
										<blockquote class="editorial-quote">
											<p>Leading a fast-paced mobile dev team and modeling high-stakes player economies taught me product ownership from the ground up — balancing mathematical monetization loops, UX psychology, and client-server constraints. That foundation of cross-functional leadership and end-to-end systems thinking directly shapes how I lead and architect mobile products today.</p>
										</blockquote>
										<div class="plate-tags">
											<span>Game Dev Leadership</span>
											<span>Product &amp; Monetization</span>
											<span>Core Game Design</span>
											<span>China App Store #1</span>
										</div>
									</div>
								</div>
							</div>
						</article>

						<!-- Chapter 02: Wishes by Hand -->
						<article class="editorial-node" id="wishes">
							<div class="node-rail" aria-hidden="true">
								<div class="node-marker">
									<span class="node-num">02</span>
									<span class="node-dot"></span>
								</div>
								<span class="node-line-seg"></span>
							</div>
							<div class="node-content">
								<div class="node-header">
									<span class="node-badge">CHAPTER // 02</span>
									<span class="node-date">APP STORE · EMOTIONAL CRAFT</span>
								</div>
								<div class="node-plate plate-reverse">
									<div class="plate-media">
										<div class="media-frame">
											<img src="/images/wishes-hero.webp" alt="Wishes by Hand app showing a handwritten Chinese greeting card" class="sig-frame wishes-frame" loading="lazy" />
											<span class="media-stamp">PRODUCT // iOS</span>
										</div>
									</div>
									<div class="plate-story">
										<span class="plate-kicker">LOW-LATENCY INK ENGINE</span>
										<h3>亲笔小卡 · Wishes by Hand</h3>
										<p class="plate-p">
											A handwriting instrument for quiet reconnection: write by finger or Apple Pencil, powered by a custom low-latency ink engine that captures authentic Chinese calligraphy brush kinetics and pressure dynamics.
										</p>
										<blockquote class="editorial-quote">
											<p>Engineered for emotional immediacy: zero friction from the first stroke to sending a finished digital card, balancing on-device Metal rendering with minimal memory footprint.</p>
										</blockquote>
										<div class="plate-cta">
											<a href={WISHES_APP_STORE_URL} target="_blank" rel="noopener" class="btn-apaper">App Store ↗</a>
											<a href="/yong" class="btn-apaper btn-apaper-ghost">Full Story →</a>
										</div>
										<div class="plate-tags">
											<span>SwiftUI</span>
											<span>Apple Pencil</span>
											<span>Metal Ink</span>
											<span>Human Interface</span>
										</div>
									</div>
								</div>
							</div>
						</article>

						<!-- Chapter 03: wtcraft -->
						<article class="editorial-node" id="wtcraft-sig">
							<div class="node-rail" aria-hidden="true">
								<div class="node-marker">
									<span class="node-num">03</span>
									<span class="node-dot"></span>
								</div>
								<span class="node-line-seg"></span>
							</div>
							<div class="node-content">
								<div class="node-header">
									<span class="node-badge">CHAPTER // 03</span>
									<span class="node-date">OPEN SOURCE · INFRASTRUCTURE</span>
								</div>
								<div class="node-plate">
									<div class="plate-media">
										<div class="terminal-card" aria-hidden="true">
											<div class="terminal-titlebar">
												<span></span><span></span><span></span>
												<div class="terminal-title">wtcraft — git task contract</div>
											</div>
											<pre class="terminal-body"><code><span class="t-prompt">$</span> wtcraft init
<span class="t-prompt">$</span> wtcraft check
<span class="t-ok">✓</span> scope respected
<span class="t-ok">✓</span> off-limits clear
<span class="t-prompt">$</span> wtcraft verify
<span class="t-ok">✓</span> deterministic tests passed</code></pre>
										</div>
									</div>
									<div class="plate-story">
										<span class="plate-kicker">AGENTIC TASK SCAFFOLDING</span>
										<h3>wtcraft</h3>
										<p class="plate-p">
											A git-native CLI for multi-agent coding workflows. It scaffolds task contracts per worktree, continuously audits actual diffs against scope rules, and orchestrates deterministic verification.
										</p>
										<blockquote class="editorial-quote">
											<p>Keeps autonomous agent delegation bounded without losing the handoff context. Solving the coordination problem before delegating the code.</p>
										</blockquote>
										<div class="plate-cta">
											<a href={WTCRAFT_URL} target="_blank" rel="noopener" class="btn-apaper">GitHub ↗</a>
											<a href="/wtcraft" class="btn-apaper btn-apaper-ghost">Full Page →</a>
										</div>
										<div class="plate-tags">
											<span>CLI Tooling</span>
											<span>Multi-Agent</span>
											<span>Git Worktrees</span>
											<span>Verification</span>
										</div>
									</div>
								</div>
							</div>
						</article>

						<!-- Chapter 04: EDF Viewer -->
						<article class="editorial-node" id="edfviewer-sig">
							<div class="node-rail" aria-hidden="true">
								<div class="node-marker">
									<span class="node-num">04</span>
									<span class="node-dot"></span>
								</div>
								<span class="node-line-seg"></span>
							</div>
							<div class="node-content">
								<div class="node-header">
									<span class="node-badge">CHAPTER // 04</span>
									<span class="node-date">MACOS &amp; IPADOS · RESEARCH TOOL</span>
								</div>
								<div class="node-plate plate-reverse">
									<div class="plate-media">
										<div class="media-frame">
											<img src="/images/edfviewer/hero-preview.webp" alt="ARC EDF and BDF Viewer on macOS showing an all-channels montage" class="sig-frame" loading="lazy" />
											<span class="media-stamp">DESKTOP // NATIVE</span>
										</div>
									</div>
									<div class="plate-story">
										<span class="plate-kicker">ZERO-DEPENDENCY BIOSIGNALS</span>
										<h3>EDF &amp; BDF Viewer</h3>
										<p class="plate-p">
											A native SwiftUI viewer for EDF and BDF biosignal recordings — EEG, ECG, sleep staging, and electrophysiology research. Zero runtime dependencies, 100% on-device and private.
										</p>
										<blockquote class="editorial-quote">
											<p>Engineered for instantaneous scrubbing across dense multichannel datasets with custom memory-mapped parsing and zero telemetry leaks.</p>
										</blockquote>
										<div class="plate-cta">
											<a href={EDF_APP_STORE_URL} target="_blank" rel="noopener" class="btn-apaper">Mac App Store ↗</a>
											<a href="/edfviewer" class="btn-apaper btn-apaper-ghost">Full Page →</a>
										</div>
										<div class="plate-tags">
											<span>SwiftUI Native</span>
											<span>macOS / iPadOS</span>
											<span>Biosignal EDF/BDF</span>
											<span>Local-First</span>
										</div>
									</div>
								</div>
							</div>
						</article>

						<!-- Chapter 05: The Seven Bridges Inflection Point (七桥之思) -->
						<article class="editorial-node node-pivot" id="seven-bridges">
							<div class="node-rail" aria-hidden="true">
								<div class="node-marker marker-pivot">
									<span class="node-num">05</span>
									<span class="node-dot node-dot-pivot"></span>
								</div>
								<span class="node-line-seg"></span>
							</div>
							<div class="node-content">
								<div class="node-header">
									<span class="node-badge badge-pivot">CHAPTER // 05 · THE TOPOLOGICAL PIVOT</span>
									<span class="node-date">KÖNIGSBERG 1736 → PRODUCTION 2026</span>
								</div>

								<div class="pivot-plate">
									<div class="pivot-illustration-wrap">
										<figure class="pivot-figure">
											<img src="/images/konigsberg-bridges-simple.webp" width="720" height="531" alt="Historical map illustration of the seven bridges of Königsberg connecting two riverbanks and two islands" loading="lazy" />
											<div class="pivot-stamp">1736 EULER // GRAPH THEORY</div>
											<div class="pivot-vignette" aria-hidden="true"></div>
											<svg class="pivot-river" viewBox="0 0 720 531" aria-hidden="true">
												<path class="flow-pregel-1" d="M0 232 C160 220 340 225 430 222 C500 220 555 216 600 222" />
												<path class="flow-pregel-2" d="M150 302 C300 300 450 300 545 308 C575 340 600 380 592 420 C585 455 580 495 600 525" />
											</svg>
										</figure>
										<div class="pivot-caption">
											<span>KÖNIGSBERG SEVEN BRIDGES</span>
											<span>EULER'S FOUNDATION OF TOPOLOGY</span>
										</div>
									</div>

									<div class="pivot-thesis">
										<span class="plate-kicker">SYSTEMS PHILOSOPHY</span>
										<h3>Complexity, made navigable.</h3>
										<p class="pivot-lead">
											In 1736, Leonhard Euler proved that traversing Königsberg’s seven bridges without repeating one was impossible. He succeeded by discarding geography and abstracting the problem entirely into <strong>nodes and edges</strong> — laying the foundation of graph theory and topology.
										</p>
										<div class="pivot-quote-box">
											<span class="pivot-quote-label">THE ENGINEERING REDUCTION</span>
											<p>
												Across mobile state management, asynchronous BLE telemetry, and agent swarms, my engineering methodology follows this exact Euler principle: <em>strip away accidental complexity, model the underlying topology, and make system state transitions deterministic and verifiable.</em>
											</p>
