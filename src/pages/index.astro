---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ViewportVideo from '../components/ViewportVideo.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL, SITE_AUTHOR, PROFILE_IMAGE, USER_TITLE, GITHUB_URL, WTCRAFT_URL, LINKEDIN_URL, EMAIL, MEDIUM_URL, SAME_AS, SITE_AUTHOR_ALT, GOLDENARC_NAME, GOLDENARC_SAME_AS } from '../consts';

// Signature-work links kept local to this page (mirrors the pattern used by
// edfviewer.astro / yong.astro, which each define their own APP_STORE_URL).
const WISHES_APP_STORE_URL = 'https://apps.apple.com/ca/app/wishes-by-hand/id6774579880';
const EDF_APP_STORE_URL = 'https://apps.apple.com/app/id6801383472';
const NINJA_GOOGLE_PLAY_URL = 'https://play.google.com/store/apps/details?id=ai.ninjatech.mobile';
const WILDDUNK_YT_ID = 'ysmp5vK4R_c';

// Identity knowledge graph for AI/search engines: who Victor Zhang is and what
// this site is. Person + WebSite, cross-linked by @id.
const personLd = {
	'@type': 'Person',
	'@id': `${SITE_URL}/#person`,
	name: SITE_AUTHOR,
	alternateName: SITE_AUTHOR_ALT,
	url: SITE_URL,
	image: PROFILE_IMAGE,
	jobTitle: USER_TITLE,
	email: `mailto:${EMAIL}`,
	knowsAbout: [
		'iOS Development', 'Swift', 'SwiftUI', 'React Native',
		'BLE / IoT device sync', 'Backend data pipelines', 'Telemetry',
		'Agentic AI workflows', 'Metal GPU programming',
		'On-device ML (CoreML)', 'Handwriting scoring',
	],
	alumniOf: [
		{ '@type': 'CollegeOrUniversity', name: 'University of British Columbia' },
		{ '@type': 'CollegeOrUniversity', name: 'Carleton University' },
		{ '@type': 'CollegeOrUniversity', name: 'Peking University' },
	],
	award: 'University Medal in Computer Science, Carleton University (2020)',
	worksFor: { '@id': `${SITE_URL}/#goldenarc` },
	sameAs: SAME_AS,
};
const organizationLd = {
	'@type': 'Organization',
	'@id': `${SITE_URL}/#goldenarc`,
	name: GOLDENARC_NAME,
	description: 'Independent digital studio founded by Victor Zhang (pre-launch).',
	founder: { '@id': `${SITE_URL}/#person` },
	...(GOLDENARC_SAME_AS.length ? { sameAs: GOLDENARC_SAME_AS } : {}),
};
const websiteLd = {
	'@type': 'WebSite',
	'@id': `${SITE_URL}/#website`,
	url: SITE_URL,
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	inLanguage: ['en', 'zh-CN'],
	author: { '@id': `${SITE_URL}/#person` },
	publisher: { '@id': `${SITE_URL}/#person` },
};
const homeLd = { '@context': 'https://schema.org', '@graph': [websiteLd, personLd, organizationLd] };
---

<!doctype html>
	<html lang="en" data-paper-theme="carbon">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify(homeLd)} />
	</head>
	<body>
		<Header />
		<main class="homepage">
			<section class="hero" aria-labelledby="home-title">
				<div class="hero-inner container">
					<div class="hero-copy">
						<div class="hero-kicker-wrap">
							<span class="hero-kicker-glyph">弧</span>
							<span class="hero-kicker">[VICTOR ZHANG // SYSTEMS &amp; DATA CRAFT]</span>
						</div>
						<h1 id="home-title">I harness and visualize data flow from devices to the cloud.</h1>
						<p class="hero-description">Bridging physical sensors, mobile runtimes, and resilient cloud backends — turning high-frequency telemetry into robust state and responsive visual experiences.</p>
						<div class="hero-cta">
							<a href="#work" class="btn-apaper btn-apaper-primary">See My Work ↓</a>
							<a href="/about" class="btn-apaper btn-apaper-ghost">How I Think →</a>
						</div>
						<div class="hero-credibility">
							<span class="cred-dot"></span>
							<span>10+ YEARS IN TECH // 7 YEARS IN SOFTWARE ENGINEERING</span>
						</div>
					</div>
					<div class="hero-visual">
						<div class="stage-container" id="hero-stage" aria-label="Interactive Systems Showcase">
							<div class="stage-meta-strip">
								<div class="stage-title-wrap">
									<span class="stage-pulse"></span>
									<span class="stage-label" id="stage-active-label">SYS // 01 · 亲笔落墨 (WISHES BY HAND)</span>
								</div>
								<div class="stage-nav-cluster">
									<button type="button" class="stage-arrow-btn" id="stage-prev-btn" title="Previous artifact (左切)" aria-label="Previous">
										<span>‹</span>
									</button>
									<button type="button" class="stage-arrow-btn" id="stage-next-btn" title="Next artifact (右切)" aria-label="Next">
										<span>›</span>
									</button>
								</div>
							</div>

							<!-- 3D Cover Flow Deck -->
							<div class="stage-deck">
								<!-- Card 0: Wishes by Hand (亲笔小卡 with yong-demo-1.mp4) -->
								<div class="stage-card is-center" data-index="0" data-label="SYS // 01 · 亲笔落墨 (WISHES BY HAND)">
									<div class="card-screen card-screen-yong">
										<ViewportVideo
											src="/videos/yong-demo-1.mp4"
											poster="/images/wishes/video-poster.jpg"
											class="stage-video"
											ariaLabel="亲笔小卡 实时墨水笔刷与书法回放演示"
										/>
										<div class="screen-badge">
											<span class="badge-dot"></span>
											<span>01 · 亲笔落墨 · METAL BRUSH</span>
										</div>
									</div>
									<div class="card-caption-bar">
										<div class="caption-copy">
											<strong>Wishes by Hand · 亲笔小卡</strong>
											<span>Low-latency Metal ink engine &amp; stroke rendering</span>
										</div>
										<a href="/yong" class="stage-card-link">Story →</a>
									</div>
								</div>

								<!-- Card 1: EDF & BDF Viewer (edf-viewer-demo.mp4) -->
								<div class="stage-card is-next" data-index="1" data-label="SYS // 02 · EDF & BDF VIEWER (BIOSIGNALS)">
									<div class="card-screen card-screen-edf">
										<ViewportVideo
											src="/videos/edf-viewer-demo.mp4"
											poster="/images/edfviewer/hero-preview.webp"
											class="stage-video"
											ariaLabel="ARC EDF and BDF Viewer multi-channel waveform scrolling demo"
											initialActive={false}
										/>
										<div class="screen-badge badge-edf">
											<span class="badge-dot dot-edf"></span>
											<span>02 · EDF VIEWER · BIOSIGNAL WAVEFORMS</span>
										</div>
									</div>
									<div class="card-caption-bar">
										<div class="caption-copy">
											<strong>ARC EDF &amp; BDF Viewer</strong>
											<span>Multi-channel EEG/ECG waveform scrolling &amp; parser</span>
										</div>
										<a href="/edfviewer" class="stage-card-link">Full Page →</a>
									</div>
								</div>

								<!-- Card 2: Google Foobar Challenge -->
								<div class="stage-card is-hidden" data-index="2" data-label="LAB // 03 · GOOGLE FOOBAR CHALLENGE">
									<div class="card-screen card-screen-terminal">
										<ViewportVideo
											src="/videos/google-foobar.mp4"
											poster="/images/video-posters/google-foobar.webp"
											class="stage-video"
											ariaLabel="Google Foobar challenge Level 1 animation"
											initialActive={false}
										/>
										<div class="screen-badge badge-terminal">
											<span class="badge-dot dot-terminal"></span>
											<span>03 · GOOGLE FOOBAR · SECRET LAB</span>
										</div>
									</div>
									<div class="card-caption-bar">
										<div class="caption-copy">
											<strong>Google Foobar Challenge</strong>
											<span>Algorithmic labyrinth &amp; terminal state animation</span>
										</div>
										<a href="https://www.youtube.com/watch?v=-rBEy82xzQc" target="_blank" rel="noopener" class="stage-card-link">Video ↗</a>
									</div>
								</div>

								<!-- Card 3: Wild Dunk (2015 Genesis Mobile System) -->
								<div class="stage-card is-prev" data-index="3" data-label="NODE // 04 · 全民大灌篮 (WILD DUNK 2015)">
									<div class="card-screen card-screen-arcade">
										<ViewportVideo
											src="/videos/wilddunk-gameplay.mp4"
											poster="/images/wilddunk/video-poster.webp"
											class="stage-video"
											ariaLabel="Wild Dunk gameplay archive"
											initialActive={false}
										/>
										<div class="screen-badge badge-arcade">
											<span class="badge-dot dot-arcade"></span>
											<span>04 · WILD DUNK · GENESIS ARCHIVE</span>
										</div>
									</div>
									<div class="card-caption-bar">
										<div class="caption-copy">
											<strong>全民大灌篮 · Wild Dunk</strong>
											<span>China App Store #1 Sports · Real-time ranking engine</span>
										</div>
										<a href="#wilddunk" class="stage-card-link">Archive ↓</a>
									</div>
								</div>
							</div>

							<!-- Stage Indicator Pills -->
							<div class="stage-pills" role="tablist">
								<button type="button" class="stage-pill active" data-target="0" role="tab" aria-selected="true">
									<span class="pill-dot"></span>
									<span>01 亲笔小卡</span>
								</button>
								<button type="button" class="stage-pill" data-target="1" role="tab" aria-selected="false">
									<span class="pill-dot"></span>
									<span>02 EDF 波形</span>
								</button>
								<button type="button" class="stage-pill" data-target="2" role="tab" aria-selected="false">
									<span class="pill-dot"></span>
									<span>03 Google Foobar</span>
								</button>
								<button type="button" class="stage-pill" data-target="3" role="tab" aria-selected="false">
									<span class="pill-dot"></span>
									<span>04 全民大灌篮</span>
								</button>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="signature" id="work" aria-labelledby="signature-title">
				<!-- Section Lead: apaper editorial atmosphere -->
				<div class="sig-editorial-header container">
					<div class="sig-meta-bar">
						<span class="sig-wordmark">
							<span class="sig-mark-glyph">弧</span>
							<span>SYSTEM ARCHIVE / VOL. 01</span>
						</span>
						<span class="sig-timeframe">2015 — 2026 / DECADE IN CRAFT</span>
						<span class="sig-status-tag"><span class="sig-pulse-dot"></span>05 NODES</span>
					</div>

					<div class="sig-title-block">
						<p class="sig-eyebrow">CAREER TRAJECTORY &amp; TOPOLOGICAL ARC</p>
						<h2 id="signature-title">Signature Work</h2>
						<p class="sig-lead-text">
							Five chapters. One arc: product leadership → expressive native tools → bounded agents → private data systems.
						</p>
					</div>
				</div>

				<!-- The Streamlined Spine Flow -->
				<div class="editorial-flow container">
					<!-- Milestones List -->
					<div class="editorial-milestones">

						<!-- Chapter 01: Wild Dunk -->
						<article class="editorial-node" id="wilddunk">
							<div class="node-rail" aria-hidden="true">
								<div class="node-marker">
									<span class="node-num">01</span>
									<span class="node-dot"></span>
								</div>
								<span class="node-line-seg"></span>
							</div>
							<div class="node-content">
								<div class="node-header">
									<span class="node-badge">CHAPTER // 01</span>
									<span class="node-date">2015 · PRODUCT MANAGEMENT &amp; DEV LEAD</span>
								</div>
								<div class="node-plate">
									<div class="plate-media">
										<div class="chapter-video-wrap">
											<video
												src="/videos/wilddunk-gameplay.mp4"
												poster="/images/wilddunk/video-poster.webp"
												controls
												muted
												preload="metadata"
												playsinline
												class="chapter-native-video"
												aria-label="Wild Dunk gameplay video"
											></video>
											<span class="media-stamp">ARCHIVE // 2015 · LOCAL HD</span>
										</div>
									</div>
									<div class="plate-story">
										<span class="plate-kicker">PRODUCT MANAGEMENT &amp; MONETIZATION</span>
										<h3>全民大灌篮 · Wild Dunk</h3>
										<p class="plate-p">
											Led the team behind a top-charting China mobile title.
										</p>
										<ul class="plate-highlights">
											<li><strong>#1</strong> Sports · <strong>#9</strong> Overall, China App Store</li>
											<li>Owned gameplay and monetization loops</li>
											<li>Led engineering, 3D art, and QA</li>
										</ul>
										<div class="plate-cta">
											<a href="https://www.youtube.com/watch?v=ysmp5vK4R_c" target="_blank" rel="noopener" class="btn-apaper btn-apaper-ghost">YouTube Archive ↗</a>
										</div>
										<div class="plate-tags">
											<span>Game Dev Leadership</span>
											<span>Product &amp; Monetization</span>
											<span>Core Game Design</span>
											<span>China App Store #1</span>
										</div>
									</div>
								</div>
							</div>
						</article>

						<!-- Chapter 02: Wishes by Hand -->
						<article class="editorial-node" id="wishes">
							<div class="node-rail" aria-hidden="true">
								<div class="node-marker">
									<span class="node-num">02</span>
									<span class="node-dot"></span>
								</div>
								<span class="node-line-seg"></span>
							</div>
							<div class="node-content">
								<div class="node-header">
									<span class="node-badge">CHAPTER // 02</span>
									<span class="node-date">APP STORE · EMOTIONAL CRAFT</span>
								</div>
								<div class="node-plate plate-reverse">
									<div class="plate-media">
										<div class="media-frame wishes-media-frame">
											<div class="wishes-carousel" data-wishes-carousel aria-label="Wishes by Hand product showcase">
												<div class="wishes-carousel-viewport">
													<div class="wishes-carousel-track">
														<figure class="wishes-slide is-active" data-wishes-slide aria-hidden="false">
															<ViewportVideo
																src="/videos/yong-demo-2.mp4"
																poster="/images/wishes/video-poster.jpg"
																class="wishes-demo-video"
																ariaLabel="Wishes by Hand calligraphy and card-design demonstration"
															/>
															<figcaption class="wishes-slide-label">01 · INK / REPLAY</figcaption>
														</figure>
														<figure class="wishes-slide wishes-card-slide" data-wishes-slide aria-hidden="true">
															<img src="/images/wishes-blessing.webp" alt="Wishes by Hand greeting-card blessing preview" class="wishes-blessing-preview" loading="eager" />
															<div class="wishes-sms-notification" data-wishes-notification role="status" aria-live="polite">
																<span class="wishes-notification-icon" aria-hidden="true">✉</span>
																<div>
																	<span class="wishes-notification-meta">信息 · 现在</span>
																	<strong>亲笔小卡</strong>
																	<p>已为家人送出一张手写祝福卡</p>
																</div>
															</div>
															<div class="wishes-message-composer">
																<label for="wishes-blessing-input">送出祝福 · 自动演示</label>
																<input id="wishes-blessing-input" data-wishes-input type="text" readonly tabindex="-1" placeholder="正在输入祝福…" aria-label="Simulated blessing" />
																<div class="wishes-composer-footer">
																	<span data-wishes-preview>正在准备祝福…</span>
																	<button type="button" class="wishes-send-button" data-wishes-send disabled aria-disabled="true">发送祝福 <span aria-hidden="true">↑</span></button>
																</div>
																<span class="wishes-send-status" data-wishes-status role="status">准备中</span>
															</div>
															<figcaption class="wishes-slide-label">02 · CARD / BLESSING</figcaption>
														</figure>
													</div>
												</div>
												<div class="wishes-carousel-controls">
													<button type="button" class="wishes-carousel-arrow" data-wishes-prev aria-label="Show previous Wishes preview">←</button>
													<div class="wishes-carousel-dots" role="tablist" aria-label="Wishes previews">
														<button type="button" class="wishes-carousel-dot active" data-wishes-dot="0" role="tab" aria-selected="true" aria-label="Show ink replay"></button>
														<button type="button" class="wishes-carousel-dot" data-wishes-dot="1" role="tab" aria-selected="false" aria-label="Show blessing card"></button>
													</div>
													<button type="button" class="wishes-carousel-arrow" data-wishes-next aria-label="Show next Wishes preview">→</button>
												</div>
											</div>
											<span class="media-stamp">PRODUCT // iOS</span>
										</div>
									</div>
									<div class="plate-story">
										<span class="plate-kicker">LOW-LATENCY INK ENGINE</span>
										<h3>亲笔小卡 · Wishes by Hand</h3>
										<p class="plate-p">
											Turn handwriting practice into a card worth sending.
										</p>
										<ul class="plate-highlights">
											<li>Finger or Apple Pencil → finished card</li>
											<li>Low-latency Metal ink</li>
											<li>On-device calligraphy scoring</li>
										</ul>
										<div class="plate-cta">
											<a href={WISHES_APP_STORE_URL} target="_blank" rel="noopener" class="btn-apaper">App Store ↗</a>
											<a href="/yong" class="btn-apaper btn-apaper-ghost">Full Story →</a>
										</div>
										<div class="plate-tags">
											<span>SwiftUI</span>
											<span>Apple Pencil</span>
											<span>Metal Ink</span>
											<span>Human Interface</span>
										</div>
									</div>
								</div>
							</div>
						</article>

						<!-- Chapter 03: wtcraft -->
						<article class="editorial-node" id="wtcraft-sig">
							<div class="node-rail" aria-hidden="true">
								<div class="node-marker">
									<span class="node-num">03</span>
									<span class="node-dot"></span>
								</div>
								<span class="node-line-seg"></span>
							</div>
							<div class="node-content">
								<div class="node-header">
									<span class="node-badge">CHAPTER // 03</span>
									<span class="node-date">OPEN SOURCE · INFRASTRUCTURE</span>
								</div>
								<div class="node-plate">
									<div class="plate-media">
										<div class="terminal-card" aria-hidden="true">
											<div class="terminal-titlebar">
												<span></span><span></span><span></span>
												<div class="terminal-title">wtcraft — git task contract</div>
											</div>
											<pre class="terminal-body"><code><span class="t-prompt">$</span> wtcraft init
<span class="t-prompt">$</span> wtcraft check
<span class="t-ok">✓</span> scope respected
<span class="t-ok">✓</span> off-limits clear
<span class="t-prompt">$</span> wtcraft verify
<span class="t-ok">✓</span> deterministic tests passed</code></pre>
										</div>
									</div>
									<div class="plate-story">
										<span class="plate-kicker">AGENTIC TASK SCAFFOLDING</span>
										<h3>wtcraft</h3>
										<p class="plate-p">
											Keep multi-agent work inside explicit, verifiable boundaries.
										</p>
										<ul class="plate-highlights">
											<li>Task contract per Git worktree</li>
											<li>Diffs checked against declared scope</li>
											<li>Deterministic verification</li>
										</ul>
										<div class="plate-cta">
											<a href={WTCRAFT_URL} target="_blank" rel="noopener" class="btn-apaper">GitHub ↗</a>
											<a href="/wtcraft" class="btn-apaper btn-apaper-ghost">Full Page →</a>
										</div>
										<div class="plate-tags">
											<span>CLI Tooling</span>
											<span>Multi-Agent</span>
											<span>Git Worktrees</span>
											<span>Verification</span>
										</div>
									</div>
								</div>
							</div>
						</article>

						<!-- Chapter 04: EDF Viewer -->
						<article class="editorial-node" id="edfviewer-sig">
							<div class="node-rail" aria-hidden="true">
								<div class="node-marker">
									<span class="node-num">04</span>
									<span class="node-dot"></span>
								</div>
								<span class="node-line-seg"></span>
							</div>
							<div class="node-content">
								<div class="node-header">
									<span class="node-badge">CHAPTER // 04</span>
									<span class="node-date">MACOS &amp; IPADOS · RESEARCH TOOL</span>
								</div>
								<div class="node-plate plate-reverse">
									<div class="plate-media">
										<div class="media-frame">
											<ViewportVideo
												src="/videos/edf-viewer-demo.mp4"
												poster="/images/edfviewer/hero-preview.webp"
												class="sig-frame"
												ariaLabel="ARC EDF and BDF Viewer on macOS showing an all-channels montage and waveform scrolling"
											/>
											<span class="media-stamp">DESKTOP // NATIVE</span>
										</div>
									</div>
									<div class="plate-story">
										<span class="plate-kicker">ZERO-DEPENDENCY BIOSIGNALS</span>
										<h3>EDF &amp; BDF Viewer</h3>
										<p class="plate-p">
											Read dense biosignal recordings without sending them anywhere.
										</p>
										<ul class="plate-highlights">
											<li>EDF/BDF · EEG, ECG, and sleep research</li>
											<li>Native multichannel waveform scrubbing</li>
											<li>Private and local-only</li>
										</ul>
										<div class="plate-cta">
											<a href={EDF_APP_STORE_URL} target="_blank" rel="noopener" class="btn-apaper">Mac App Store ↗</a>
											<a href="/edfviewer" class="btn-apaper btn-apaper-ghost">Full Page →</a>
										</div>
										<div class="plate-tags">
											<span>SwiftUI Native</span>
											<span>macOS / iPadOS</span>
											<span>Biosignal EDF/BDF</span>
											<span>Local-First</span>
										</div>
									</div>
								</div>
							</div>
						</article>

						<!-- Chapter 05: The Seven Bridges Inflection Point (七桥之思) -->
						<article class="editorial-node node-pivot" id="seven-bridges">
							<div class="node-rail" aria-hidden="true">
