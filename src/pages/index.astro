		<Footer />

		<script>
			// Interactive Hero Stage Deck (Layered depth shift carousel)
			const initHeroStage = () => {
				const stage = document.getElementById('hero-stage');
				if (!stage) return;

				const cards = Array.from(stage.querySelectorAll('.stage-card'));
				const pills = Array.from(stage.querySelectorAll('.stage-pill'));
				const prevBtn = document.getElementById('stage-prev-btn');
				const nextBtn = document.getElementById('stage-next-btn');
				const activeLabel = document.getElementById('stage-active-label');
				let currentIndex = 0;
				let isTransitioning = false;
				let timer = null;

				const updateCards = (nextIndex) => {
					if (isTransitioning && nextIndex === currentIndex) return;
					isTransitioning = true;
					currentIndex = (nextIndex + cards.length) % cards.length;
					const prevIndex = (currentIndex - 1 + cards.length) % cards.length;
					const nextIdx = (currentIndex + 1) % cards.length;

					cards.forEach((card, idx) => {
						const video = card.querySelector('video');
						card.classList.remove('is-center', 'is-prev', 'is-next', 'is-hidden');

						if (idx === currentIndex) {
							card.classList.add('is-center');
							if (video) {
								video.dispatchEvent(new CustomEvent('viewport-video:set-active', {
									bubbles: true,
									detail: { active: true },
								}));
							}
							if (activeLabel) {
								activeLabel.textContent = card.getAttribute('data-label') || '';
							}
						} else if (idx === prevIndex) {
							card.classList.add('is-prev');
							if (video) {
								video.dispatchEvent(new CustomEvent('viewport-video:set-active', {
									bubbles: true,
									detail: { active: false },
								}));
							}
						} else if (idx === nextIdx) {
							card.classList.add('is-next');
							if (video) {
								video.dispatchEvent(new CustomEvent('viewport-video:set-active', {
									bubbles: true,
									detail: { active: false },
								}));
							}
						} else {
							card.classList.add('is-hidden');
							if (video) {
								video.dispatchEvent(new CustomEvent('viewport-video:set-active', {
									bubbles: true,
									detail: { active: false },
								}));
							}
						}
					});

					pills.forEach((pill, idx) => {
						pill.classList.toggle('active', idx === currentIndex);
						pill.setAttribute('aria-selected', idx === currentIndex ? 'true' : 'false');
					});

					clearTimeout(timer);
					// Auto shift timer fallback (10s)
					timer = setTimeout(() => {
						updateCards(currentIndex + 1);
					}, 10000);

					setTimeout(() => {
						isTransitioning = false;
					}, 450);
				};

				// Listen for 'ended' event on each card's video for automatic shift
				cards.forEach((card) => {
					const video = card.querySelector('video');
					if (video) {
						video.addEventListener('ended', () => {
							if (card.classList.contains('is-center')) {
								updateCards(currentIndex + 1);
							}
						});
					}

					// Clicking left card or right card directly shifts
					card.addEventListener('click', (e) => {
						if (e.target && e.target.closest && e.target.closest('.stage-card-link')) return;

						if (card.classList.contains('is-prev')) {
							e.preventDefault();
							updateCards(currentIndex - 1);
						} else if (card.classList.contains('is-next')) {
							e.preventDefault();
							updateCards(currentIndex + 1);
						}
					});
				});

				// Prev and Next arrow buttons
				if (prevBtn) {
					prevBtn.addEventListener('click', () => {
						updateCards(currentIndex - 1);
					});
				}
				if (nextBtn) {
					nextBtn.addEventListener('click', () => {
						updateCards(currentIndex + 1);
					});
				}

				// Indicator pills
				pills.forEach((pill, idx) => {
					pill.addEventListener('click', () => {
						updateCards(idx);
					});
				});

				// Start with card 0
				updateCards(0);
			};

			initHeroStage();
			document.addEventListener('astro:after-swap', initHeroStage);

			// Chapter 01 Native Video Volume & Playback Setup
			const initChapterVideo = () => {
				const video = document.querySelector('.chapter-native-video');
				if (!video) return;
				// Set comfortable initial volume (40%) to ensure smooth, pleasant audio
				video.volume = 0.4;
			};

			initChapterVideo();
			document.addEventListener('astro:after-swap', initChapterVideo);

			// Chapter 02: full-frame Wishes demo and blessing-card carousel
			let clearWishesCarousel = () => {};
			const initWishesCarousel = () => {
				clearWishesCarousel();
				const carousel = document.querySelector('[data-wishes-carousel]');
				if (!carousel) return;

				const track = carousel.querySelector('.wishes-carousel-track');
				const slides = Array.from(carousel.querySelectorAll('[data-wishes-slide]'));
				const dots = Array.from(carousel.querySelectorAll('[data-wishes-dot]'));
				const prev = carousel.querySelector('[data-wishes-prev]');
				const next = carousel.querySelector('[data-wishes-next]');
				const input = carousel.querySelector<HTMLInputElement>('[data-wishes-input]');
				const preview = carousel.querySelector<HTMLSpanElement>('[data-wishes-preview]');
				const status = carousel.querySelector<HTMLSpanElement>('[data-wishes-status]');
				const sendButton = carousel.querySelector<HTMLButtonElement>('[data-wishes-send]');
				const composer = carousel.querySelector<HTMLElement>('.wishes-message-composer');
				const notification = carousel.querySelector<HTMLElement>('[data-wishes-notification]');
				const video = carousel.querySelector<HTMLVideoElement>('.wishes-demo-video');
				if (!track || slides.length < 2) return;

				let activeIndex = 0;
				let timer = null;
				let simulationTimers = [];
				const blessingText = '愿你健康快乐，幸福长伴！😘';
				const clearSimulation = () => {
					simulationTimers.forEach((id) => window.clearTimeout(id));
					simulationTimers = [];
					input && (input.value = '');
					if (preview) preview.textContent = '正在准备祝福…';
					if (status) status.textContent = '准备中';
					composer?.classList.remove('is-sent');
					sendButton?.classList.remove('is-sending');
					notification?.classList.remove('is-visible');
				};
				const simulateSend = () => {
					if (status) status.textContent = '正在模拟发送…';
					sendButton?.classList.add('is-sending');
					simulationTimers.push(window.setTimeout(() => {
						composer?.classList.add('is-sent');
						sendButton?.classList.remove('is-sending');
						if (status) status.textContent = '已发送';
						notification?.classList.add('is-visible');
					}, 480));
				};
				const startBlessingSimulation = () => {
					clearSimulation();
					let characterIndex = 0;
					const typeNextCharacter = () => {
						if (activeIndex !== 1 || !input) return;
						input.value = blessingText.slice(0, characterIndex + 1);
						if (preview) preview.textContent = input.value;
						characterIndex += 1;
						if (characterIndex < blessingText.length) {
							simulationTimers.push(window.setTimeout(typeNextCharacter, 95));
						} else {
							simulationTimers.push(window.setTimeout(simulateSend, 600));
						}
					};
					simulationTimers.push(window.setTimeout(typeNextCharacter, 700));
				};
				const stopAutoShift = () => {
					if (timer) window.clearInterval(timer);
					timer = null;
				};
				const startAutoShift = () => {
					stopAutoShift();
					timer = window.setInterval(() => showSlide(activeIndex + 1), 7000);
				};
				const showSlide = (requestedIndex) => {
					activeIndex = (requestedIndex + slides.length) % slides.length;
					track.style.transform = `translateX(-${activeIndex * 50}%)`;
					slides.forEach((slide, index) => {
						slide.classList.toggle('is-active', index === activeIndex);
						slide.setAttribute('aria-hidden', index === activeIndex ? 'false' : 'true');
					});
					dots.forEach((dot, index) => {
						dot.classList.toggle('active', index === activeIndex);
						dot.setAttribute('aria-selected', index === activeIndex ? 'true' : 'false');
					});
					if (video) {
						video.dispatchEvent(new CustomEvent('viewport-video:set-active', {
							bubbles: true,
							detail: { active: activeIndex === 0 },
						}));
					}
					if (activeIndex === 1) startBlessingSimulation();
					else clearSimulation();
				};

				prev?.addEventListener('click', () => {
					showSlide(activeIndex - 1);
					startAutoShift();
				});
				next?.addEventListener('click', () => {
					showSlide(activeIndex + 1);
					startAutoShift();
				});
				dots.forEach((dot, index) => dot.addEventListener('click', () => {
					showSlide(index);
					startAutoShift();
				}));
				carousel.addEventListener('mouseenter', stopAutoShift);
				carousel.addEventListener('mouseleave', startAutoShift);

				showSlide(0);
				startAutoShift();
				clearWishesCarousel = () => {
					stopAutoShift();
					clearSimulation();
				};
			};

			initWishesCarousel();
			document.addEventListener('astro:after-swap', initWishesCarousel);

			// Site theme switcher with cross-page persistence.
			const initPaperTheme = () => {
				try {
					const savedTheme = localStorage.getItem('site-paper-theme') === 'operator' ? 'operator' : 'carbon';
					document.documentElement.setAttribute('data-paper-theme', savedTheme);
					document.querySelectorAll('.theme-pill').forEach((btn) => {
						btn.classList.toggle('active', btn.getAttribute('data-theme') === savedTheme);
					});
				} catch (_) {}

				document.querySelectorAll('.theme-pill').forEach((btn) => {
					btn.addEventListener('click', () => {
						const theme = btn.getAttribute('data-theme');
						if (!theme) return;
						document.documentElement.setAttribute('data-paper-theme', theme);
						try {
							localStorage.setItem('site-paper-theme', theme);
						} catch (_) {}
						document.querySelectorAll('.theme-pill').forEach((b) => b.classList.remove('active'));
						btn.classList.add('active');
					});
				});
			};

			initPaperTheme();
			document.addEventListener('astro:after-swap', initPaperTheme);

			// Progressive Euler Bridges -> Skills Dispersal Flow Controller
			const initEulerFlow = () => {
				const stage = document.getElementById('pivot-stage');
				const scrim = stage?.querySelector('.stage-journey-scrim');
				const path = document.getElementById('euler-active-path');
				const runner = document.getElementById('euler-runner');
				const milestoneGroups = Array.from(document.querySelectorAll('.milestone-pin-group'));
				const callouts = Array.from(document.querySelectorAll('.milestone-callout'));
				const fork = document.getElementById('topological-fork');
				const connector = document.getElementById('fork-stem-connector');
				const banner = document.getElementById('fork-banner');
				const trunks = Array.from(document.querySelectorAll('.fork-trunk'));
				const junctions = Array.from(document.querySelectorAll('.fork-junction'));
				const forkBranches = Array.from(document.querySelectorAll('.fork-branch'));
				const cards = Array.from(document.querySelectorAll('#specs-grid .spec-card'));
				const exitPin = stage?.querySelector('.canvas-exit-pin');

				if (!stage || !path) return;

				let isRunning = false;
				let animFrameId = null;
				let timers = [];
				const clearAllTimers = () => {
					timers.forEach((t) => clearTimeout(t));
					timers = [];
				};

				let pathLength = 0;
				try {
					pathLength = path.getTotalLength();
					path.style.strokeDasharray = `${pathLength}`;
					path.style.strokeDashoffset = `${pathLength}`;
				} catch (_) {
					pathLength = 1500;
				}

				// Initialize fork branches stroke dasharray
				forkBranches.forEach((branch) => {
					try {
						const len = branch.getTotalLength();
						branch.style.strokeDasharray = `${len}`;
						branch.style.strokeDashoffset = `${len}`;
					} catch (_) {}
				});

				const startEulerAnimation = () => {
					if (isRunning) return;
					isRunning = true;

					if (animFrameId) cancelAnimationFrame(animFrameId);
					clearAllTimers();

					// Reset visual states cleanly
					if (scrim) scrim.classList.remove('is-active');
					if (exitPin) exitPin.classList.remove('is-passed');
					milestoneGroups.forEach((g) => g.classList.remove('is-passed'));
					callouts.forEach((c) => c.classList.remove('is-active'));

					// Reset downward topology cascade
					if (connector) connector.classList.remove('is-drawn');
					if (banner) banner.classList.remove('is-shown');
					trunks.forEach((t) => {
						t.style.transition = 'none';
						t.style.strokeDashoffset = '24';
					});
					junctions.forEach((j) => j.classList.remove('is-lit'));
					if (fork) fork.classList.remove('is-active');
					forkBranches.forEach((branch) => {
						branch.style.transition = 'none';
						try {
							branch.style.strokeDashoffset = `${branch.getTotalLength()}`;
						} catch (_) {}
					});
					cards.forEach((c) => c.classList.remove('is-revealed'));

					if (runner) {
						runner.style.opacity = '1';
						runner.setAttribute('cx', '-20');
						runner.setAttribute('cy', '-20');
					}

					path.style.transition = 'none';
					path.style.strokeDashoffset = `${pathLength}`;
					void path.offsetWidth; // Force DOM reflow

					// Reduced motion check
					if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
						path.style.strokeDashoffset = '0';
						milestoneGroups.forEach((g) => g.classList.add('is-passed'));
						callouts.forEach((c) => c.classList.add('is-active'));
						if (scrim) scrim.classList.add('is-active');
						if (exitPin) exitPin.classList.add('is-passed');
						if (connector) connector.classList.add('is-drawn');
						if (banner) banner.classList.add('is-shown');
						trunks.forEach((t) => (t.style.strokeDashoffset = '0'));
						junctions.forEach((j) => j.classList.add('is-lit'));
						forkBranches.forEach((b) => (b.style.strokeDashoffset = '0'));
						cards.forEach((c) => c.classList.add('is-revealed'));
						isRunning = false;
						return;
					}

					// Animate the full Seven Bridges sequence at 1.5x its previous pace.
					const duration = 4400;
					const startTime = performance.now();

					const step = (currentTime) => {
						const elapsed = currentTime - startTime;
						const progress = Math.min(elapsed / duration, 1);
						// Keep the traversal at a constant pace; easing made the final bridge drag.
						const currentOffset = pathLength * (1 - progress);
						path.style.strokeDashoffset = `${currentOffset}`;

						// Move runner bead along path
						let rx = -20;
						let ry = -20;
						if (runner && typeof path.getPointAtLength === 'function') {
							try {
								const pt = path.getPointAtLength(pathLength * progress);
								rx = pt.x;
								ry = pt.y;
								runner.setAttribute('cx', `${rx}`);
								runner.setAttribute('cy', `${ry}`);
							} catch (_) {}
						}

						// Illuminate 4 milestone dots and reveal callouts as runner passes near their coordinates
						milestoneGroups.forEach((group, idx) => {
							const dot = group.querySelector('.milestone-dot');
							if (!dot) return;
							const bx = parseFloat(dot.getAttribute('cx') || '0');
							const by = parseFloat(dot.getAttribute('cy') || '0');
							const distSq = (bx - rx) * (bx - rx) + (by - ry) * (by - ry);
							if (distSq < 38 * 38) {
								if (!group.classList.contains('is-passed')) {
									group.classList.add('is-passed');
									const callout = callouts[idx];
									if (callout) {
										callout.classList.add('is-active');
									}
								}
							}
						});

						if (progress < 1) {
							animFrameId = requestAnimationFrame(step);
						} else {
							// 1. 上面的 path 画完了 (All bridges traversed!)
							if (runner) runner.style.opacity = '0.4';
							milestoneGroups.forEach((g) => g.classList.add('is-passed'));
							callouts.forEach((c) => c.classList.add('is-active'));

							// Fade in the 70%-width scrim overlay across the map
							if (scrim) scrim.classList.add('is-active');

							// Activate bottom exit pin dot
							if (exitPin) exitPin.classList.add('is-passed');

							isRunning = false;

							// 2. 才 画下面竖 path (Vertical stem connector draws down from exit pin)
							timers.push(
								setTimeout(() => {
									if (connector) connector.classList.add('is-drawn');
								}, 267)
							);

							// 3. 然后 topology 出现 (Topology banner badge pops in smoothly)
							timers.push(
								setTimeout(() => {
									if (banner) banner.classList.add('is-shown');
								}, 600)
							);

							// 4. Trunk line drops through banner to junction
							timers.push(
								setTimeout(() => {
									trunks.forEach((t) => {
										t.style.transition = 'stroke-dashoffset 0.4s ease-out';
										t.style.strokeDashoffset = '0';
									});
									junctions.forEach((j) => j.classList.add('is-lit'));
								}, 900)
							);

							// 5. 然后才散开 4 个 (4 branches spread outward)
							timers.push(
								setTimeout(() => {
									if (fork) fork.classList.add('is-active');
									forkBranches.forEach((branch, idx) => {
										timers.push(
											setTimeout(() => {
												branch.style.transition = 'stroke-dashoffset 1.3s cubic-bezier(0.22, 1, 0.36, 1)';
												branch.style.strokeDashoffset = '0';
											}, idx * 100)
										);
									});
								}, 1133)
							);

							// 6. 4 Systematic Competency Spec Cards reveal progressively
							timers.push(
								setTimeout(() => {
									cards.forEach((card, idx) => {
										timers.push(
											setTimeout(() => {
												card.classList.add('is-revealed');
											}, idx * 200)
										);
									});
								}, 1633)
							);
						}
					};

					animFrameId = requestAnimationFrame(step);
				};

				// Replay interaction: clicking anywhere in this area restarts the journey
				if (scrim) {
					scrim.addEventListener('click', (e) => {
						e.stopPropagation();
						startEulerAnimation();
					});
				}

				// IntersectionObserver to start as user scrolls near Chapter 05
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								startEulerAnimation();
								observer.disconnect();
							}
						});
					},
					{ threshold: 0.15, rootMargin: '0px 0px -50px 0px' }
				);

				observer.observe(stage);
			};

			initEulerFlow();
			document.addEventListener('astro:after-swap', initEulerFlow);
		</script>
