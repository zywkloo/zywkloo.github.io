	}

	/* Preset 2: 古籍琥珀 · Antique Parchment & Amber */
	[data-paper-theme="amber"] {
		--apaper-bg: #f5f0e6;
		--apaper-bg-alt: #ebe3d3;
		--apaper-card: #faf7f0;
		--apaper-header-bg: rgba(245, 240, 230, 0.88);
		--apaper-ink: #26221c;
		--apaper-ink-secondary: #4d4439;
		--apaper-muted: #7d7263;
		--apaper-line: #dbcebb;
		--apaper-line-light: #e8ded0;
		--apaper-accent: #b86d29;
		--apaper-accent-soft: rgba(184, 109, 41, 0.09);
		--apaper-accent-line: rgba(184, 109, 41, 0.28);
		--apaper-btn-text: #ffffff;
		--apaper-tag-bg: rgba(38, 34, 28, 0.04);
	}

	/* Preset 3: 学术蓝图 · Blueprint & Slate */
	[data-paper-theme="blueprint"] {
		--apaper-bg: #f6f8fa;
		--apaper-bg-alt: #ecf1f6;
		--apaper-card: #ffffff;
		--apaper-header-bg: rgba(246, 248, 250, 0.88);
		--apaper-ink: #1e2530;
		--apaper-ink-secondary: #3e4a5b;
		--apaper-muted: #64748b;
		--apaper-line: #cbd5e1;
		--apaper-line-light: #e2e8f0;
		--apaper-accent: #2563eb;
		--apaper-accent-soft: rgba(37, 99, 235, 0.08);
		--apaper-accent-line: rgba(37, 99, 235, 0.25);
		--apaper-btn-text: #ffffff;
		--apaper-tag-bg: rgba(30, 37, 48, 0.04);
	}

	/* Preset 4: 竹简青素 · Bamboo & Celadon */
	[data-paper-theme="bamboo"] {
		--apaper-bg: #f3f6f3;
		--apaper-bg-alt: #e6ede6;
		--apaper-card: #fafcfa;
		--apaper-header-bg: rgba(243, 246, 243, 0.88);
		--apaper-ink: #1f2623;
		--apaper-ink-secondary: #3f4a44;
		--apaper-muted: #68776f;
		--apaper-line: #c8d3cc;
		--apaper-line-light: #dbe3de;
		--apaper-accent: #2d6a4f;
		--apaper-accent-soft: rgba(45, 106, 79, 0.08);
		--apaper-accent-line: rgba(45, 106, 79, 0.25);
		--apaper-btn-text: #ffffff;
		--apaper-tag-bg: rgba(31, 38, 35, 0.04);
	}

	/* Preset 5: 玄纸泥金 · Carbon Washi & Gold (暗调奢雅纸本 · 解决所有看不清的对比度优化) */
	[data-paper-theme="carbon"] {
		--apaper-bg: #141617;
		--apaper-bg-alt: #1a1c1e;
		--apaper-card: #202325;
		--apaper-header-bg: rgba(20, 22, 23, 0.92);
		--apaper-ink: #f5f2eb;             /* 纯粹温润米白，用于大标题、卡片主标题，字字清晰锐利 */
		--apaper-ink-secondary: #ded9cf;   /* 高对比度暖调亮宣纸白，正文说明、描述、引用清晰通透 */
		--apaper-muted: #aba496;           /* 典雅暖沙金，元数据、钢印、副标清晰可读不再灰暗 */
		--apaper-line: #383c3e;            /* 规整纤细发丝线 */
		--apaper-line-light: #282c2e;
		--apaper-accent: #e5b382;          /* 澄澈暖泥金，高光点缀与核心呼出 */
		--apaper-accent-soft: rgba(229, 179, 130, 0.16);
		--apaper-accent-line: rgba(229, 179, 130, 0.38);
		--apaper-btn-text: #121415;        /* 金色或米白主按钮上的深墨黑字，对比度 10:1+ 极度清晰 */
		--apaper-tag-bg: rgba(255, 255, 255, 0.07); /* 标签半透发光底色，消除黑底黑字 */
	}

	:global(body) {
		background: var(--apaper-bg);
		color: var(--apaper-ink);
		transition: background-color 0.3s ease, color 0.3s ease;
	}

	.homepage {
		width: 100%;
		max-width: 100%;
		padding: 0;
		background: var(--apaper-bg);
		color: var(--apaper-ink);
	}

	/* General apaper buttons */
	.btn-apaper {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 7px 16px;
		border-radius: 999px;
		background: var(--apaper-ink);
		color: var(--apaper-btn-text, #ffffff);
		font-family: var(--apaper-font-mono);
		font-size: 11px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-decoration: none;
		border: 1px solid var(--apaper-ink);
		transition: background 0.2s ease, transform 0.2s ease, border-color 0.2s ease, color 0.2s ease;
	}
	.btn-apaper:hover {
		background: var(--apaper-accent);
		border-color: var(--apaper-accent);
		color: var(--apaper-btn-text, #ffffff);
		transform: translateY(-1px);
	}
	.btn-apaper-primary {
		background: var(--apaper-accent);
		border-color: var(--apaper-accent);
		color: var(--apaper-btn-text, #ffffff);
		font-weight: 600;
	}
	.btn-apaper-primary:hover {
		background: var(--apaper-ink);
		border-color: var(--apaper-ink);
		color: var(--apaper-btn-text, #ffffff);
	}
	.btn-apaper-ghost {
		background: transparent;
		color: var(--apaper-ink);
		border-color: var(--apaper-line);
	}
	.btn-apaper-ghost:hover {
		background: var(--apaper-accent-soft);
		border-color: var(--apaper-accent);
		color: var(--apaper-accent);
	}

	/* Hero — Editorial Abstract & Genesis Node */
	.hero {
		position: relative;
		padding: clamp(4.5rem, 8vw, 7rem) 1.5rem clamp(4rem, 7vw, 6rem);
		background: var(--apaper-bg);
		border-bottom: 1px solid var(--apaper-line);
	}
	.hero-inner {
		display: grid;
		grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.92fr);
		align-items: center;
		gap: clamp(3rem, 6vw, 5.5rem);
		max-width: 1180px;
		margin: 0 auto;
	}
	.hero-copy {
		position: relative;
		z-index: 2;
	}
	.hero-kicker-wrap {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 1.6rem;
	}
	.hero-kicker-glyph {
		width: 26px;
		height: 26px;
		border: 1px solid var(--apaper-ink);
		border-radius: 8px;
		display: grid;
		place-items: center;
		font-family: var(--apaper-font-serif);
		font-size: 13px;
		font-weight: 600;
		color: var(--apaper-ink);
		background: var(--apaper-card);
	}
	.hero-kicker {
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--apaper-accent);
		font-weight: 700;
	}
	.hero h1 {
		font-family: var(--apaper-font-serif);
		max-width: 720px;
		margin: 0 0 1.4rem;
		font-size: clamp(2.8rem, 4.8vw, 4.4rem);
		letter-spacing: -0.03em;
		line-height: 1.08;
		font-weight: 600;
		color: var(--apaper-ink);
	}
	.hero-description {
		font-family: var(--apaper-font-serif);
		max-width: 600px;
		margin: 0 0 2.2rem;
		font-size: clamp(1.05rem, 1.4vw, 1.18rem);
		line-height: 1.75;
		color: var(--apaper-ink-secondary);
	}
	.hero-cta {
		display: flex;
		align-items: center;
		gap: 12px;
		flex-wrap: wrap;
		margin-bottom: 1.8rem;
	}
	.hero-credibility {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--apaper-muted);
		font-weight: 600;
	}
	.cred-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--apaper-accent);
	}
	/* Hero Visual Stage — Layered Depth Cards */
	.hero-visual {
		position: relative;
		justify-self: center;
		width: min(100%, 460px);
	}
	.stage-container {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.stage-meta-strip {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		letter-spacing: 0.12em;
		padding: 0 4px;
	}
	.stage-title-wrap {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--apaper-accent);
		font-weight: 700;
		text-transform: uppercase;
	}
	.stage-pulse {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--apaper-accent);
		box-shadow: 0 0 0 3px var(--apaper-accent-soft);
		animation: pulse-glow 2.2s infinite ease-in-out;
	}
	@keyframes pulse-glow {
		0%, 100% { transform: scale(1); opacity: 1; }
		50% { transform: scale(1.3); opacity: 0.6; }
	}
	.stage-shift-btn {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding: 3px 9px;
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		border-radius: 999px;
		color: var(--apaper-ink-secondary);
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		cursor: pointer;
		transition: border-color 0.2s ease, transform 0.2s ease, background 0.2s ease, color 0.2s ease;
	}
	.stage-shift-btn:hover {
		border-color: var(--apaper-accent);
		color: var(--apaper-accent);
		transform: translateY(-1px);
	}

	/* Hero Visual Stage — 3D Left-Center-Right Cover Flow */
	.hero-visual {
		position: relative;
		justify-self: center;
		width: 100%;
		max-width: 530px;
	}
	.stage-container {
		display: flex;
		flex-direction: column;
		gap: 12px;
		width: 100%;
	}
	.stage-meta-strip {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		letter-spacing: 0.12em;
		padding: 0 6px;
	}
	.stage-title-wrap {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--apaper-accent);
		font-weight: 700;
		text-transform: uppercase;
	}
	.stage-pulse {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--apaper-accent);
		box-shadow: 0 0 0 3px var(--apaper-accent-soft);
		animation: pulse-glow 2.2s infinite ease-in-out;
	}
	.stage-nav-cluster {
		display: inline-flex;
		align-items: center;
		gap: 5px;
	}
	.stage-arrow-btn {
		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		display: grid;
		place-items: center;
		color: var(--apaper-ink-secondary);
		font-family: var(--apaper-font-mono);
		font-size: 14px;
		line-height: 1;
		cursor: pointer;
		transition: border-color 0.2s, background 0.2s, color 0.2s, transform 0.2s;
	}
	.stage-arrow-btn:hover {
		border-color: var(--apaper-accent);
		color: var(--apaper-accent);
		transform: scale(1.08);
	}

	/* The 3D Cover Flow Deck */
	.stage-deck {
		position: relative;
		width: 100%;
		height: 350px;
		perspective: 1200px;
		overflow: visible;
	}
	.stage-card {
		position: absolute;
		top: 6px;
		bottom: 6px;
		left: 11%;
		right: 11%;
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		border-radius: 18px;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		box-shadow: 0 10px 30px rgba(32, 34, 33, 0.08);
		transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
		            opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
		            box-shadow 0.6s ease,
		            filter 0.6s ease,
		            border-color 0.3s ease;
		will-change: transform, opacity;
	}

	/* Center Focused Card */
	.stage-card.is-center {
		z-index: 5;
		transform: translate3d(0, 0, 0) scale(1);
		opacity: 1;
		pointer-events: auto;
		box-shadow: 0 20px 48px rgba(32, 34, 33, 0.16);
		filter: brightness(1);
	}

	/* Left Stack / Previous Card: Prominently peeking on the left */
	.stage-card.is-prev {
		z-index: 2;
		transform: translate3d(-88px, 12px, -70px) scale(0.88) rotateY(6deg);
		opacity: 0.78;
		pointer-events: auto;
		cursor: pointer;
		box-shadow: -10px 12px 28px rgba(32, 34, 33, 0.12);
		filter: brightness(0.96);
	}
	.stage-card.is-prev:hover {
		opacity: 0.96;
		border-color: var(--apaper-accent);
		transform: translate3d(-96px, 8px, -45px) scale(0.9) rotateY(3deg);
	}

	/* Right Stack / Next Card: Prominently peeking on the right */
	.stage-card.is-next {
		z-index: 2;
		transform: translate3d(88px, 12px, -70px) scale(0.88) rotateY(-6deg);
		opacity: 0.78;
		pointer-events: auto;
		cursor: pointer;
		box-shadow: 10px 12px 28px rgba(32, 34, 33, 0.12);
		filter: brightness(0.96);
	}
	.stage-card.is-next:hover {
		opacity: 0.96;
		border-color: var(--apaper-accent);
		transform: translate3d(96px, 8px, -45px) scale(0.9) rotateY(-3deg);
	}

	/* Hidden Cards in Queue */
	.stage-card.is-hidden {
		z-index: 0;
		transform: translate3d(0, 24px, -140px) scale(0.76);
		opacity: 0;
		pointer-events: none;
	}

	/* Card Screen Container */
	.card-screen {
		position: relative;
		flex: 1;
		width: 100%;
		overflow: hidden;
		background: #000;
	}
	.card-screen-yong {
		background: #fdfbf7;
	}
	.card-screen-edf {
		background: #0d1117;
	}
	.card-screen-terminal {
		background: #090a0f;
	}
	.card-screen-arcade {
		background: #111417;
	}
	.stage-video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.card-screen-yong .stage-video {
		object-fit: contain;
	}

	/* Screen Stamp Badges */
	.screen-badge {
		position: absolute;
		top: 12px;
		left: 12px;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 4px 10px;
		background: rgba(248, 246, 240, 0.92);
		backdrop-filter: blur(8px);
		border: 1px solid var(--apaper-line);
		border-radius: 999px;
		font-family: var(--apaper-font-mono);
		font-size: 8.5px;
		letter-spacing: 0.08em;
		color: var(--apaper-ink);
		font-weight: 600;
		z-index: 2;
	}
	.badge-dot {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--apaper-accent);
	}
	.badge-edf {
		background: rgba(13, 17, 23, 0.88);
		border-color: rgba(56, 189, 248, 0.25);
		color: #38bdf8;
	}
	.dot-edf {
		background: #38bdf8;
	}
	.badge-terminal {
		background: rgba(14, 17, 22, 0.88);
		border-color: rgba(255, 255, 255, 0.15);
		color: #4ade80;
	}
	.dot-terminal {
		background: #4ade80;
	}
	.badge-arcade {
		background: rgba(18, 20, 24, 0.88);
		border-color: rgba(255, 255, 255, 0.15);
		color: #f59e0b;
	}
	.dot-arcade {
		background: #f59e0b;
	}

	/* Card Caption Bar */
	.card-caption-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px;
		padding: 12px 16px;
		background: var(--apaper-card);
		border-top: 1px solid var(--apaper-line);
	}
	.caption-copy {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}
	.caption-copy strong {
		font-family: var(--apaper-font-serif);
		font-size: 0.98rem;
		font-weight: 600;
		color: var(--apaper-ink);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.caption-copy span {
		font-family: var(--apaper-font-mono);
		font-size: 0.72rem;
		color: var(--apaper-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.stage-card-link {
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--apaper-accent);
		text-decoration: none;
		font-weight: 700;
		padding: 4px 8px;
		border: 1px solid var(--apaper-accent-line);
		border-radius: 6px;
		white-space: nowrap;
		transition: background 0.2s ease, color 0.2s ease;
	}
	.stage-card-link:hover {
		background: var(--apaper-accent);
		color: #ffffff;
	}

	/* Stage Pagination Indicator Pills */
	.stage-pills {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		margin-top: 4px;
	}
	.stage-pill {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		padding: 4px 10px;
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		border-radius: 999px;
		color: var(--apaper-muted);
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		letter-spacing: 0.05em;
		cursor: pointer;
		transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
	}
	.stage-pill:hover {
		border-color: var(--apaper-accent);
		color: var(--apaper-ink);
	}
	.stage-pill.active {
		border-color: var(--apaper-ink);
		background: var(--apaper-ink);
		color: #ffffff;
	}
	.pill-dot {
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: var(--apaper-muted);
	}
	.stage-pill.active .pill-dot {
		background: var(--apaper-accent);
	}

	/* Chapter 01 Native Video Player */
	.chapter-video-wrap {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: 12px;
		background: #000;
		border: 1px solid var(--apaper-line);
		box-shadow: 0 6px 20px rgba(32, 34, 33, 0.08);
	}
	.chapter-native-video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	/* Chapter 01 Rank Card */
	.rank-card {
		margin: 16px 0 0;
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		border-radius: 12px;
		padding: 10px;
		box-shadow: 0 4px 14px rgba(32, 34, 33, 0.04);
	}
	.rank-card img {
		width: 100%;
		height: auto;
		border-radius: 8px;
		border: 1px solid var(--apaper-line);
		display: block;
	}
	.rank-card figcaption {
		font-family: var(--apaper-font-mono);
		font-size: 8.5px;
		letter-spacing: 0.04em;
		color: var(--apaper-muted);
		line-height: 1.5;
		margin-top: 8px;
		padding: 0 2px;
	}

	/* Proof — Archival Exhibit Plates */
	.proof {
		padding: clamp(4rem, 7vw, 6rem) 1.5rem;
		background: var(--apaper-bg);
	}
	.proof-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(14px, 2vw, 22px);
		max-width: 1180px;
		margin: 0 auto;
	}
	.proof-card {
		display: flex;
		flex-direction: column;
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		border-radius: 14px;
		overflow: hidden;
		color: inherit;
		text-decoration: none;
		transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
	}
	.proof-card:hover {
		border-color: var(--apaper-accent);
		transform: translateY(-3px);
		box-shadow: 0 10px 24px rgba(32, 34, 33, 0.06);
	}
	.proof-card-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 12px 16px;
		border-bottom: 1px solid var(--apaper-line);
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.proof-card-id {
		color: var(--apaper-accent);
		font-weight: 700;
	}
	.proof-card-scope {
		color: var(--apaper-muted);
	}
	.proof-media {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 200px;
		overflow: hidden;
		background: var(--apaper-bg-alt);
		border-bottom: 1px solid var(--apaper-line-light);
	}
	.proof-media img {
		display: block;
		width: 100%;
		height: 100%;
	}
	.proof-medal {
		background: #151515;
	}
	.proof-medal img {
		object-fit: cover;
		object-position: center;
	}
	.proof-rank {
		padding: 1.2rem;
	}
	.proof-rank img {
		height: auto;
		max-height: 100%;
		object-fit: contain;
		border-radius: 8px;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
	}
	.proof-devpost {
		background: #eef2f3;
	}
	.proof-devpost img {
		object-fit: cover;
		object-position: top center;
	}
	.proof-copy {
		display: grid;
		gap: 4px;
		padding: 14px 16px 18px;
	}
	.proof-copy strong {
		font-family: var(--apaper-font-serif);
		font-size: 1.08rem;
		font-weight: 600;
		color: var(--apaper-ink);
		line-height: 1.3;
	}
	.proof-copy span {
		font-family: var(--apaper-font-mono);
		color: var(--apaper-muted);
		font-size: 0.78rem;
		letter-spacing: 0.02em;
	}

	.signature {
		background: var(--apaper-bg);
		color: var(--apaper-ink);
		border-top: 1px solid var(--apaper-line);
		border-bottom: 1px solid var(--apaper-line);
		padding: clamp(5rem, 8vw, 7.5rem) 1.5rem clamp(6rem, 10vw, 9rem);
		position: relative;
		overflow-x: clip;
	}

	/* Section Lead Header */
	.sig-editorial-header {
		max-width: 1180px;
		margin: 0 auto clamp(3.5rem, 6vw, 5.5rem);
	}
	.sig-meta-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
		padding-bottom: 16px;
		border-bottom: 1px solid var(--apaper-line);
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--apaper-muted);
	}
	.sig-wordmark {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--apaper-ink);
		font-weight: 500;
	}
	.sig-mark-glyph {
		width: 26px;
		height: 26px;
		border: 1px solid var(--apaper-ink);
		border-radius: 8px;
		display: grid;
		place-items: center;
		font-family: var(--apaper-font-serif);
		font-size: 13px;
		color: var(--apaper-ink);
		background: #ffffff60;
	}
	.sig-timeframe {
		color: var(--apaper-muted);
	}
	.sig-status-tag {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		color: var(--apaper-accent);
		font-weight: 700;
	}
	.sig-pulse-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--apaper-accent);
		box-shadow: 0 0 0 3px var(--apaper-accent-soft);
	}
	.sig-eyebrow {
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.16em;
		color: var(--apaper-accent);
		text-transform: uppercase;
		margin: 26px 0 10px;
	}
	.sig-title-block h2 {
		font-family: var(--apaper-font-serif);
		font-size: clamp(2.4rem, 4.5vw, 3.4rem);
		font-weight: 500;
		letter-spacing: -0.04em;
		line-height: 1.05;
		color: var(--apaper-ink);
		margin: 0 0 18px;
	}
	.sig-lead-text {
		font-family: var(--apaper-font-serif);
		font-size: clamp(1.02rem, 1.5vw, 1.18rem);
		line-height: 1.8;
		color: var(--apaper-muted);
		max-width: 840px;
		border-left: 2px solid var(--apaper-accent);
		padding-left: 18px;
		margin: 0;
	}

	/* The Editorial Flow & Rail Spine */
	.editorial-flow {
		max-width: 1180px;
		margin: 0 auto;
		position: relative;
	}
	.editorial-milestones {
		display: flex;
		flex-direction: column;
		gap: clamp(4rem, 7vw, 6.5rem);
		position: relative;
	}

	/* Individual Milestone Node */
	.editorial-node {
		display: grid;
		grid-template-columns: 56px 1fr;
		gap: clamp(18px, 3.5vw, 42px);
		position: relative;
	}
	.node-rail {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.node-marker {
		position: sticky;
		top: 96px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		background: var(--apaper-bg);
		padding: 6px 0;
		z-index: 2;
	}
	.node-num {
		font-family: var(--apaper-font-mono);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--apaper-muted);
	}
	.node-dot {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		border: 1px solid var(--apaper-accent);
		background: var(--apaper-bg);
		box-shadow: 0 0 0 3px var(--apaper-accent-soft);
	}
	.node-line-seg {
		position: absolute;
		top: 36px;
		bottom: -7rem;
		width: 1px;
		background: linear-gradient(180deg, var(--apaper-accent), var(--apaper-line) 30%, var(--apaper-line));
		opacity: 0.65;
		z-index: 1;
	}

	.node-content {
		min-width: 0;
	}
	.node-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px;
		padding-bottom: 12px;
		margin-bottom: 16px;
		border-bottom: 1px solid var(--apaper-line);
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.node-badge {
		color: var(--apaper-accent);
		font-weight: 700;
	}
	.node-date {
		color: var(--apaper-muted);
	}

	/* Card Plate */
	.node-plate {
		display: grid;
		grid-template-columns: minmax(300px, 1fr) minmax(320px, 1.1fr);
		gap: clamp(24px, 3.5vw, 44px);
		align-items: start;
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		border-radius: 18px;
		padding: clamp(20px, 3vw, 36px);
		box-shadow: 0 10px 24px rgba(32, 34, 33, 0.04);
		transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
	}
	.node-plate:hover {
		border-color: rgba(196, 94, 73, 0.35);
		box-shadow: 0 16px 36px rgba(32, 34, 33, 0.07);
		transform: translateY(-2px);
	}
	.node-plate.plate-reverse {
		grid-template-columns: minmax(320px, 1.1fr) minmax(300px, 1fr);
	}
	.node-plate.plate-reverse .plate-media {
		order: 2;
	}
	.node-plate.plate-reverse .plate-story {
		order: 1;
	}

	.plate-media {
		min-width: 0;
	}
	.media-frame {
		position: relative;
		overflow: hidden;
		border-radius: 12px;
		border: 1px solid var(--apaper-line);
		background: #111;
	}
	.media-frame img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0;
	}
	.wishes-media-frame {
		background: #111;
	}
	.wishes-carousel {
		position: relative;
		padding-bottom: 36px;
	}
	.wishes-carousel-viewport {
		overflow: hidden;
		/* Keep both portrait demos whole, but in the same compact 16:9 media slot as the other chapters. */
		aspect-ratio: 16 / 9;
		background: #eee4d2;
	}
	.wishes-carousel-track {
		display: flex;
		width: 200%;
		height: 100%;
		transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
	}
	.wishes-slide {
		position: relative;
		flex: 0 0 50%;
		margin: 0;
		background: #eee4d2;
		overflow: hidden;
	}
	.wishes-media-frame .wishes-demo-video,
	.wishes-media-frame .wishes-blessing-preview {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center top;
		background: #eee4d2;
	}
	.wishes-card-slide {
		background: #f3ead7;
	}
	.wishes-sms-notification {
		position: absolute;
		top: 4%;
		left: 5%;
		right: 5%;
		z-index: 3;
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 8px 10px;
		border: 1px solid rgba(255, 255, 255, 0.78);
		border-radius: 12px;
		background: rgba(251, 251, 252, 0.88);
		box-shadow: 0 7px 20px rgba(36, 30, 24, 0.22);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		opacity: 0;
		transform: translateY(-12px) scale(0.96);
		transition: opacity 360ms ease, transform 480ms cubic-bezier(0.22, 1, 0.36, 1);
		pointer-events: none;
	}
	.wishes-sms-notification.is-visible {
		opacity: 1;
		transform: translateY(0) scale(1);
	}
	.wishes-notification-icon {
		display: grid;
		place-items: center;
		width: 23px;
		height: 23px;
		border-radius: 7px;
		background: #4f8cf7;
		color: #fff;
		font-size: 13px;
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.32);
	}
	.wishes-sms-notification div {
		min-width: 0;
		display: grid;
		grid-template-columns: 1fr auto;
		column-gap: 6px;
	}
	.wishes-notification-meta {
		grid-column: 1 / -1;
		font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", sans-serif;
		font-size: 7px;
		font-weight: 600;
		letter-spacing: 0.03em;
		color: #6d6d72;
	}
	.wishes-sms-notification strong {
		font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", sans-serif;
		font-size: 9px;
		font-weight: 700;
		color: #222225;
	}
	.wishes-sms-notification p {
		grid-column: 1 / -1;
		margin: 1px 0 0;
		font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", sans-serif;
		font-size: 8px;
		line-height: 1.25;
		color: #414146;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.wishes-slide-label {
		position: absolute;
		left: 12px;
		bottom: 12px;
		z-index: 2;
		padding: 4px 8px;
		border-radius: 4px;
		background: rgba(24, 26, 27, 0.78);
		color: #f8f5ef;
		font-family: var(--apaper-font-mono);
		font-size: 8px;
		font-style: normal;
		font-weight: 700;
		letter-spacing: 0.12em;
	}
	.wishes-message-composer {
		position: absolute;
		z-index: 2;
		/* Match the native input's position inside the contained 720 × 1599 phone capture. */
		/* The input itself—not the composer padding—sits on the captured field. */
		top: calc(52.22% - 18px);
		left: calc(39.15% - 5px);
		right: calc(37.55% - 5px);
		padding: 4px;
		background: rgba(255, 255, 255, 0.96);
		border: 1px solid rgba(80, 65, 51, 0.26);
		border-radius: 6px;
		box-shadow: 0 5px 18px rgba(42, 31, 21, 0.16);
	}
	.wishes-message-composer label {
		display: block;
		margin-bottom: 2px;
		font-family: var(--apaper-font-mono);
		font-size: 6.5px;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: #8d3a2e;
	}
	.wishes-message-composer input {
		display: block;
		box-sizing: border-box;
		width: 100%;
		border: 1px solid #d8d0c4;
		border-radius: 4px;
		padding: 3px 4px;
		background: #fff;
		color: #25211e;
		font-family: var(--apaper-font-serif);
		font-size: 8px;
		line-height: 1.25;
		outline: none;
	}
	.wishes-message-composer input:focus {
		border-color: #a4372c;
		box-shadow: 0 0 0 2px rgba(164, 55, 44, 0.12);
	}
	.wishes-composer-footer {
		display: flex;
		align-items: center;
		gap: 3px;
		margin-top: 3px;
	}
	.wishes-message-composer [data-wishes-preview] {
		min-width: 0;
		flex: 1;
		color: #7b6d60;
		font-family: var(--apaper-font-serif);
		font-size: 6.5px;
		line-height: 1.35;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.wishes-send-button {
		flex-shrink: 0;
		border: 0;
		border-radius: 4px;
		padding: 3px 4px;
		background: #a4372c;
		color: #fff;
		font-family: var(--apaper-font-mono);
		font-size: 6.5px;
		font-weight: 700;
		letter-spacing: 0.08em;
		cursor: pointer;
		transition: transform 160ms ease, background 160ms ease;
	}
	.wishes-send-button:hover,
	.wishes-send-button:focus-visible {
		background: #8d2e25;
		transform: translateY(-1px);
	}
	.wishes-send-button.is-sending {
		transform: scale(0.94);
		background: #6f261f;
	}
	.wishes-send-button:disabled {
		cursor: default;
		opacity: 1;
	}
	.wishes-send-status {
		display: block;
		margin-top: 2px;
		min-height: 1em;
		color: #9a4b40;
		font-family: var(--apaper-font-mono);
		font-size: 6px;
		font-weight: 700;
		letter-spacing: 0.08em;
	}
	.wishes-message-composer.is-sent .wishes-send-status {
		color: #31725b;
	}
	.wishes-carousel-controls {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
	}
	.wishes-carousel-arrow,
	.wishes-carousel-dot {
		appearance: none;
		border: 0;
		cursor: pointer;
	}
	.wishes-carousel-arrow {
		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: var(--apaper-tag-bg);
		color: var(--apaper-ink-secondary);
		font-size: 13px;
		line-height: 1;
	}
	.wishes-carousel-arrow:hover,
	.wishes-carousel-arrow:focus-visible {
		background: var(--apaper-accent);
		color: var(--apaper-btn-text);
	}
	.wishes-carousel-dots {
		display: flex;
		gap: 5px;
	}
	.wishes-carousel-dot {
		width: 6px;
		height: 6px;
		padding: 0;
		border-radius: 50%;
		background: var(--apaper-line);
		transition: width 200ms ease, background 200ms ease;
	}
	.wishes-carousel-dot.active {
		width: 16px;
		border-radius: 999px;
		background: var(--apaper-accent);
	}
	.media-stamp {
		position: absolute;
		top: 12px;
		right: 12px;
		z-index: 2;
		background: rgba(27, 33, 35, 0.85);
		color: #f8f5ef;
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		letter-spacing: 0.14em;
		padding: 4px 8px;
		border: 1px solid rgba(255, 255, 255, 0.25);
		border-radius: 4px;
		backdrop-filter: blur(8px);
	}

	.plate-story {
		min-width: 0;
	}
	.plate-kicker {
		display: inline-block;
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.14em;
		color: var(--apaper-accent);
		text-transform: uppercase;
		margin-bottom: 6px;
	}
	.plate-story h3 {
		font-family: var(--apaper-font-serif);
		font-size: clamp(1.45rem, 2.2vw, 1.85rem);
		font-weight: 500;
		letter-spacing: -0.025em;
		color: var(--apaper-ink);
		margin: 0 0 12px;
		line-height: 1.22;
	}
	.plate-p {
		font-family: var(--apaper-font-serif);
		font-size: 0.98rem;
		line-height: 1.8;
		color: var(--apaper-ink-secondary);
		margin: 0 0 14px;
	}
	.plate-p strong {
		color: var(--apaper-ink);
	}
	.plate-highlights {
		display: grid;
		gap: 8px;
		margin: 0 0 17px;
		padding: 0;
		list-style: none;
		font-family: var(--apaper-font-serif);
		font-size: clamp(0.9rem, 1.1vw, 1rem);
		line-height: 1.45;
		color: var(--apaper-ink-secondary);
	}
	.plate-highlights li {
		display: flex;
		align-items: flex-start;
		gap: 9px;
	}
	.plate-highlights li::before {
		content: "✓";
		display: grid;
		place-items: center;
		flex: 0 0 17px;
		width: 17px;
		height: 17px;
		margin-top: 0.15em;
		border: 1px solid var(--apaper-accent);
		border-radius: 50%;
		color: var(--apaper-accent);
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		font-weight: 700;
		line-height: 1;
	}
	.plate-highlights strong {
		color: var(--apaper-ink);
		font-weight: 700;
	}
	.editorial-quote {
		margin: 14px 0 18px;
		padding: 10px 0 10px 14px;
		border-left: 2px solid var(--apaper-line);
		background: transparent;
		font-family: var(--apaper-font-serif);
		font-size: 0.94rem;
		line-height: 1.75;
		color: var(--apaper-ink-secondary);
		font-style: normal;
	}
	.editorial-quote p {
		margin: 0;
	}

	/* Buttons in apaper style */
	.plate-cta {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
		margin-bottom: 16px;
	}
	/* Tags in apaper style */
	.plate-tags, .spec-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 14px;
	}
	.plate-tags span, .spec-tags span {
		font-family: var(--apaper-font-mono);
		font-size: 9.5px;
		letter-spacing: 0.03em;
		padding: 2.5px 8.5px;
		border: 1px solid var(--apaper-line);
		border-radius: 999px;
		background: var(--apaper-tag-bg);
		color: var(--apaper-ink-secondary);
	}

	.terminal-title {
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		color: rgba(255, 255, 255, 0.5);
		margin-left: auto;
		letter-spacing: 0.06em;
	}

	/* ─────────────────────────────────────────────────────────────
	   Chapter 05: The Seven Bridges Inflection Point & Topological Fork
	   ───────────────────────────────────────────────────────────── */
	.editorial-node.node-pivot {
		grid-column: 1 / -1;
		display: flex;
		flex-direction: column;
		width: 100%;
	}
	.node-pivot .node-rail {
		display: none;
	}
	.node-pivot .node-content {
		width: 100%;
	}
	.node-pivot .node-header {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 14px;
		margin-bottom: 20px;
	}
	.node-pivot .node-dot-pivot {
		border-color: var(--apaper-accent);
		background: var(--apaper-accent);
		box-shadow: 0 0 0 4px var(--apaper-accent-soft);
	}
	.badge-pivot {
		color: var(--apaper-accent);
		font-weight: 700;
	}

	.pivot-stage {
		display: flex;
		flex-direction: column;
		width: 100%;
		position: relative;
	}

	/* Map Canvas Frame (Full-width panoramic breakout with zero left/right gutters & cropped top land) */
	.stage-canvas-frame {
		position: relative;
		border-radius: 0;
		overflow: hidden;
		border-top: 1px solid var(--apaper-line);
		border-bottom: 1px solid var(--apaper-line);
		border-left: none;
		border-right: none;
		width: 100vw;
		margin-left: calc(50% - 50vw);
		margin-right: calc(50% - 50vw);
		/* 55% of the original 330-unit panoramic crop (181.5 units). */
		aspect-ratio: 720 / 181.5;
		background: #e8e3d6;
		box-shadow: 0 16px 40px rgba(0, 0, 0, 0.16);
	}
	.stage-map-bg {
		position: absolute;
		left: 0;
		top: calc(-115 / 330 * 100%);
		width: 100%;
		height: calc(531 / 330 * 100%);
		object-fit: fill;
		display: block;
		filter: saturate(0.96) contrast(1.02);
	}
	.stage-map-vignette {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 1;
		background: linear-gradient(180deg, rgba(248, 246, 240, 0.35) 0%, rgba(248, 246, 240, 0) 40%, rgba(248, 246, 240, 0.2) 100%);
	}

	/* Full-Canvas Scrim Overlay (Fades in across entire map AFTER journey completes) */
	.stage-journey-scrim {
		position: absolute;
		inset: 0;
		z-index: 30;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(14, 16, 18, 0.78);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		opacity: 0;
		pointer-events: none;
		transition: opacity 1.1s cubic-bezier(0.16, 1, 0.3, 1);
		padding: 20px;
	}
	.stage-journey-scrim.is-active {
		opacity: 1;
		pointer-events: auto;
		cursor: pointer;
	}
	.stage-journey-scrim.is-active:hover .scrim-transition-card {
		border-color: #e5b382;
		box-shadow: 0 24px 60px rgba(0, 0, 0, 0.75), 0 0 0 1.5px rgba(229, 179, 130, 0.5);
	}
	.scrim-transition-card {
		position: relative;
		z-index: 31;
		width: 70%;
		max-width: 660px;
		background: rgba(22, 24, 27, 0.95);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid rgba(229, 179, 130, 0.45);
		border-radius: 16px;
		padding: clamp(18px, 3vw, 32px) clamp(22px, 3.5vw, 38px);
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255, 255, 255, 0.06);
		text-align: center;
		transform: scale(0.95) translateY(14px);
		transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.stage-journey-scrim.is-active .scrim-transition-card {
		transform: scale(1) translateY(0);
	}
	.scrim-meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 10px;
		font-family: var(--apaper-font-mono);
		font-size: 8.5px;
		letter-spacing: 0.12em;
	}
	.scrim-kicker {
		color: #e5b382;
		font-weight: 700;
		text-transform: uppercase;
	}
	.scrim-stamp {
		color: #e5b382;
		background: rgba(229, 179, 130, 0.14);
		padding: 2.5px 8px;
		border-radius: 4px;
		border: 1px solid rgba(229, 179, 130, 0.35);
	}
	.scrim-title {
		font-family: var(--apaper-font-serif);
		font-size: clamp(1.35rem, 2.4vw, 1.95rem);
		font-weight: 600;
		letter-spacing: -0.025em;
		color: #f5f2eb;
		margin: 0 0 8px;
		line-height: 1.22;
	}
	.scrim-subtitle {
		display: block;
		font-weight: 400;
		font-style: italic;
		color: #e5b382;
		font-size: 0.9em;
		margin-top: 2px;
	}
	.scrim-summary {
		font-family: var(--apaper-font-serif);
		font-size: clamp(0.86rem, 1.15vw, 0.95rem);
		line-height: 1.68;
		color: #ded9cf;
		margin: 0 auto;
		max-width: 520px;
		text-wrap: balance;
	}
	.scrim-replay-cue {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		margin-top: 14px;
		padding: 4px 14px;
		border-radius: 999px;
		background: rgba(229, 179, 130, 0.12);
		border: 1px solid rgba(229, 179, 130, 0.35);
		color: #e5b382;
		font-family: var(--apaper-font-mono);
		font-size: 8.5px;
		letter-spacing: 0.12em;
		font-weight: 700;
		text-transform: uppercase;
		transition: background 0.2s ease, transform 0.2s ease, color 0.2s ease, border-color 0.2s ease;
	}
	.stage-journey-scrim.is-active:hover .scrim-replay-cue {
		background: #e5b382;
		color: #121415;
		border-color: #e5b382;
		transform: translateY(-1px);
	}

	/* Footer Caption inside map frame */
	.stage-footer-caption {
		position: absolute;
		bottom: 10px;
		left: 16px;
		right: 16px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-family: var(--apaper-font-mono);
		font-size: 8px;
		letter-spacing: 0.1em;
		color: rgba(32, 34, 33, 0.6);
		z-index: 3;
		pointer-events: none;
	}
	.caption-indicator {
		color: var(--apaper-accent);
		font-weight: 700;
	}

	/* SVG Euler Traversal Layer */
	.stage-euler-svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 2;
	}
	.euler-track {
		fill: none;
		stroke: var(--apaper-accent);
		stroke-width: 1.5;
		stroke-dasharray: 4 6;
		stroke-opacity: 0.25;
	}
	.euler-stroke {
		fill: none;
		stroke: var(--apaper-accent);
		stroke-width: 3.5;
		stroke-linecap: round;
		stroke-linejoin: round;
		filter: drop-shadow(0 0 4px rgba(196, 94, 73, 0.5));
	}
	.milestone-halo {
		fill: #f59e0b;
		fill-opacity: 0;
		transition: fill-opacity 0.4s ease, r 0.4s ease;
	}
	.milestone-dot {
		fill: #fdfbf7;
		stroke: var(--apaper-accent);
		stroke-width: 2.2;
		transition: fill 0.35s ease, stroke 0.35s ease, filter 0.35s ease;
	}
	.milestone-pin-group.is-passed .milestone-halo {
		fill-opacity: 0.25;
		r: 15;
	}
	.milestone-pin-group.is-passed .milestone-dot {
		fill: #f59e0b;
		stroke: #ffffff;
		filter: drop-shadow(0 0 5px rgba(245, 158, 11, 0.85));
	}
	.euler-runner {
		fill: #f59e0b;
		filter: drop-shadow(0 0 6px #f59e0b);
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	/* 4 Floating Milestone Callout Annotations */
	.stage-milestone-annotations {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 3;
	}
	.milestone-callout {
		position: absolute;
		pointer-events: auto;
		opacity: 0;
		transform: translateY(6px);
		transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.milestone-callout.is-active {
		opacity: 1;
		transform: translateY(0);
	}
	/* Callout Stems & Card Positions */
	.callout-1 .callout-card {
		transform: translate(-104%, 8px);
	}
	.callout-1 .callout-stem {
		position: absolute;
		top: 0;
		left: 0;
		width: 18px;
		height: 14px;
		border-top: 1.5px dashed var(--apaper-accent);
		border-left: 1.5px dashed var(--apaper-accent);
		transform: translate(-18px, 0);
		opacity: 0.5;
	}

	.callout-2 .callout-card {
		transform: translate(12px, 8px);
	}
	.callout-2 .callout-stem {
		position: absolute;
		top: 0;
		left: 0;
		width: 14px;
		height: 12px;
		border-top: 1.5px dashed var(--apaper-accent);
		border-right: 1.5px dashed var(--apaper-accent);
		transform: translate(0, 0);
		opacity: 0.5;
	}

	.callout-3 .callout-card {
		transform: translate(14px, -50%);
	}
	.callout-3 .callout-stem {
		position: absolute;
		top: 0;
		left: 0;
		width: 14px;
		height: 1.5px;
		background: var(--apaper-accent);
		transform: translate(0, 0);
		opacity: 0.5;
	}

	.callout-4 .callout-card {
		transform: translate(-104%, -75%);
	}
	.callout-4 .callout-stem {
		position: absolute;
		top: 0;
		left: 0;
		width: 18px;
		height: 14px;
		border-bottom: 1.5px dashed var(--apaper-accent);
		border-left: 1.5px dashed var(--apaper-accent);
		transform: translate(-18px, -14px);
		opacity: 0.5;
	}

	.callout-card {
		background: rgba(18, 20, 22, 0.94);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid rgba(229, 179, 130, 0.5);
		border-radius: 8px;
		padding: 6px 12px;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
		display: flex;
		flex-direction: column;
		min-width: 150px;
		white-space: nowrap;
		cursor: default;
		transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
	}
	.callout-card:hover {
		border-color: #e5b382;
		transform: scale(1.04);
		box-shadow: 0 10px 28px rgba(0, 0, 0, 0.55);
	}
	.callout-badge {
		font-family: var(--apaper-font-mono);
		font-size: 7.5px;
		letter-spacing: 0.14em;
		font-weight: 700;
		color: #e5b382;
		text-transform: uppercase;
	}
	.callout-title {
		font-family: var(--apaper-font-serif);
		font-size: 0.92rem;
		font-weight: 600;
		color: #f5f2eb;
		margin: 1px 0 0;
		line-height: 1.25;
	}
	.callout-tag {
		font-family: var(--apaper-font-mono);
		font-size: 8px;
		letter-spacing: 0.03em;
		color: #ded9cf;
	}

	/* Canvas Exit Pin Dot (Exact connection point at bottom center) */
	.canvas-exit-pin {
		position: absolute;
		bottom: -5px;
		left: 50%;
		transform: translateX(-50%);
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #fdfbf7;
		border: 2px solid var(--apaper-accent);
		box-shadow: 0 0 0 2px rgba(196, 94, 73, 0.15);
		z-index: 5;
		transition: background 0.4s ease, filter 0.4s ease, border-color 0.4s ease;
	}
	.canvas-exit-pin.is-passed {
		background: #f59e0b;
		border-color: #ffffff;
		filter: drop-shadow(0 0 6px rgba(245, 158, 11, 0.9));
	}

	/* Connective Topological Fork (Continuous from map exit) */
	.topological-fork {
		position: relative;
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-top: 0;
		margin-bottom: 6px;
	}
	.fork-stem-connector {
		width: 2.5px;
		height: 22px;
		background: var(--apaper-accent);
		transform-origin: top center;
		transform: scaleY(0);
		opacity: 0;
		margin-bottom: -1px;
		transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease, filter 0.5s ease;
	}
	.fork-stem-connector.is-drawn {
		transform: scaleY(1);
		opacity: 1;
		filter: drop-shadow(0 0 4px rgba(229, 179, 130, 0.7));
	}
	.fork-banner {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 3px 12px;
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		border-radius: 999px;
		font-family: var(--apaper-font-mono);
		font-size: 8.5px;
		letter-spacing: 0.12em;
		color: var(--apaper-accent);
		font-weight: 700;
		margin-bottom: 2px;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
		position: relative;
		z-index: 2;
		opacity: 0;
		transform: scale(0.85);
		transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1), transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease;
	}
	.fork-banner.is-shown {
		opacity: 1;
		transform: scale(1);
		border-color: var(--apaper-accent);
	}
	.fork-pulse {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--apaper-accent);
		animation: pulse-glow 2s infinite ease-in-out;
	}
	.fork-svg {
		width: 100%;
		overflow: visible;
		display: block;
	}
	.fork-desktop {
		height: 68px;
	}
	.fork-mobile {
		display: none;
		height: 50px;
	}
	.fork-trunk {
		fill: none;
		stroke: var(--apaper-accent);
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-dasharray: 24;
		stroke-dashoffset: 24;
		transition: stroke-dashoffset 0.4s ease-out;
	}
	.fork-junction {
		fill: var(--apaper-accent);
		filter: drop-shadow(0 0 5px var(--apaper-accent));
		opacity: 0;
		transform-origin: 500px 24px;
		transform: scale(0);
		transition: opacity 0.3s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.fork-junction.is-lit {
		opacity: 1;
		transform: scale(1);
	}
	.fork-branch {
		fill: none;
		stroke: var(--apaper-accent);
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-opacity: 0.9;
		filter: drop-shadow(0 0 3px rgba(229, 179, 130, 0.4));
	}

	/* 4 Systematic Competency Spec Cards */
	.specs-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: clamp(14px, 2vw, 22px);
		margin-top: 4px;
	}
	.spec-card {
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		border-radius: 16px;
		padding: 22px 20px;
		display: flex;
		flex-direction: column;
		position: relative;
		box-shadow: 0 6px 18px rgba(32, 34, 33, 0.03);
		opacity: 0.4;
		transform: translateY(14px);
		filter: grayscale(0.35);
		transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
		            transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
		            filter 0.6s cubic-bezier(0.22, 1, 0.36, 1),
		            border-color 0.25s ease,
		            box-shadow 0.25s ease;
	}
	.spec-card.is-revealed {
		opacity: 1;
		transform: translateY(0);
		filter: grayscale(0);
		border-color: rgba(196, 94, 73, 0.3);
		box-shadow: 0 10px 26px rgba(32, 34, 33, 0.06);
	}
	.spec-card:hover {
		border-color: var(--apaper-accent);
		transform: translateY(-3px);
		box-shadow: 0 14px 30px rgba(32, 34, 33, 0.09);
	}
	.card-connector-dot {
		position: absolute;
		top: -5px;
		left: 50%;
		transform: translateX(-50%);
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--apaper-card);
		border: 2px solid var(--apaper-accent);
		box-shadow: 0 0 0 2px rgba(196, 94, 73, 0.1);
		transition: background 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
		z-index: 2;
	}
	.spec-card.is-revealed .card-connector-dot {
		background: var(--apaper-accent);
		box-shadow: 0 0 0 4px var(--apaper-accent-soft);
	}
	.spec-card-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		letter-spacing: 0.12em;
		padding-bottom: 12px;
		margin-bottom: 14px;
		border-bottom: 1px solid var(--apaper-line);
	}
	.spec-id {
		color: var(--apaper-accent);
		font-weight: 700;
	}
	.spec-scope {
		color: var(--apaper-muted);
	}
	.spec-title {
		font-family: var(--apaper-font-serif);
		font-size: 1.18rem;
		font-weight: 600;
		color: var(--apaper-ink);
		margin: 0 0 10px;
		line-height: 1.25;
	}
	.spec-desc {
		font-family: var(--apaper-font-serif);
		font-size: 0.88rem;
		line-height: 1.65;
		color: var(--apaper-ink-secondary);
		margin: 0 0 16px;
	}


	/* ─────────────────────────────────────────────────────────────
	   SECONDARY CATALOG // More Work (apaper archival index)
	   ───────────────────────────────────────────────────────────── */
	.projects {
		background: var(--apaper-bg);
		color: var(--apaper-ink);
		border-bottom: 1px solid var(--apaper-line);
		padding: clamp(4.5rem, 8vw, 7rem) 1.5rem;
		position: relative;
	}
	.projects-editorial-header {
		max-width: 1180px;
		margin: 0 auto clamp(2.5rem, 5vw, 4rem);
	}
	.projects-meta-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
		padding-bottom: 16px;
		border-bottom: 1px solid var(--apaper-line);
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--apaper-muted);
	}
	.projects-wordmark {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--apaper-ink);
		font-weight: 500;
	}
	.projects-mark-glyph {
		width: 26px;
		height: 26px;
		border: 1px solid var(--apaper-ink);
		border-radius: 8px;
		display: grid;
		place-items: center;
		font-family: var(--apaper-font-serif);
		font-size: 13px;
		font-weight: 600;
		color: var(--apaper-ink);
		background: var(--apaper-card);
	}
	.projects-status-tag {
		color: var(--apaper-muted);
	}
	.projects-title {
		font-family: var(--apaper-font-serif);
		font-size: clamp(2.2rem, 4vw, 3.2rem);
		font-weight: 500;
		letter-spacing: -0.03em;
		color: var(--apaper-ink);
		margin: 1.5rem 0 0.8rem;
		line-height: 1.1;
	}
	.projects-lead {
		font-family: var(--apaper-font-serif);
		font-size: clamp(1rem, 1.3vw, 1.12rem);
		color: var(--apaper-muted);
		max-width: 680px;
		line-height: 1.7;
		margin: 0;
	}
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: clamp(14px, 2vw, 22px);
		max-width: 1180px;
		margin: 0 auto;
	}
	.project-card {
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		border-radius: 16px;
		padding: 22px 22px 20px;
		display: flex;
		flex-direction: column;
		position: relative;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
		transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
	}
	.project-card:hover {
		border-color: var(--apaper-accent);
		transform: translateY(-3px);
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.16);
	}
	.project-card-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-bottom: 12px;
		margin-bottom: 14px;
		border-bottom: 1px solid var(--apaper-line);
	}
	.header-id-group {
		display: flex;
		align-items: center;
		gap: 8px;
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		letter-spacing: 0.12em;
	}
	.project-id {
		color: var(--apaper-accent);
		font-weight: 700;
	}
	.platform-badges {
		display: inline-flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 4px;
	}
	.platform-chip {
		font-family: var(--apaper-font-mono);
		font-size: 7.5px;
		letter-spacing: 0.06em;
		font-weight: 700;
		padding: 1.5px 5.5px;
		border-radius: 3.5px;
		text-transform: none;
		border: 1px solid var(--apaper-line);
		background: var(--apaper-tag-bg);
		color: var(--apaper-ink-secondary);
	}
	.platform-chip.chip-ios {
		color: #38bdf8;
		border-color: rgba(56, 189, 248, 0.35);
		background: rgba(56, 189, 248, 0.1);
	}
	.platform-chip.chip-macos {
		color: #c084fc;
		border-color: rgba(192, 132, 252, 0.35);
		background: rgba(192, 132, 252, 0.1);
	}
	.platform-chip.chip-ipad {
		color: #60a5fa;
		border-color: rgba(96, 165, 250, 0.35);
		background: rgba(96, 165, 250, 0.1);
	}
	.platform-chip.chip-watch {
		color: #f472b6;
		border-color: rgba(244, 114, 182, 0.35);
