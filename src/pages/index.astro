		margin: 0 0 1.4rem;
		font-size: clamp(2.8rem, 4.8vw, 4.4rem);
		letter-spacing: -0.03em;
		line-height: 1.08;
		font-weight: 600;
		color: var(--apaper-ink);
	}
	.hero-description {
		font-family: var(--apaper-font-serif);
		max-width: 600px;
		margin: 0 0 2.2rem;
		font-size: clamp(1.05rem, 1.4vw, 1.18rem);
		line-height: 1.75;
		color: var(--apaper-ink-secondary);
	}
	.hero-cta {
		display: flex;
		align-items: center;
		gap: 12px;
		flex-wrap: wrap;
		margin-bottom: 1.8rem;
	}
	.hero-credibility {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--apaper-muted);
		font-weight: 600;
	}
	.cred-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--apaper-accent);
	}
	/* Hero Visual Stage — Layered Depth Cards */
	.hero-visual {
		position: relative;
		justify-self: center;
		width: min(100%, 460px);
	}
	.stage-container {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.stage-meta-strip {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		letter-spacing: 0.12em;
		padding: 0 4px;
	}
	.stage-title-wrap {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--apaper-accent);
		font-weight: 700;
		text-transform: uppercase;
	}
	.stage-pulse {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--apaper-accent);
		box-shadow: 0 0 0 3px var(--apaper-accent-soft);
		animation: pulse-glow 2.2s infinite ease-in-out;
	}
	@keyframes pulse-glow {
		0%, 100% { transform: scale(1); opacity: 1; }
		50% { transform: scale(1.3); opacity: 0.6; }
	}
	.stage-shift-btn {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding: 3px 9px;
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		border-radius: 999px;
		color: var(--apaper-ink-secondary);
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		cursor: pointer;
		transition: border-color 0.2s ease, transform 0.2s ease, background 0.2s ease, color 0.2s ease;
	}
	.stage-shift-btn:hover {
		border-color: var(--apaper-accent);
		color: var(--apaper-accent);
		transform: translateY(-1px);
	}

	/* The Layered Stage Deck */
	.stage-deck {
		position: relative;
		width: 100%;
		height: 350px;
		perspective: 1000px;
	}
	.stage-card {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		border-radius: 16px;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		box-shadow: 0 10px 30px rgba(32, 34, 33, 0.08);
		transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1),
		            opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1),
		            box-shadow 0.65s ease,
		            filter 0.65s ease;
		will-change: transform, opacity;
	}

	/* Card Layers */
	.stage-card.is-front {
		z-index: 3;
		transform: translate3d(0, 0, 0) scale(1);
		opacity: 1;
		pointer-events: auto;
		box-shadow: 0 16px 36px rgba(32, 34, 33, 0.12);
		filter: brightness(1);
	}
	.stage-card.is-back {
		z-index: 1;
		transform: translate3d(24px, -18px, 0) scale(0.92) rotate(1.2deg);
		opacity: 0.72;
		pointer-events: auto;
		cursor: pointer;
		box-shadow: 0 8px 20px rgba(32, 34, 33, 0.05);
		filter: brightness(0.96);
	}
	.stage-card.is-back:hover {
		opacity: 0.88;
		border-color: var(--apaper-accent);
		transform: translate3d(22px, -20px, 0) scale(0.93) rotate(0.8deg);
	}
	.stage-card.is-hidden {
		z-index: 0;
		transform: translate3d(40px, -28px, 0) scale(0.85) rotate(2.4deg);
		opacity: 0;
		pointer-events: none;
	}

	/* Card Screen Container */
	.card-screen {
		position: relative;
		flex: 1;
		width: 100%;
		overflow: hidden;
		background: #000;
	}
	.card-screen-yong {
		background: #fdfbf7;
	}
	.card-screen-terminal {
		background: #090a0f;
	}
	.card-screen-arcade {
		background: #111417;
	}
	.stage-video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.card-screen-yong .stage-video {
		object-fit: contain;
	}

	/* Screen Stamp Badges */
	.screen-badge {
		position: absolute;
		top: 12px;
		left: 12px;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 4px 10px;
		background: rgba(248, 246, 240, 0.92);
		backdrop-filter: blur(8px);
		border: 1px solid var(--apaper-line);
		border-radius: 999px;
		font-family: var(--apaper-font-mono);
		font-size: 8.5px;
		letter-spacing: 0.08em;
		color: var(--apaper-ink);
		font-weight: 600;
		z-index: 2;
	}
	.badge-dot {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--apaper-accent);
	}
	.badge-terminal {
		background: rgba(14, 17, 22, 0.88);
		border-color: rgba(255, 255, 255, 0.15);
		color: #4ade80;
	}
	.dot-terminal {
		background: #4ade80;
	}
	.badge-arcade {
		background: rgba(18, 20, 24, 0.88);
		border-color: rgba(255, 255, 255, 0.15);
		color: #f59e0b;
	}
	.dot-arcade {
		background: #f59e0b;
	}

	/* Card Caption Bar */
	.card-caption-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px;
		padding: 12px 16px;
		background: var(--apaper-card);
		border-top: 1px solid var(--apaper-line);
	}
	.caption-copy {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}
	.caption-copy strong {
		font-family: var(--apaper-font-serif);
		font-size: 0.98rem;
		font-weight: 600;
		color: var(--apaper-ink);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.caption-copy span {
		font-family: var(--apaper-font-mono);
		font-size: 0.72rem;
		color: var(--apaper-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.stage-card-link {
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--apaper-accent);
		text-decoration: none;
		font-weight: 700;
		padding: 4px 8px;
		border: 1px solid var(--apaper-accent-line);
		border-radius: 6px;
		white-space: nowrap;
		transition: background 0.2s ease, color 0.2s ease;
	}
	.stage-card-link:hover {
		background: var(--apaper-accent);
		color: #ffffff;
	}

	/* Stage Pagination Indicator Pills */
	.stage-pills {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		margin-top: 4px;
	}
	.stage-pill {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		padding: 4px 10px;
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		border-radius: 999px;
		color: var(--apaper-muted);
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		letter-spacing: 0.05em;
		cursor: pointer;
		transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
	}
	.stage-pill:hover {
		border-color: var(--apaper-accent);
		color: var(--apaper-ink);
	}
	.stage-pill.active {
		border-color: var(--apaper-ink);
		background: var(--apaper-ink);
		color: #ffffff;
	}
	.pill-dot {
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: var(--apaper-muted);
	}
	.stage-pill.active .pill-dot {
		background: var(--apaper-accent);
	}

	/* Chapter 01 Native Video Player */
	.chapter-video-wrap {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: 12px;
		background: #000;
		border: 1px solid var(--apaper-line);
	}
	.chapter-native-video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	/* Proof — Archival Exhibit Plates */
	.proof {
		padding: clamp(4rem, 7vw, 6rem) 1.5rem;
		background: var(--apaper-bg);
	}
	.proof-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(14px, 2vw, 22px);
		max-width: 1180px;
		margin: 0 auto;
	}
	.proof-card {
		display: flex;
		flex-direction: column;
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		border-radius: 14px;
		overflow: hidden;
		color: inherit;
		text-decoration: none;
		transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
	}
	.proof-card:hover {
		border-color: var(--apaper-accent);
		transform: translateY(-3px);
		box-shadow: 0 10px 24px rgba(32, 34, 33, 0.06);
	}
	.proof-card-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 12px 16px;
		border-bottom: 1px solid var(--apaper-line);
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.proof-card-id {
		color: var(--apaper-accent);
		font-weight: 700;
	}
	.proof-card-scope {
		color: var(--apaper-muted);
	}
	.proof-media {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 200px;
		overflow: hidden;
		background: var(--apaper-bg-alt);
		border-bottom: 1px solid var(--apaper-line-light);
	}
	.proof-media img {
		display: block;
		width: 100%;
		height: 100%;
	}
	.proof-medal {
		background: #151515;
	}
	.proof-medal img {
		object-fit: cover;
		object-position: center;
	}
	.proof-rank {
		padding: 1.2rem;
	}
	.proof-rank img {
		height: auto;
		max-height: 100%;
		object-fit: contain;
		border-radius: 8px;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
	}
	.proof-devpost {
		background: #eef2f3;
	}
	.proof-devpost img {
		object-fit: cover;
		object-position: top center;
	}
	.proof-copy {
		display: grid;
		gap: 4px;
		padding: 14px 16px 18px;
	}
	.proof-copy strong {
		font-family: var(--apaper-font-serif);
		font-size: 1.08rem;
		font-weight: 600;
		color: var(--apaper-ink);
		line-height: 1.3;
	}
	.proof-copy span {
		font-family: var(--apaper-font-mono);
		color: var(--apaper-muted);
		font-size: 0.78rem;
		letter-spacing: 0.02em;
	}

	.signature {
		background: var(--apaper-bg);
		color: var(--apaper-ink);
		border-top: 1px solid var(--apaper-line);
		border-bottom: 1px solid var(--apaper-line);
		padding: clamp(5rem, 8vw, 7.5rem) 1.5rem clamp(6rem, 10vw, 9rem);
		position: relative;
	}

	/* Section Lead Header */
	.sig-editorial-header {
		max-width: 1180px;
		margin: 0 auto clamp(3.5rem, 6vw, 5.5rem);
	}
	.sig-meta-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
		padding-bottom: 16px;
		border-bottom: 1px solid var(--apaper-line);
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--apaper-muted);
	}
	.sig-wordmark {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--apaper-ink);
		font-weight: 500;
	}
	.sig-mark-glyph {
		width: 26px;
		height: 26px;
		border: 1px solid var(--apaper-ink);
		border-radius: 8px;
		display: grid;
		place-items: center;
		font-family: var(--apaper-font-serif);
		font-size: 13px;
		color: var(--apaper-ink);
		background: #ffffff60;
	}
	.sig-timeframe {
		color: var(--apaper-muted);
	}
	.sig-status-tag {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		color: var(--apaper-accent);
		font-weight: 700;
	}
	.sig-pulse-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--apaper-accent);
		box-shadow: 0 0 0 3px var(--apaper-accent-soft);
	}
	.sig-eyebrow {
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.16em;
		color: var(--apaper-accent);
		text-transform: uppercase;
		margin: 26px 0 10px;
	}
	.sig-title-block h2 {
		font-family: var(--apaper-font-serif);
		font-size: clamp(2.4rem, 4.5vw, 3.4rem);
		font-weight: 500;
		letter-spacing: -0.04em;
		line-height: 1.05;
		color: var(--apaper-ink);
		margin: 0 0 18px;
	}
	.sig-lead-text {
		font-family: var(--apaper-font-serif);
		font-size: clamp(1.02rem, 1.5vw, 1.18rem);
		line-height: 1.8;
		color: var(--apaper-muted);
		max-width: 840px;
		border-left: 2px solid var(--apaper-accent);
		padding-left: 18px;
		margin: 0;
	}

	/* The Editorial Flow & Rail Spine */
	.editorial-flow {
		max-width: 1180px;
		margin: 0 auto;
		position: relative;
	}
	.editorial-milestones {
		display: flex;
		flex-direction: column;
		gap: clamp(4rem, 7vw, 6.5rem);
		position: relative;
	}

	/* Individual Milestone Node */
	.editorial-node {
		display: grid;
		grid-template-columns: 56px 1fr;
		gap: clamp(18px, 3.5vw, 42px);
		position: relative;
	}
	.node-rail {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.node-marker {
		position: sticky;
		top: 96px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		background: var(--apaper-bg);
		padding: 6px 0;
		z-index: 2;
	}
	.node-num {
		font-family: var(--apaper-font-mono);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--apaper-muted);
	}
	.node-dot {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		border: 1px solid var(--apaper-accent);
		background: var(--apaper-bg);
		box-shadow: 0 0 0 3px var(--apaper-accent-soft);
	}
	.node-line-seg {
		position: absolute;
		top: 36px;
		bottom: -7rem;
		width: 1px;
		background: linear-gradient(180deg, var(--apaper-accent), var(--apaper-line) 30%, var(--apaper-line));
		opacity: 0.65;
		z-index: 1;
	}

	.node-content {
		min-width: 0;
	}
	.node-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px;
		padding-bottom: 12px;
		margin-bottom: 16px;
		border-bottom: 1px solid var(--apaper-line);
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.node-badge {
		color: var(--apaper-accent);
		font-weight: 700;
	}
	.node-date {
		color: var(--apaper-muted);
	}

	/* Card Plate */
	.node-plate {
		display: grid;
		grid-template-columns: minmax(300px, 1fr) minmax(320px, 1.1fr);
		gap: clamp(24px, 3.5vw, 44px);
		align-items: center;
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		border-radius: 18px;
		padding: clamp(20px, 3vw, 36px);
		box-shadow: 0 10px 24px rgba(32, 34, 33, 0.04);
		transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
	}
	.node-plate:hover {
		border-color: rgba(196, 94, 73, 0.35);
		box-shadow: 0 16px 36px rgba(32, 34, 33, 0.07);
		transform: translateY(-2px);
	}
	.node-plate.plate-reverse {
		grid-template-columns: minmax(320px, 1.1fr) minmax(300px, 1fr);
	}
	.node-plate.plate-reverse .plate-media {
		order: 2;
	}
	.node-plate.plate-reverse .plate-story {
		order: 1;
	}

	.plate-media {
		min-width: 0;
	}
	.media-frame {
		position: relative;
		overflow: hidden;
		border-radius: 12px;
		border: 1px solid var(--apaper-line);
		background: #111;
	}
	.media-frame img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0;
	}
	.media-stamp {
		position: absolute;
		top: 12px;
		right: 12px;
		z-index: 2;
		background: rgba(27, 33, 35, 0.85);
		color: #f8f5ef;
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		letter-spacing: 0.14em;
		padding: 4px 8px;
		border: 1px solid rgba(255, 255, 255, 0.25);
		border-radius: 4px;
		backdrop-filter: blur(8px);
	}

	.plate-story {
		min-width: 0;
	}
	.plate-kicker {
		display: inline-block;
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.14em;
		color: var(--apaper-accent);
		text-transform: uppercase;
		margin-bottom: 6px;
	}
	.plate-story h3 {
		font-family: var(--apaper-font-serif);
		font-size: clamp(1.45rem, 2.2vw, 1.85rem);
		font-weight: 500;
		letter-spacing: -0.025em;
		color: var(--apaper-ink);
		margin: 0 0 12px;
		line-height: 1.22;
	}
	.plate-p {
		font-family: var(--apaper-font-serif);
		font-size: 0.98rem;
		line-height: 1.8;
		color: var(--apaper-ink-secondary);
		margin: 0 0 14px;
	}
	.plate-p strong {
		color: var(--apaper-ink);
	}
	.editorial-quote {
		margin: 14px 0 18px;
		padding: 10px 0 10px 14px;
		border-left: 2px solid var(--apaper-line);
		background: transparent;
		font-family: var(--apaper-font-serif);
		font-size: 0.94rem;
		line-height: 1.75;
		color: var(--apaper-ink-secondary);
		font-style: normal;
	}
	.editorial-quote p {
		margin: 0;
	}

	/* Buttons in apaper style */
	.plate-cta {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
		margin-bottom: 16px;
	}
	.btn-apaper {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 7px 16px;
		border-radius: 999px;
		background: var(--apaper-ink);
		color: #ffffff;
		font-family: var(--apaper-font-mono);
		font-size: 11px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-decoration: none;
		border: 1px solid var(--apaper-ink);
		transition: background 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
	}
	.btn-apaper:hover {
		background: var(--apaper-accent);
		border-color: var(--apaper-accent);
		color: #ffffff;
		transform: translateY(-1px);
	}
	.btn-apaper-ghost {
		background: transparent;
