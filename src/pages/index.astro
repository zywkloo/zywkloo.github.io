	}
	.proof-grid {
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1rem, 2.4vw, 1.75rem);
		max-width: 1248px;
	}
	.proof-card {
		display: block;
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: var(--surface-raised);
		box-shadow: var(--shadow-md);
		color: inherit;
		transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s var(--ease);
	}
	.proof-card:hover {
		transform: translateY(-6px);
		border-color: rgba(var(--accent-rgb), 0.3);
		box-shadow: var(--shadow-lg);
	}
	.proof-media {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 210px;
		overflow: hidden;
		background: var(--accent-soft);
	}
	.proof-media img {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: 0;
	}
	.proof-medal {
		background: #151515;
	}
	.proof-medal img {
		object-fit: cover;
		object-position: center;
	}
	.proof-rank {
		padding: 1.3rem;
	}
	.proof-rank img {
		height: auto;
		object-fit: contain;
		border-radius: 9px;
		box-shadow: 0 0 0 1px var(--line), var(--shadow-sm);
	}
	.proof-devpost {
		background: #eef2f3;
	}
	.proof-devpost img {
		object-fit: cover;
		object-position: top center;
	}
	.proof-copy {
		display: grid;
		gap: 0.35rem;
		padding: 1.4rem 1.55rem 1.65rem;
	}
	.proof-copy strong {
		font-size: 1.14rem;
		line-height: 1.3;
	}
	.proof-copy span {
		color: rgb(var(--gray));
		font-size: 0.88rem;
	}

	/* ─────────────────────────────────────────────────────────────
	   SIGNATURE ARCHIVE // apaper "kami" editorial style system
	   Paper, carbon ink, hairline rules, and cinnabar terracotta.
	   ───────────────────────────────────────────────────────────── */
	:root {
		--apaper-bg: #f8f6f0;
		--apaper-bg-alt: #f3efe6;
		--apaper-card: #fcfbf8;
		--apaper-ink: #202221;
		--apaper-ink-secondary: #4a4742;
		--apaper-muted: #776f66;
		--apaper-line: #ded6ca;
		--apaper-line-light: #ece6dc;
		--apaper-accent: #c45e49;
		--apaper-accent-soft: rgba(196, 94, 73, 0.08);
		--apaper-accent-line: rgba(196, 94, 73, 0.25);
		--apaper-font-mono: ui-monospace, "SFMono-Regular", Menlo, Monaco, Consolas, monospace;
		--apaper-font-serif: "Songti SC", "Noto Serif CJK SC", "Source Han Serif SC", Georgia, serif;
	}

	.signature {
		background: var(--apaper-bg);
		color: var(--apaper-ink);
		border-top: 1px solid var(--apaper-line);
		border-bottom: 1px solid var(--apaper-line);
		padding: clamp(5rem, 8vw, 7.5rem) 1.5rem clamp(6rem, 10vw, 9rem);
		position: relative;
	}

	/* Section Lead Header */
	.sig-editorial-header {
		max-width: 1180px;
		margin: 0 auto clamp(3.5rem, 6vw, 5.5rem);
	}
	.sig-meta-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
		padding-bottom: 16px;
		border-bottom: 1px solid var(--apaper-line);
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--apaper-muted);
	}
	.sig-wordmark {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--apaper-ink);
		font-weight: 500;
	}
	.sig-mark-glyph {
		width: 26px;
		height: 26px;
		border: 1px solid var(--apaper-ink);
		border-radius: 8px;
		display: grid;
		place-items: center;
		font-family: var(--apaper-font-serif);
		font-size: 13px;
		color: var(--apaper-ink);
		background: #ffffff60;
	}
	.sig-timeframe {
		color: var(--apaper-muted);
	}
	.sig-status-tag {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		color: var(--apaper-accent);
		font-weight: 700;
	}
	.sig-pulse-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--apaper-accent);
		box-shadow: 0 0 0 3px var(--apaper-accent-soft);
	}
	.sig-eyebrow {
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.16em;
		color: var(--apaper-accent);
		text-transform: uppercase;
		margin: 26px 0 10px;
	}
	.sig-title-block h2 {
		font-family: var(--apaper-font-serif);
		font-size: clamp(2.4rem, 4.5vw, 3.4rem);
		font-weight: 500;
		letter-spacing: -0.04em;
		line-height: 1.05;
		color: var(--apaper-ink);
		margin: 0 0 18px;
	}
	.sig-lead-text {
		font-family: var(--apaper-font-serif);
		font-size: clamp(1.02rem, 1.5vw, 1.18rem);
		line-height: 1.8;
		color: var(--apaper-muted);
		max-width: 840px;
		border-left: 2px solid var(--apaper-accent);
		padding-left: 18px;
		margin: 0;
	}

	/* The Editorial Flow & Rail Spine */
	.editorial-flow {
		max-width: 1180px;
		margin: 0 auto;
		position: relative;
	}
	.editorial-milestones {
		display: flex;
		flex-direction: column;
		gap: clamp(4rem, 7vw, 6.5rem);
		position: relative;
	}

	/* Individual Milestone Node */
	.editorial-node {
		display: grid;
		grid-template-columns: 56px 1fr;
		gap: clamp(18px, 3.5vw, 42px);
		position: relative;
	}
	.node-rail {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.node-marker {
		position: sticky;
		top: 96px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		background: var(--apaper-bg);
		padding: 6px 0;
		z-index: 2;
	}
	.node-num {
		font-family: var(--apaper-font-mono);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--apaper-muted);
	}
	.node-dot {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		border: 1px solid var(--apaper-accent);
		background: var(--apaper-bg);
		box-shadow: 0 0 0 3px var(--apaper-accent-soft);
	}
	.node-line-seg {
		position: absolute;
		top: 36px;
		bottom: -7rem;
		width: 1px;
		background: linear-gradient(180deg, var(--apaper-accent), var(--apaper-line) 30%, var(--apaper-line));
		opacity: 0.65;
		z-index: 1;
	}

	.node-content {
		min-width: 0;
	}
	.node-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px;
		padding-bottom: 12px;
		margin-bottom: 16px;
		border-bottom: 1px solid var(--apaper-line);
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.node-badge {
		color: var(--apaper-accent);
		font-weight: 700;
	}
	.node-date {
		color: var(--apaper-muted);
	}

	/* Card Plate */
	.node-plate {
		display: grid;
		grid-template-columns: minmax(300px, 1fr) minmax(320px, 1.1fr);
		gap: clamp(24px, 3.5vw, 44px);
		align-items: center;
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		border-radius: 18px;
		padding: clamp(20px, 3vw, 36px);
		box-shadow: 0 10px 24px rgba(32, 34, 33, 0.04);
		transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
	}
	.node-plate:hover {
		border-color: rgba(196, 94, 73, 0.35);
		box-shadow: 0 16px 36px rgba(32, 34, 33, 0.07);
		transform: translateY(-2px);
	}
	.node-plate.plate-reverse {
		grid-template-columns: minmax(320px, 1.1fr) minmax(300px, 1fr);
	}
	.node-plate.plate-reverse .plate-media {
		order: 2;
	}
	.node-plate.plate-reverse .plate-story {
		order: 1;
	}

	.plate-media {
		min-width: 0;
	}
	.media-frame {
		position: relative;
		overflow: hidden;
		border-radius: 12px;
		border: 1px solid var(--apaper-line);
		background: #111;
	}
	.media-frame img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0;
	}
	.media-stamp {
		position: absolute;
		top: 12px;
		right: 12px;
		z-index: 2;
		background: rgba(27, 33, 35, 0.85);
		color: #f8f5ef;
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		letter-spacing: 0.14em;
		padding: 4px 8px;
		border: 1px solid rgba(255, 255, 255, 0.25);
		border-radius: 4px;
		backdrop-filter: blur(8px);
	}

	.plate-story {
		min-width: 0;
	}
	.plate-kicker {
		display: inline-block;
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.14em;
		color: var(--apaper-accent);
		text-transform: uppercase;
		margin-bottom: 6px;
	}
	.plate-story h3 {
		font-family: var(--apaper-font-serif);
		font-size: clamp(1.45rem, 2.2vw, 1.85rem);
		font-weight: 500;
		letter-spacing: -0.025em;
		color: var(--apaper-ink);
		margin: 0 0 12px;
		line-height: 1.22;
	}
	.plate-p {
		font-family: var(--apaper-font-serif);
		font-size: 0.98rem;
		line-height: 1.8;
		color: var(--apaper-ink-secondary);
		margin: 0 0 14px;
	}
	.plate-p strong {
		color: var(--apaper-ink);
	}
	.editorial-quote {
		margin: 14px 0 18px;
		padding: 10px 0 10px 14px;
		border-left: 2px solid var(--apaper-line);
		background: transparent;
		font-family: var(--apaper-font-serif);
		font-size: 0.94rem;
		line-height: 1.75;
		color: var(--apaper-ink-secondary);
		font-style: normal;
	}
	.editorial-quote p {
		margin: 0;
	}

	/* Buttons in apaper style */
	.plate-cta {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
		margin-bottom: 16px;
	}
	.btn-apaper {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 7px 16px;
		border-radius: 999px;
		background: var(--apaper-ink);
		color: #ffffff;
		font-family: var(--apaper-font-mono);
		font-size: 11px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-decoration: none;
		border: 1px solid var(--apaper-ink);
		transition: background 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
	}
	.btn-apaper:hover {
		background: var(--apaper-accent);
		border-color: var(--apaper-accent);
		color: #ffffff;
		transform: translateY(-1px);
	}
	.btn-apaper-ghost {
		background: transparent;
		color: var(--apaper-ink);
		border-color: var(--apaper-line);
	}
	.btn-apaper-ghost:hover {
		background: rgba(32, 34, 33, 0.05);
		border-color: var(--apaper-ink);
		color: var(--apaper-ink);
	}

	/* Tags in apaper style */
	.plate-tags, .spec-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 14px;
	}
	.plate-tags span, .spec-tags span {
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		letter-spacing: 0.03em;
		padding: 3px 9px;
		border: 1px solid var(--apaper-line);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.6);
		color: var(--apaper-muted);
	}

	.terminal-title {
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		color: rgba(255, 255, 255, 0.5);
		margin-left: auto;
		letter-spacing: 0.06em;
	}

	/* Chapter 05: The Seven Bridges Pivot (七桥之思) */
	.node-pivot .node-dot-pivot {
		border-color: var(--apaper-accent);
		background: var(--apaper-accent);
		box-shadow: 0 0 0 4px var(--apaper-accent-soft);
	}
	.badge-pivot {
		color: var(--apaper-accent);
		font-weight: 700;
	}
	.pivot-plate {
		display: grid;
		grid-template-columns: minmax(300px, 1fr) minmax(320px, 1.15fr);
		gap: clamp(24px, 3.5vw, 48px);
		align-items: center;
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		border-radius: 18px;
		padding: clamp(22px, 3.5vw, 40px);
		box-shadow: 0 12px 30px rgba(32, 34, 33, 0.05);
		position: relative;
	}
	.pivot-illustration-wrap {
		min-width: 0;
	}
	.pivot-figure {
		position: relative;
		overflow: hidden;
		border-radius: 12px;
		border: 1px solid var(--apaper-line);
		aspect-ratio: 720 / 531;
		margin: 0;
		background: #101112;
	}
	.pivot-figure img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		filter: saturate(0.92) contrast(1.02);
	}
	.pivot-stamp {
		position: absolute;
		top: 14px;
		right: 14px;
		z-index: 3;
		background: rgba(27, 33, 35, 0.88);
		color: #f8f5ef;
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		letter-spacing: 0.16em;
		padding: 5px 9px;
		border: 1px solid rgba(255, 255, 255, 0.28);
		border-radius: 4px;
		backdrop-filter: blur(8px);
	}
	.pivot-vignette {
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
		background: linear-gradient(180deg, rgba(8, 11, 11, 0.08) 0%, rgba(8, 11, 11, 0) 50%, rgba(8, 11, 11, 0.28) 100%);
	}
	.pivot-river {
		position: absolute;
		inset: 0;
		z-index: 2;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
	.pivot-river path {
		fill: none;
		stroke: var(--apaper-accent);
		stroke-width: 2.2;
		stroke-linecap: round;
	}
	.flow-pregel-1 {
		stroke-dasharray: 6 10;
		stroke-opacity: 0.78;
		animation: river-flow 3.8s linear infinite;
	}
	.flow-pregel-2 {
		stroke-dasharray: 5 9;
		stroke-opacity: 0.68;
		animation: river-flow 4.6s linear infinite reverse;
	}
	@keyframes river-flow {
		to { stroke-dashoffset: -72; }
	}
	.pivot-caption {
		display: flex;
		justify-content: space-between;
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		letter-spacing: 0.1em;
		color: var(--apaper-muted);
		margin-top: 8px;
		padding: 0 4px;
	}
	.pivot-thesis {
		min-width: 0;
	}
	.pivot-thesis h3 {
		font-family: var(--apaper-font-serif);
		font-size: clamp(1.6rem, 2.5vw, 2.2rem);
		font-weight: 500;
		letter-spacing: -0.03em;
		color: var(--apaper-ink);
		margin: 6px 0 14px;
		line-height: 1.18;
	}
	.pivot-lead {
		font-family: var(--apaper-font-serif);
		font-size: 1rem;
		line-height: 1.8;
		color: var(--apaper-ink-secondary);
		margin-bottom: 16px;
	}
	.pivot-lead strong {
		color: var(--apaper-ink);
	}
	.pivot-quote-box {
		border-left: 2px solid var(--apaper-accent);
		background: rgba(196, 94, 73, 0.04);
		padding: 12px 16px;
		border-radius: 0 10px 10px 0;
		margin-bottom: 18px;
	}
	.pivot-quote-label {
		display: block;
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.14em;
		color: var(--apaper-accent);
		margin-bottom: 6px;
	}
	.pivot-quote-box p {
		margin: 0;
		font-family: var(--apaper-font-serif);
		font-size: 0.93rem;
		line-height: 1.75;
		color: var(--apaper-ink);
	}
	.pivot-quote-box em {
		color: var(--apaper-accent);
		font-style: normal;
	}
	.pivot-indicator {
		display: flex;
		align-items: center;
		gap: 10px;
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		letter-spacing: 0.12em;
		color: var(--apaper-muted);
		padding-top: 10px;
		border-top: 1px solid var(--apaper-line);
	}
	.pivot-arrow {
		color: var(--apaper-accent);
		font-size: 13px;
		font-weight: 700;
	}

	/* Chapter 06: The 4 Systematic Competency Spec Cards */
	.competencies-section {
		margin-top: clamp(2rem, 4vw, 3.5rem);
		padding-top: clamp(2.5rem, 5vw, 4rem);
		border-top: 1px solid var(--apaper-line);
		position: relative;
	}
	.competencies-header {
		text-align: left;
		margin-bottom: clamp(2rem, 3.5vw, 3rem);
	}
	.comp-eyebrow {
		font-family: var(--apaper-font-mono);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.14em;
		color: var(--apaper-accent);
		text-transform: uppercase;
		margin-bottom: 8px;
	}
	.competencies-header h3 {
		font-family: var(--apaper-font-serif);
		font-size: clamp(1.8rem, 3vw, 2.5rem);
		font-weight: 500;
		letter-spacing: -0.03em;
		color: var(--apaper-ink);
		margin: 0 0 8px;
	}
	.competencies-header p {
		font-family: var(--apaper-font-serif);
		font-size: 1rem;
		color: var(--apaper-muted);
		margin: 0;
	}
	.specs-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: clamp(14px, 2vw, 22px);
	}
	.spec-card {
		background: var(--apaper-card);
		border: 1px solid var(--apaper-line);
		border-radius: 14px;
		padding: 22px 20px;
		display: flex;
		flex-direction: column;
		transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
	}
	.spec-card:hover {
		border-color: var(--apaper-accent);
		transform: translateY(-3px);
		box-shadow: 0 10px 24px rgba(32, 34, 33, 0.06);
	}
	.spec-card-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-family: var(--apaper-font-mono);
		font-size: 9px;
		letter-spacing: 0.12em;
		padding-bottom: 12px;
		margin-bottom: 14px;
		border-bottom: 1px solid var(--apaper-line);
	}
	.spec-id {
		color: var(--apaper-accent);
		font-weight: 700;
	}
	.spec-scope {
		color: var(--apaper-muted);
	}
	.spec-title {
		font-family: var(--apaper-font-serif);
		font-size: 1.18rem;
		font-weight: 600;
		color: var(--apaper-ink);
		margin: 0 0 10px;
		line-height: 1.25;
	}
	.spec-desc {
		font-family: var(--apaper-font-serif);
		font-size: 0.88rem;
		line-height: 1.65;
		color: var(--apaper-ink-secondary);
		margin: 0 0 16px;
	}

	/* Responsive media queries */
	@media (max-width: 1040px) {
		.specs-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 980px) {
		.hero-inner {
			grid-template-columns: 1fr 380px;
			gap: 2.5rem;
		}
		.hero h1 {
			font-size: clamp(2.75rem, 6vw, 3.7rem);
		}
	}

	@media (max-width: 859px) {
		.hero-inner {
			grid-template-columns: 1fr;
		}
		.hero-visual {
			width: min(100%, 500px);
		}
		.proof-grid {
			grid-template-columns: 1fr;
			max-width: 560px;
		}
		.proof-card {
			display: grid;
