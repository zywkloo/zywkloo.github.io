---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL, SITE_AUTHOR, PROFILE_IMAGE, USER_TITLE, GITHUB_URL, WTCRAFT_URL, LINKEDIN_URL, EMAIL, MEDIUM_URL, SAME_AS, SITE_AUTHOR_ALT, GOLDENARC_NAME, GOLDENARC_SAME_AS } from '../consts';

// Signature-work links kept local to this page (mirrors the pattern used by
// edfviewer.astro / yong.astro, which each define their own APP_STORE_URL).
const WISHES_APP_STORE_URL = 'https://apps.apple.com/ca/app/wishes-by-hand/id6774579880';
const EDF_APP_STORE_URL = 'https://apps.apple.com/app/id6801383472';
const WILDDUNK_YT_ID = 'ysmp5vK4R_c';

// Identity knowledge graph for AI/search engines: who Victor Zhang is and what
// this site is. Person + WebSite, cross-linked by @id.
const personLd = {
	'@type': 'Person',
	'@id': `${SITE_URL}/#person`,
	name: SITE_AUTHOR,
	alternateName: SITE_AUTHOR_ALT,
	url: SITE_URL,
	image: PROFILE_IMAGE,
	jobTitle: USER_TITLE,
	email: `mailto:${EMAIL}`,
	knowsAbout: [
		'iOS Development', 'Swift', 'SwiftUI', 'React Native',
		'BLE / IoT device sync', 'Backend data pipelines', 'Telemetry',
		'Agentic AI workflows', 'Metal GPU programming',
		'On-device ML (CoreML)', 'Handwriting scoring',
	],
	alumniOf: [
		{ '@type': 'CollegeOrUniversity', name: 'University of British Columbia' },
		{ '@type': 'CollegeOrUniversity', name: 'Carleton University' },
		{ '@type': 'CollegeOrUniversity', name: 'Peking University' },
	],
	award: 'University Medal in Computer Science, Carleton University (2020)',
	worksFor: { '@id': `${SITE_URL}/#goldenarc` },
	sameAs: SAME_AS,
};
const organizationLd = {
	'@type': 'Organization',
	'@id': `${SITE_URL}/#goldenarc`,
	name: GOLDENARC_NAME,
	description: 'Independent digital studio founded by Victor Zhang (pre-launch).',
	founder: { '@id': `${SITE_URL}/#person` },
	...(GOLDENARC_SAME_AS.length ? { sameAs: GOLDENARC_SAME_AS } : {}),
};
const websiteLd = {
	'@type': 'WebSite',
	'@id': `${SITE_URL}/#website`,
	url: SITE_URL,
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	inLanguage: ['en', 'zh-CN'],
	author: { '@id': `${SITE_URL}/#person` },
	publisher: { '@id': `${SITE_URL}/#person` },
};
const homeLd = { '@context': 'https://schema.org', '@graph': [websiteLd, personLd, organizationLd] };
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify(homeLd)} />
	</head>
	<body>
		<Header />
		<main class="homepage">
			<section class="hero" aria-labelledby="home-title">
				<div class="hero-inner">
					<div class="hero-copy">
						<p class="hero-kicker">{USER_TITLE}</p>
						<h1 id="home-title">I build the data systems inside mobile products.</h1>
						<p class="hero-description">iOS, React Native, BLE sync, backend pipelines, and telemetry — engineered for correctness and resilience under real-world conditions, from device to cloud.</p>
						<div class="hero-cta">
							<a href="#work" class="btn btn-primary">See My Work ↓</a>
							<a href="/about" class="btn btn-secondary">How I Think →</a>
						</div>
						<p class="hero-credibility">10+ years in tech · 7 years in software engineering</p>
					</div>
					<div class="hero-visual">
						<div class="hero-art">
							<img src="/images/home-systems-hero.webp" alt="Layered mobile data system connecting a device, governed pipelines, and cloud services" />
							<span>Device → pipeline → cloud</span>
						</div>
						<a class="hero-proof" href="#story">
							<img src="/images/proof/carleton-university-medal.webp" alt="" />
							<span><strong>University Medal</strong><small>Carleton · 2020</small></span>
						</a>
					</div>
				</div>
			</section>

			<section class="proof" aria-label="Selected proof points">
				<div class="container proof-grid">
					<a href="#story" class="proof-card">
						<div class="proof-media proof-medal"><img src="/images/proof/carleton-university-medal.webp" alt="Carleton University Medal in Computer Science, engraved with Yiwei Zhang, 2020" /></div>
						<div class="proof-copy"><strong>University Medal in Computer Science</strong><span>Carleton University · 2020</span></div>
					</a>
					<a href="#wilddunk" class="proof-card">
						<div class="proof-media proof-rank"><img src="/images/proof/wilddunk-appannie-2015.webp" alt="App Annie Highest Ranks report showing Wild Dunk at number 1 in Sports in China" /></div>
						<div class="proof-copy"><strong>#1 Sports · China App Store</strong><span>Wild Dunk · May 3, 2015</span></div>
					</a>
					<a href="#projects" class="proof-card">
						<div class="proof-media proof-trophy" aria-hidden="true">🏆</div>
						<div class="proof-copy"><strong>2× Hackathon Winner</strong><span>cuHacking · 2019 &amp; 2020</span></div>
					</a>
				</div>
			</section>

			<section class="signature" id="work" aria-labelledby="signature-title">
				<div class="signature-heading container">
					<p class="eyebrow">A career, traced through artifacts</p>
					<h2 id="signature-title">Signature Work</h2>
					<p>Four projects trace one arc — from ranking and economy design in a mobile game to production systems and tools.</p>
				</div>

				<div class="arc-flow">
					<svg class="desktop-career-route" viewBox="0 0 1248 2611" preserveAspectRatio="none" aria-hidden="true">
						<path d="M120 30 C190 90 190 170 190 230 C190 340 50 660 50 770 C50 880 190 1200 190 1310 C190 1420 50 1740 50 1850 C50 1960 220 2050 608 2080 L608 2120 C584 2160 564 2230 556 2284 C549 2305 564 2325 584 2335 C599 2338 612 2339 624 2340 C674 2346 724 2350 768 2352 C799 2358 829 2370 856 2380 C834 2420 809 2465 792 2500 C734 2485 664 2475 604 2468 C579 2465 554 2463 536 2460 C549 2435 562 2412 572 2392 C589 2375 609 2355 624 2340 C639 2380 644 2500 644 2611" />
						<circle cx="190" cy="230" r="11" /><circle cx="50" cy="770" r="11" /><circle cx="190" cy="1310" r="11" /><circle cx="50" cy="1850" r="11" />
						<circle cx="608" cy="2204" r="6" /><circle cx="624" cy="2340" r="7" /><circle cx="856" cy="2380" r="6" /><circle cx="536" cy="2460" r="6" />
					</svg>

					<div class="works-layout">
						<div class="career-labels" aria-hidden="true">
							<span style="top:260px">Started as<br />Mobile Game</span>
							<span style="top:800px">Into Mobile<br />Engineering</span>
							<span style="top:1340px">Data &amp; Agentic<br />Pipeline Governance</span>
							<span style="top:1880px">Then Developer<br />Tooling</span>
						</div>
						<div class="signature-list">
							<article class="sig-block" id="wilddunk">
								<div class="sig-media">
									<div class="video-facade" data-video-id={WILDDUNK_YT_ID} role="button" tabindex="0" aria-label="Play Wild Dunk gameplay video">
										<img src="/images/wilddunk/video-poster.webp" alt="全民大灌篮 / Wild Dunk gameplay artwork" loading="lazy" />
										<span class="play-btn" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill="currentColor" d="M8 5v14l11-7z" /></svg></span>
									</div>
									<figure class="rank-card">
										<img src="/images/proof/wilddunk-appannie-2015.webp" alt="App Annie report: Wild Dunk ranked number 9 overall and number 1 in Sports in China on May 3, 2015" loading="lazy" />
										<figcaption>Archived App Annie report · China · May 3, 2015. Wild Dunk was later delisted. App Store ID 949338049.</figcaption>
									</figure>
								</div>
								<div class="sig-body"><p class="eyebrow">Game Design · 2015</p><h3>全民大灌篮 · Wild Dunk</h3><p>As game design lead I owned core gameplay, ranking, and monetization for this basketball title — it reached <strong>#9 Overall</strong> and <strong>#1 in Sports</strong> on the China App Store. Its ranking ladders and economy taught me to think in the state machines and control policies I now apply to production systems.</p></div>
							</article>

							<article class="sig-block sig-reverse" id="wishes">
								<div class="sig-media"><img src="/images/wishes-hero.webp" alt="Wishes by Hand app showing a handwritten Chinese greeting card" class="sig-frame wishes-frame" loading="lazy" /></div>
								<div class="sig-body"><p class="eyebrow">Emotional Product · App Store</p><h3>亲笔小卡 · Wishes by Hand</h3><p>A handwriting app for quiet reconnection: write by finger or Apple Pencil, watch a low-latency ink engine render real brush character, then send a finished card in one tap.</p><div class="sig-cta"><a href={WISHES_APP_STORE_URL} target="_blank" rel="noopener" class="btn btn-primary btn-sm">App Store ↗</a><a href="/yong" class="btn btn-secondary btn-sm">Full Story →</a></div></div>
							</article>

							<article class="sig-block" id="wtcraft-sig">
								<div class="sig-media"><div class="terminal-card" aria-hidden="true"><div class="terminal-titlebar"><span></span><span></span><span></span></div><pre class="terminal-body"><code><span class="t-prompt">$</span> wtcraft init
<span class="t-prompt">$</span> wtcraft check
<span class="t-ok">✓</span> scope respected
<span class="t-ok">✓</span> off-limits clear
<span class="t-prompt">$</span> wtcraft verify
<span class="t-ok">✓</span> tests passed</code></pre></div></div>
								<div class="sig-body"><p class="eyebrow">Developer Tool · Open Source</p><h3>wtcraft</h3><p>A git-native CLI for multi-agent coding workflows. It scaffolds task contracts per worktree, checks actual changes against them, and runs deterministic verification — keeping delegation bounded without losing the handoff.</p><div class="sig-cta"><a href={WTCRAFT_URL} target="_blank" rel="noopener" class="btn btn-primary btn-sm">GitHub ↗</a><a href="/wtcraft" class="btn btn-secondary btn-sm">Full Page →</a></div></div>
							</article>

							<article class="sig-block sig-reverse" id="edfviewer-sig">
								<div class="sig-media"><img src="/images/edfviewer/hero-preview.webp" alt="ARC EDF and BDF Viewer on macOS showing an all-channels montage" class="sig-frame" loading="lazy" /></div>
								<div class="sig-body"><p class="eyebrow">Professional Tool · macOS &amp; iPadOS</p><h3>EDF &amp; BDF Viewer</h3><p>A native SwiftUI viewer for EDF and BDF biosignal recordings — EEG, ECG, sleep, and electrophysiology research. Zero runtime dependencies, 100% on-device and private.</p><div class="sig-cta"><a href={EDF_APP_STORE_URL} target="_blank" rel="noopener" class="btn btn-primary btn-sm">Mac App Store ↗</a><a href="/edfviewer" class="btn btn-secondary btn-sm">Full Page →</a></div></div>
							</article>
						</div>
					</div>

					<div class="bridge-scene" tabindex="0" aria-describedby="bridge-message">
						<img src="/images/konigsberg-bridges-simple.webp" width="720" height="531" alt="Simple map illustration of the seven bridges of Königsberg connecting two riverbanks and two islands" loading="lazy" />
						<span class="bridge-badge">Where the Arc Leads</span>
						<svg class="water-flow" viewBox="0 0 720 531" aria-hidden="true">
							<path class="flow-one" d="M0 232 C160 220 340 225 430 222 C500 220 555 216 600 222" />
							<path class="flow-two" d="M150 302 C300 300 450 300 545 308 C575 340 600 380 592 420 C585 455 580 495 600 525" />
						</svg>
						<svg class="mobile-map-route" viewBox="0 0 720 531" aria-hidden="true"><path d="M344 0 L344 40 C320 80 300 150 292 204 C285 225 300 245 320 255 C335 258 348 259 360 260 C410 266 460 270 504 272 C535 278 565 290 592 300 C570 340 545 385 528 420 C470 405 400 395 340 388 C315 385 290 383 272 380 C285 355 298 332 308 312 C325 295 345 275 360 260 C375 300 380 420 380 531" /></svg>
						<div class="bridge-reveal" id="bridge-message"><strong>Victor Z.</strong><span>I turn ambiguous product problems into governed systems — across languages, agents, and data pipelines.</span></div>
					</div>
					<p class="bridge-hint">Hover or focus the map to reveal the principle</p>

					<svg class="skills-fork" viewBox="0 0 1248 110" preserveAspectRatio="none" aria-hidden="true"><path d="M644 0 C644 30 315 45 146 105" /><path d="M644 0 C644 35 500 48 465 105" /><path d="M644 0 C644 35 770 48 783 105" /><path d="M644 0 C644 30 988 45 1102 105" /></svg>
					<div class="skills-grid" aria-label="What I do">
						<article class="skill-card"><span class="skill-icon" aria-hidden="true">📱</span><h3>Mobile Development</h3><p>Building production mobile apps across iOS native and React Native, with strong focus on maintainability, performance, and product delivery.</p><div class="tag-list"><span>Swift / SwiftUI</span><span>UIKit</span><span>React Native</span><span>Core Data</span></div></article>
						<article class="skill-card"><span class="skill-icon" aria-hidden="true">🌐</span><h3>Full Stack Development</h3><p>Building scalable web applications with modern JavaScript frameworks and robust backend services.</p><div class="tag-list"><span>React</span><span>Next.js</span><span>Node.js</span><span>FastAPI</span></div></article>
						<article class="skill-card"><span class="skill-icon" aria-hidden="true">💻</span><h3>Desktop Development</h3><p>Building and modernizing desktop applications with C#, .NET, C++, and platform-specific UI frameworks.</p><div class="tag-list"><span>C#</span><span>.NET Framework</span><span>C++</span><span>macOS (SwiftUI)</span></div></article>
						<article class="skill-card"><span class="skill-icon" aria-hidden="true">🎮</span><h3>Game Design</h3><p>Spearheaded core gameplay and monetization design for a mobile game that reached No. 9 in Games and No. 1 in Sports on the Apple App Store (China), on May 3, 2015.</p><div class="tag-list"><span>Gameplay Design</span><span>UI/UX</span><span>Storytelling</span><span>Ranking System</span></div></article>
					</div>
				</div>
			</section>

			<!-- Medal + Intro: bridge from Home's "what" to About's "how I think" -->
			<section class="story" id="story">
				<div class="container story-grid">
					<img src="/images/proof/carleton-university-medal.webp" alt="Carleton University Medal in Computer Science, engraved with Yiwei Zhang, 2020, held open in its presentation box" class="story-image" loading="lazy" />
					<div class="story-body">
						<h2>From Ranking Systems to System Design</h2>
						<p>
							In 2020 I graduated top of my Computer Science class at Carleton University, awarded the University Medal.
						</p>
						<p>
							My path ran through urban planning at Peking University, then four years of mobile game design — where Wild Dunk taught me to design ranking ladders and economy systems — before I moved fully into software engineering.
						</p>
						<p>
							<a href="/about" class="story-link">Curious how I break down mobile systems today? →</a>
						</p>
					</div>
				</div>
			</section>

			<!-- More Work -->
			<section class="projects" id="projects">
				<div class="container">
					<h2 class="section-title">More Work</h2>
					<div class="projects-grid">
						<div class="project-card">
							<div class="project-icon">🏥</div>
							<h3>VitalMark Wellness</h3>
							<p>HealthKit Integration &amp; SwiftUI</p>
							<a href="https://apps.apple.com/us/app/vitalmark-wellness-fitness/id6745228850" target="_blank" class="project-link">View on App Store →</a>
						</div>
						<div class="project-card">
							<div class="project-icon">🤖</div>
							<h3>Ninja AI Agentic App</h3>
							<p>LLM Streaming &amp; Multi-Model AI</p>
							<a href="https://apps.apple.com/us/app/ninja-ai-chat-code-create/id6702030312" target="_blank" class="project-link">View on App Store →</a>
						</div>
						<div class="project-card">
							<div class="project-icon">🎬</div>
							<h3>ZZZ Movie Rec System</h3>
							<p>ML-powered Movie Recommendations</p>
							<a href="https://zzz-movie-rec-system.vercel.app/" target="_blank" class="project-link">View Project →</a>
						</div>
						<div class="project-card">
							<div class="project-icon">📚</div>
							<h3>TutorOcean iOS App</h3>
							<p>Professional Tutoring Platform</p>
							<a href="https://apps.apple.com/ca/app/tutorocean/id1480876532" target="_blank" class="project-link">View on App Store →</a>
						</div>
						<div class="project-card">
							<div class="project-icon">🔍</div>
							<h3>cuHacking 2020 Winner</h3>
							<p>Crime Scene Forensic Analyzer</p>
							<a href="https://devpost.com/software/murder-on-2nd-floor-web-forensic-analyzer" target="_blank" class="project-link">View on Devpost →</a>
						</div>
						<div class="project-card">
							<div class="project-icon">🏆</div>
							<h3>cuHacking 2019 Winner</h3>
							<p>Amazon Connect Pizza Order System</p>
							<a href="https://devpost.com/software/cuhackingamazonconnect" target="_blank" class="project-link">View on Devpost →</a>
						</div>
					</div>
				</div>
			</section>

			<!-- Contact Section -->
			<section class="contact">
				<div class="container">
					<h2 class="section-title">Let's Connect</h2>
					<p class="contact-text">Interested in collaborating or just want to chat? I'd love to hear from you!</p>
					<div class="contact-buttons">
						<a href={`mailto:${EMAIL}`} class="btn btn-primary">Email Me</a>
						<a href={GITHUB_URL} target="_blank" class="btn btn-secondary">GitHub</a>
						<a href={WTCRAFT_URL} target="_blank" class="btn btn-secondary">wtcraft</a>
						<a href={LINKEDIN_URL} target="_blank" class="btn btn-secondary">LinkedIn</a>
						<a href={MEDIUM_URL} target="_blank" class="btn btn-secondary">Medium</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			// Click-to-play facade for the Wild Dunk video: no third-party iframe/JS
			// is loaded until the visitor actually asks to watch.
			document.querySelectorAll('.video-facade').forEach((facade) => {
				const play = () => {
					const videoId = facade.getAttribute('data-video-id');
					if (!videoId) return;
					const iframe = document.createElement('iframe');
					iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1`;
					iframe.title = 'Wild Dunk gameplay';
					iframe.setAttribute('frameborder', '0');
					iframe.setAttribute(
						'allow',
						'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture'
					);
					iframe.setAttribute('allowfullscreen', '');
					iframe.loading = 'lazy';
					facade.replaceChildren(iframe);
					facade.classList.add('is-playing');
				};
				facade.addEventListener('click', play);
				facade.addEventListener('keydown', (e) => {
					if (e instanceof KeyboardEvent && (e.key === 'Enter' || e.key === ' ')) {
						e.preventDefault();
						play();
					}
				});
			});
		</script>
	</body>
</html>

<style>
	.homepage {
		width: 100%;
		max-width: 100%;
		padding: 0;
	}

	/* Hero */
	.hero {
		position: relative;
		overflow: hidden;
		padding: clamp(4rem, 11vw, 8rem) 1.5rem clamp(3rem, 7vw, 5rem);
		background:
			radial-gradient(720px 420px at 50% -10%, var(--accent-soft) 0%, rgba(227, 244, 239, 0) 70%);
	}

	.hero::after {
		content: '';
		position: absolute;
		inset: auto 0 0 0;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--line), transparent);
	}

	.hero-content {
		position: relative;
		z-index: 2;
		text-align: center;
		max-width: 720px;
		margin: 0 auto;
	}

	.profile-image {
		width: 132px;
		height: 132px;
		border-radius: 50%;
		object-fit: cover;
		border: 4px solid var(--surface-raised);
		box-shadow: 0 0 0 1px var(--line), var(--shadow-lg);
		margin: 0 auto 1.75rem;
		display: block;
		transition: transform var(--dur) var(--ease);
	}
	.profile-image:hover {
		transform: scale(1.04);
	}

	.hero-title {
		font-size: clamp(2.5rem, 6vw, 3.6rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		margin-bottom: 0.6rem;
		color: rgb(var(--black));
	}
	.highlight {
		background: linear-gradient(120deg, var(--accent) 0%, var(--accent-bright) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-subtitle {
		font-size: 1.3rem;
		margin: 0 0 0.2rem;
		font-weight: 700;
		color: var(--accent-dark);
	}
	.hero-subtitle-secondary {
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		color: rgb(var(--gray));
		margin-bottom: 1.5rem;
	}

	.hero-description {
		font-size: 1.075rem;
		line-height: 1.7;
		color: rgb(var(--gray-dark));
		max-width: 620px;
		margin: 0 auto 2rem;
	}

	.hero-cta {
		display: flex;
		gap: 0.85rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	/* Proof strip */
	.proof {
		padding: 0 0 clamp(3rem, 7vw, 5rem);
	}
	.proof-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		max-width: 900px;
		margin: 0 auto;
	}
	@media (min-width: 700px) {
		.proof-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	.proof-tile {
		display: flex;
		align-items: center;
		gap: 1rem;
		background: var(--surface-raised);
		padding: 1rem;
		border-radius: var(--radius);
		border: 1px solid var(--line);
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease), border-color 0.25s var(--ease);
	}
	.proof-tile:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-md);
		border-color: rgba(var(--accent-rgb), 0.32);
	}
	.proof-thumb {
		width: 52px;
		height: 52px;
		object-fit: cover;
		border-radius: 10px;
		flex-shrink: 0;
		box-shadow: 0 0 0 1px var(--line);
	}
	.proof-thumb-medal {
		object-position: center 30%;
	}
	.proof-icon {
		width: 52px;
		height: 52px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 1.5rem;
		border-radius: 10px;
		background: var(--accent-soft);
		flex-shrink: 0;
	}
	.proof-title {
		font-size: 0.9rem;
		font-weight: 700;
		color: rgb(var(--black));
		line-height: 1.3;
	}
	.proof-sub {
		font-size: 0.78rem;
		color: rgb(var(--gray));
		margin-top: 0.15rem;
	}

	/* Sections */
	section {
		padding: var(--space-section) 0;
	}
	.container {
		max-width: var(--content);
		margin: 0 auto;
		padding: 0 1.5rem;
	}
	.section-title {
		text-align: center;
		font-size: clamp(1.9rem, 3.6vw, 2.5rem);
		margin: 0 0 1rem;
		position: relative;
		padding-bottom: 1rem;
	}
	.section-title::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 50%;
		transform: translateX(-50%);
		width: 52px;
		height: 3px;
		border-radius: 999px;
		background: var(--accent);
	}

	/* Signature Work */
	.signature {
		background: var(--surface-muted);
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}
	.signature-intro {
		text-align: center;
		max-width: 620px;
		margin: 0 auto clamp(2.5rem, 5vw, 3.5rem);
		color: rgb(var(--gray-dark));
		font-size: 1.02rem;
		line-height: 1.65;
	}

	.signature-grid {
		display: grid;
		grid-template-columns: 1fr;
		row-gap: clamp(3rem, 6vw, 4.5rem);
	}
	.timeline-rail {
		display: none;
	}
	@media (min-width: 1040px) {
		.signature-grid {
			grid-template-columns: 88px 1fr;
			column-gap: 2rem;
		}
		.timeline-rail {
			display: block;
			position: relative;
			grid-column: 1;
			grid-row: 1 / span 4;
		}
	}
	.timeline-path {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.timeline-path path {
		fill: none;
		stroke: var(--accent);
		stroke-opacity: 0.55;
		stroke-width: 6px;
		stroke-linecap: round;
		stroke-linejoin: round;
		vector-effect: non-scaling-stroke;
	}
	.timeline-node {
		position: absolute;
		left: 0;
		right: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		transform: translateY(-50%);
	}
	.node-dot {
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 4px var(--accent-soft);
		margin-bottom: 0.4rem;
	}
	.node-label {
		font-size: 0.62rem;
		line-height: 1.4;
		text-align: center;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		font-weight: 700;
		color: rgb(var(--gray));
		padding: 0 0.15rem;
	}

	.sig-block {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
		background: var(--surface-raised);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		padding: clamp(1.5rem, 3vw, 2.25rem);
		box-shadow: var(--shadow-sm);
	}
	@media (min-width: 860px) {
		.sig-block {
			flex-direction: row;
			align-items: center;
			gap: 2.5rem;
		}
		.sig-block.sig-reverse {
			flex-direction: row-reverse;
		}
		.sig-media,
		.sig-body {
			flex: 1 1 50%;
			min-width: 0;
		}
	}

	/* Fan-out: the path's end branches into the current skill set */
	.skills-fanout {
		margin-top: clamp(2.5rem, 5vw, 3.5rem);
	}
	.fanout-caption {
		text-align: center;
		font-size: 0.74rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: rgb(var(--gray));
		margin: 0 0 0.5rem;
	}
	.fanout-svg {
		display: block;
		width: 100%;
		max-width: 720px;
		height: 56px;
		margin: 0 auto;
	}
	.fanout-svg path {
		fill: none;
		stroke: var(--accent);
		stroke-opacity: 0.4;
		stroke-width: 2px;
		stroke-linecap: round;
	}
	.skills-row {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.9rem;
		max-width: 760px;
		margin: 0 auto;
	}
	@media (min-width: 700px) {
		.skills-row {
			grid-template-columns: repeat(4, 1fr);
		}
	}
	.skill-chip {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		text-align: center;
		background: var(--surface-raised);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 1.1rem 0.75rem;
		box-shadow: var(--shadow-sm);
		transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
	}
	.skill-chip:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-md);
	}
	.skill-icon {
		width: 2.4rem;
		height: 2.4rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 1.2rem;
		border-radius: 10px;
		background: var(--accent-soft);
	}
	.skill-label {
		font-size: 0.82rem;
		font-weight: 700;
		color: rgb(var(--black));
		line-height: 1.3;
	}

	.sig-body h3 {
		font-size: 1.4rem;
		margin: 0.35rem 0 0.75rem;
		color: rgb(var(--black));
	}
	.sig-body p {
		color: rgb(var(--gray-dark));
		font-size: 0.98rem;
		line-height: 1.7;
		margin: 0 0 1rem;
	}
	.sig-cta {
		display: flex;
		gap: 0.6rem;
		flex-wrap: wrap;
	}
	.btn-sm {
		padding: 0.6rem 1.25rem;
		font-size: 0.86rem;
	}

	/* Video facade (Wild Dunk) */
	.video-facade {
		position: relative;
		aspect-ratio: 4 / 3;
		border-radius: var(--radius);
		overflow: hidden;
		cursor: pointer;
		box-shadow: var(--shadow-md);
		background: #000;
	}
	.video-facade img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.4s var(--ease);
	}
	.video-facade:hover img {
		transform: scale(1.03);
	}
	.video-facade.is-playing iframe {
		width: 100%;
		height: 100%;
		display: block;
		border: 0;
	}
	.play-btn {
		position: absolute;
		inset: 0;
		margin: auto;
		width: 58px;
		height: 58px;
		border-radius: 50%;
		background: rgba(17, 24, 39, 0.72);
		color: #fff;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: transform 0.25s var(--ease), background 0.25s var(--ease);
	}
	.video-facade:hover .play-btn {
		transform: scale(1.08);
		background: var(--accent);
	}

	.rank-card {
		margin: 0.9rem 0 0;
	}
	.rank-card img {
		width: 100%;
		border-radius: 10px;
		box-shadow: 0 0 0 1px var(--line);
		display: block;
	}
	.rank-card figcaption {
		font-size: 0.72rem;
		line-height: 1.5;
		color: rgb(var(--gray));
		margin-top: 0.5rem;
	}

	/* Wishes phone frame */
	.phone-frame {
		max-width: 260px;
		margin: 0 auto;
		border-radius: 28px;
		overflow: hidden;
		box-shadow: var(--shadow-lg);
		border: 6px solid var(--surface-deep);
	}
	.sig-video {
		width: 100%;
		display: block;
	}

	/* wtcraft terminal card */
	.terminal-card {
		background: var(--surface-deep);
		border-radius: var(--radius);
		overflow: hidden;
		box-shadow: var(--shadow-md);
	}
	.terminal-titlebar {
		display: flex;
		gap: 0.4rem;
		padding: 0.7rem 0.85rem;
		background: rgba(255, 255, 255, 0.05);
	}
	.terminal-titlebar span {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.18);
	}
	.terminal-body {
		margin: 0;
		padding: 1.25rem 1.4rem 1.5rem;
		font-family: ui-monospace, "SF Mono", Menlo, monospace;
		font-size: 0.86rem;
		line-height: 1.85;
		color: rgba(255, 255, 255, 0.82);
		overflow-x: auto;
	}
	.t-prompt {
		color: var(--on-dark-accent);
	}
	.t-ok {
		color: #4ade80;
	}

	/* EDF frame */
	.sig-frame {
		width: 100%;
		border-radius: var(--radius);
		box-shadow: var(--shadow-md);
		display: block;
	}

	/* Story (medal + intro bridge to About) */
	.story-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
		align-items: center;
		max-width: 900px;
	}
	@media (min-width: 700px) {
		.story-grid {
			grid-template-columns: 280px 1fr;
			gap: 3rem;
		}
	}
	.story-image {
		width: 100%;
		max-width: 280px;
		margin: 0 auto;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-lg);
		display: block;
	}
	.story-body h2 {
		font-size: clamp(1.6rem, 3vw, 2.1rem);
		margin: 0 0 1rem;
	}
	.story-body p {
		color: rgb(var(--gray-dark));
		font-size: 1rem;
		line-height: 1.75;
		margin: 0 0 1rem;
	}
	.story-link {
		font-weight: 700;
		color: var(--accent);
	}
	.story-link:hover {
		color: var(--accent-dark);
	}

	/* Project cards (More Work) */
	.projects-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}
	@media (min-width: 700px) {
		.projects-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (min-width: 1000px) {
		.projects-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.project-card {
		background: var(--surface-raised);
		padding: 2rem 1.75rem;
		border-radius: var(--radius-lg);
		border: 1px solid var(--line);
		box-shadow: var(--shadow-sm);
		transition:
			transform 0.3s var(--ease),
			box-shadow 0.3s var(--ease),
			border-color 0.3s var(--ease);
	}
	.project-card:hover {
		transform: translateY(-6px);
		box-shadow: var(--shadow-lg);
		border-color: rgba(var(--accent-rgb), 0.32);
	}

	.project-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 3.25rem;
		height: 3.25rem;
		font-size: 1.6rem;
		border-radius: 14px;
		background: var(--accent-soft);
		margin-bottom: 1.25rem;
	}

	.project-card h3 {
		font-size: 1.15rem;
		margin-bottom: 0.35rem;
		color: rgb(var(--black));
	}
	.project-card p {
		color: rgb(var(--gray));
		font-size: 0.95rem;
		margin-bottom: 1.1rem;
	}
	.project-link {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		color: var(--accent);
		font-weight: 700;
		font-size: 0.92rem;
		transition: gap 0.2s var(--ease), color 0.2s var(--ease);
	}
	.project-link:hover {
		color: var(--accent-dark);
		gap: 0.6rem;
	}

	/* Contact */
	.contact {
		background:
			radial-gradient(620px 320px at 80% 0%, var(--on-dark-glow) 0%, transparent 60%),
			var(--surface-deep);
		color: rgba(255, 255, 255, 0.86);
		position: relative;
	}
	.contact .section-title {
		color: #fff;
	}
	.contact .section-title::after {
		background: var(--on-dark-accent);
	}
	.contact-text {
		text-align: center;
		font-size: 1.08rem;
		max-width: 540px;
		margin: 0 auto 2.25rem;
		color: rgba(255, 255, 255, 0.72);
	}
	.contact-buttons {
		display: flex;
		justify-content: center;
		gap: 0.75rem;
		flex-wrap: wrap;
	}
	.contact .btn-primary {
		background: var(--on-dark-accent);
		color: var(--on-dark-accent-text);
		box-shadow: 0 14px 34px rgba(0, 0, 0, 0.4);
	}
	.contact .btn-primary:hover {
		background: #f4f4f5;
		color: var(--on-dark-accent-text);
		transform: translateY(-2px);
	}
	.contact .btn-secondary {
		background: rgba(255, 255, 255, 0.06);
		color: #fff;
		border: 1px solid rgba(255, 255, 255, 0.22);
		box-shadow: none;
	}
	.contact .btn-secondary:hover {
		background: rgba(255, 255, 255, 0.13);
		color: #fff;
		border-color: rgba(255, 255, 255, 0.4);
		transform: translateY(-2px);
	}

	/* Home v2 — product-page composition */
	.hero {
		padding: clamp(4.5rem, 8vw, 7rem) 1.5rem clamp(4rem, 7vw, 6rem);
		background: radial-gradient(900px 540px at 14% -8%, var(--accent-soft) 0%, rgba(238, 240, 255, 0) 68%);
	}
	.hero-inner {
		display: grid;
		grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.92fr);
		align-items: center;
		gap: clamp(3rem, 6vw, 5.5rem);
		max-width: 1248px;
		margin: 0 auto;
	}
	.hero-copy {
		position: relative;
		z-index: 2;
	}
	.hero-kicker {
		display: inline-flex;
		align-items: center;
		margin: 0 0 1.6rem;
		padding: 0.45rem 1rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.88);
		box-shadow: var(--shadow-sm);
		color: var(--accent);
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		line-height: 1.35;
		text-transform: uppercase;
	}
	.hero h1 {
		max-width: 710px;
		margin: 0 0 1.4rem;
		font-size: clamp(3.2rem, 5.15vw, 4.65rem);
		letter-spacing: -0.04em;
		line-height: 1.03;
	}
	.hero-description {
		max-width: 590px;
		margin: 0 0 2rem;
		font-size: clamp(1.05rem, 1.5vw, 1.2rem);
		line-height: 1.65;
	}
	.hero-cta {
		justify-content: flex-start;
		margin-bottom: 1.4rem;
	}
	.hero-credibility {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.88rem;
		font-weight: 700;
		letter-spacing: 0.02em;
	}
	.hero-visual {
		position: relative;
		justify-self: center;
		width: min(100%, 440px);
		padding: 0 0 2.5rem 2rem;
	}
	.hero-art {
		position: relative;
		aspect-ratio: 1;
		overflow: hidden;
		border-radius: 32px;
		background: var(--surface-deep);
		box-shadow: var(--shadow-lg);
	}
	.hero-art::after {
		content: '';
		position: absolute;
		inset: 50% 0 0;
		background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.52));
	}
	.hero-art img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
	}
	.hero-art > span {
		position: absolute;
		z-index: 1;
		left: 1.35rem;
		bottom: 1.25rem;
		color: rgba(255, 255, 255, 0.9);
		font-size: 0.74rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.hero-proof {
		position: absolute;
		z-index: 2;
		left: -1rem;
		bottom: 0;
		display: flex;
		align-items: center;
		gap: 0.8rem;
		min-width: 240px;
		padding: 0.9rem 1.05rem;
		border: 1px solid rgba(228, 228, 231, 0.75);
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.94);
		box-shadow: var(--shadow-lg);
		backdrop-filter: blur(14px);
	}
	.hero-proof img {
		width: 50px;
		height: 50px;
		flex: 0 0 auto;
		object-fit: cover;
		object-position: center 25%;
		border-radius: 10px;
	}
	.hero-proof span {
		display: grid;
		line-height: 1.25;
	}
	.hero-proof strong {
		font-size: 0.9rem;
	}
	.hero-proof small {
		margin-top: 0.22rem;
		color: rgb(var(--gray));
		font-size: 0.76rem;
	}

	.proof {
		padding: 0 0 clamp(5rem, 9vw, 8rem);
	}
	.proof-grid {
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1rem, 2.4vw, 1.75rem);
		max-width: 1248px;
	}
	.proof-card {
		display: block;
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: var(--surface-raised);
		box-shadow: var(--shadow-md);
		color: inherit;
		transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s var(--ease);
	}
	.proof-card:hover {
		transform: translateY(-6px);
		border-color: rgba(var(--accent-rgb), 0.3);
		box-shadow: var(--shadow-lg);
	}
	.proof-media {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 210px;
		overflow: hidden;
		background: var(--accent-soft);
	}
	.proof-media img {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: 0;
	}
	.proof-medal {
		background: #151515;
	}
	.proof-medal img {
		object-fit: cover;
		object-position: center 23%;
	}
	.proof-rank {
		padding: 1.3rem;
	}
	.proof-rank img {
		height: auto;
		object-fit: contain;
		border-radius: 9px;
		box-shadow: 0 0 0 1px var(--line), var(--shadow-sm);
	}
	.proof-trophy {
		background: linear-gradient(135deg, var(--accent-soft), #fff);
		font-size: 4.4rem;
	}
	.proof-copy {
		display: grid;
		gap: 0.35rem;
		padding: 1.4rem 1.55rem 1.65rem;
	}
	.proof-copy strong {
		font-size: 1.14rem;
		line-height: 1.3;
	}
	.proof-copy span {
		color: rgb(var(--gray));
		font-size: 0.88rem;
	}

	.signature {
		overflow: hidden;
		padding: clamp(5rem, 8vw, 7rem) 1.5rem clamp(6rem, 10vw, 9rem);
	}
	.signature-heading {
		margin-bottom: clamp(3.5rem, 6vw, 5rem);
		text-align: center;
	}
	.signature-heading h2 {
		margin: 0.45rem 0 1rem;
		font-size: clamp(2.4rem, 4vw, 3.3rem);
		letter-spacing: -0.035em;
	}
	.signature-heading > p:last-child {
		max-width: 650px;
		margin: 0 auto;
		color: rgb(var(--gray-dark));
		font-size: 1.04rem;
	}
	.arc-flow {
		position: relative;
		max-width: 1248px;
		margin: 0 auto;
	}
	.desktop-career-route {
		display: none;
		pointer-events: none;
	}
	.works-layout {
		position: relative;
	}
	.career-labels {
		display: none;
	}
	.signature-list {
		display: grid;
		gap: clamp(2.5rem, 5vw, 5rem);
	}
	.sig-block {
		position: relative;
		z-index: 3;
		gap: clamp(1.75rem, 3.4vw, 2.75rem);
		padding: clamp(1.5rem, 3vw, 2.5rem);
		box-shadow: var(--shadow-md);
	}
	.sig-block:hover {
		box-shadow: var(--shadow-lg);
	}
	.sig-body h3 {
		margin: 0.45rem 0 0.9rem;
		font-size: clamp(1.5rem, 2.3vw, 1.85rem);
		letter-spacing: -0.025em;
	}
	.sig-body p {
		font-size: 1rem;
	}
	.sig-media,
	.sig-body {
		min-width: 0;
	}
	.sig-frame,
	.video-facade,
	.terminal-card {
		box-shadow: var(--shadow-lg);
	}
	.wishes-frame {
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}
	.play-btn svg {
		width: 22px;
		height: 22px;
	}

	.bridge-scene {
		position: relative;
		z-index: 1;
		width: min(720px, 100%);
		aspect-ratio: 720 / 531;
		margin: 0 auto;
		overflow: hidden;
		border-radius: var(--radius);
		box-shadow: var(--shadow-lg);
		isolation: isolate;
	}
	.bridge-scene > img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
	}
	.bridge-badge {
		position: absolute;
		z-index: 5;
		background: rgba(255, 255, 255, 0.9);
		box-shadow: var(--shadow-sm);
		backdrop-filter: blur(8px);
	}
