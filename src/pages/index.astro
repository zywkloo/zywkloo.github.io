					<!-- Color Theme Switcher Widget -->
					<div class="theme-palette-bar" aria-label="Paper Theme Switcher">
						<span class="theme-bar-label">SITE TONE // PAPER SYSTEM:</span>
						<div class="theme-pills">
							<button type="button" class="theme-pill carbon active" data-theme="carbon" title="玄纸泥金 · Carbon Washi &amp; Gold">
								<span class="pill-swatch" style="background: #d4a373;"></span>
								<span class="pill-title">Carbon</span>
							</button>
							<button type="button" class="theme-pill operator" data-theme="operator" title="Operator Blue · Deep-blue systems console">
								<span class="pill-swatch" style="background: #69c7d5;"></span>
								<span class="pill-title">Operator Blue</span>
							</button>
