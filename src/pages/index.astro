			// Interactive Hero Stage Deck (Layered depth shift carousel)
			const initHeroStage = () => {
				const stage = document.getElementById('hero-stage');
				if (!stage) return;

				const cards = Array.from(stage.querySelectorAll('.stage-card'));
				const pills = Array.from(stage.querySelectorAll('.stage-pill'));
				const prevBtn = document.getElementById('stage-prev-btn');
				const nextBtn = document.getElementById('stage-next-btn');
				const activeLabel = document.getElementById('stage-active-label');
				let currentIndex = 0;
				let isTransitioning = false;
				let timer = null;

				const updateCards = (nextIndex) => {
					if (isTransitioning && nextIndex === currentIndex) return;
					isTransitioning = true;
					currentIndex = (nextIndex + cards.length) % cards.length;
					const prevIndex = (currentIndex - 1 + cards.length) % cards.length;
					const nextIdx = (currentIndex + 1) % cards.length;

					cards.forEach((card, idx) => {
						const video = card.querySelector('video');
						card.classList.remove('is-center', 'is-prev', 'is-next', 'is-hidden');

						if (idx === currentIndex) {
							card.classList.add('is-center');
							if (video) {
								video.currentTime = 0;
								video.muted = true; // Always muted so audio never blasts unexpectedly
								video.play().catch(() => {});
							}
							if (activeLabel) {
								activeLabel.textContent = card.getAttribute('data-label') || '';
							}
						} else if (idx === prevIndex) {
							card.classList.add('is-prev');
							if (video) {
								video.pause();
							}
						} else if (idx === nextIdx) {
							card.classList.add('is-next');
							if (video) {
								video.pause();
							}
						} else {
							card.classList.add('is-hidden');
							if (video) {
								video.pause();
							}
						}
					});

					pills.forEach((pill, idx) => {
						pill.classList.toggle('active', idx === currentIndex);
						pill.setAttribute('aria-selected', idx === currentIndex ? 'true' : 'false');
					});

					clearTimeout(timer);
					// Auto shift timer fallback (10s)
					timer = setTimeout(() => {
						updateCards(currentIndex + 1);
					}, 10000);

					setTimeout(() => {
						isTransitioning = false;
					}, 450);
				};

				// Listen for 'ended' event on each card's video for automatic shift
				cards.forEach((card) => {
					const video = card.querySelector('video');
					if (video) {
						video.addEventListener('ended', () => {
							if (card.classList.contains('is-center')) {
								updateCards(currentIndex + 1);
							}
						});
					}

					// Clicking left card or right card directly shifts
					card.addEventListener('click', (e) => {
						if (e.target && e.target.closest && e.target.closest('.stage-card-link')) return;

						if (card.classList.contains('is-prev')) {
							e.preventDefault();
							updateCards(currentIndex - 1);
						} else if (card.classList.contains('is-next')) {
							e.preventDefault();
							updateCards(currentIndex + 1);
						}
					});
				});

				// Prev and Next arrow buttons
				if (prevBtn) {
					prevBtn.addEventListener('click', () => {
						updateCards(currentIndex - 1);
					});
				}
				if (nextBtn) {
					nextBtn.addEventListener('click', () => {
						updateCards(currentIndex + 1);
					});
				}

				// Indicator pills
				pills.forEach((pill, idx) => {
					pill.addEventListener('click', () => {
						updateCards(idx);
					});
				});

				// Start with card 0
				updateCards(0);
			};

			initHeroStage();
			document.addEventListener('astro:after-swap', initHeroStage);

			// Chapter 01 Native Video Volume & Playback Setup
			const initChapterVideo = () => {
				const video = document.querySelector('.chapter-native-video');
				if (!video) return;
				// Set comfortable initial volume (40%) to ensure smooth, pleasant audio
				video.volume = 0.4;
			};

			initChapterVideo();
			document.addEventListener('astro:after-swap', initChapterVideo);

			// Paper Theme Switcher with localStorage persistence
			const initPaperTheme = () => {
				try {
					const savedTheme = localStorage.getItem('apaper-theme') || 'washi';
					document.documentElement.setAttribute('data-paper-theme', savedTheme);
					document.querySelectorAll('.theme-pill').forEach((btn) => {
						btn.classList.toggle('active', btn.getAttribute('data-theme') === savedTheme);
					});
				} catch (_) {}

				document.querySelectorAll('.theme-pill').forEach((btn) => {
					btn.addEventListener('click', () => {
						const theme = btn.getAttribute('data-theme');
						if (!theme) return;
						document.documentElement.setAttribute('data-paper-theme', theme);
						try {
							localStorage.setItem('apaper-theme', theme);
						} catch (_) {}
						document.querySelectorAll('.theme-pill').forEach((b) => b.classList.remove('active'));
						btn.classList.add('active');
					});
				});
			};

			initPaperTheme();
			document.addEventListener('astro:after-swap', initPaperTheme);

			// Progressive Euler Bridges -> Skills Dispersal Flow Controller
			const initEulerFlow = () => {
				const stage = document.getElementById('pivot-stage');
				const path = document.getElementById('euler-active-path');
				const runner = document.getElementById('euler-runner');
				const bridgePins = Array.from(document.querySelectorAll('.bridge-pin'));
				const fork = document.getElementById('topological-fork');
				const forkBranches = Array.from(document.querySelectorAll('.fork-branch'));
				const cards = Array.from(document.querySelectorAll('#specs-grid .spec-card'));

				if (!stage || !path) return;

				let hasAnimated = false;
				let pathLength = 0;
				try {
					pathLength = path.getTotalLength();
					path.style.strokeDasharray = `${pathLength}`;
					path.style.strokeDashoffset = `${pathLength}`;
				} catch (_) {
					pathLength = 1500;
				}

				// Initialize fork branches stroke dasharray
				forkBranches.forEach((branch) => {
					try {
						const len = branch.getTotalLength();
						branch.style.strokeDasharray = `${len}`;
						branch.style.strokeDashoffset = `${len}`;
					} catch (_) {}
				});

				const triggerAnimation = () => {
					if (hasAnimated) return;
					hasAnimated = true;
					stage.classList.add('is-active');

					// Reduced motion check
					if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
						path.style.strokeDashoffset = '0';
						bridgePins.forEach((p) => p.classList.add('is-passed'));
						forkBranches.forEach((b) => (b.style.strokeDashoffset = '0'));
						cards.forEach((c) => c.classList.add('is-revealed'));
						return;
					}

					// Animate path drawing across the 7 bridges in 2.2s
					const duration = 2200;
					const startTime = performance.now();

					if (runner) runner.style.opacity = '1';

					const step = (currentTime) => {
						const elapsed = currentTime - startTime;
						const progress = Math.min(elapsed / duration, 1);
						const easeProgress = 1 - Math.pow(1 - progress, 3);
						const currentOffset = pathLength * (1 - easeProgress);
						path.style.strokeDashoffset = `${currentOffset}`;

						// Move runner bead along path
						if (runner && typeof path.getPointAtLength === 'function') {
							try {
								const pt = path.getPointAtLength(pathLength * easeProgress);
								runner.setAttribute('cx', `${pt.x}`);
								runner.setAttribute('cy', `${pt.y}`);
							} catch (_) {}
						}

						// Illuminate bridge pins as runner passes near their coordinates
						bridgePins.forEach((pin) => {
							const bx = parseFloat(pin.getAttribute('cx') || '0');
							const by = parseFloat(pin.getAttribute('cy') || '0');
							if (runner) {
								const rx = parseFloat(runner.getAttribute('cx') || '0');
								const ry = parseFloat(runner.getAttribute('cy') || '0');
								const distSq = (bx - rx) * (bx - rx) + (by - ry) * (by - ry);
								if (distSq < 32 * 32) {
									pin.classList.add('is-passed');
								}
							}
						});

						if (progress < 1) {
							requestAnimationFrame(step);
						} else {
							// Bridge flow completed!
							if (runner) runner.style.opacity = '0.35';

							// Trigger Fork branches downward animation
							if (fork) fork.classList.add('is-active');
							forkBranches.forEach((branch, idx) => {
								setTimeout(() => {
									branch.style.transition = 'stroke-dashoffset 0.65s cubic-bezier(0.22, 1, 0.36, 1)';
									branch.style.strokeDashoffset = '0';
								}, idx * 60);
							});

							// Reveal the 4 Skill cards with staggered entrance
							cards.forEach((card, idx) => {
								setTimeout(() => {
									card.classList.add('is-revealed');
								}, 360 + idx * 100);
							});
						}
					};

					requestAnimationFrame(step);
				};

				// IntersectionObserver to start as user scrolls near Chapter 05
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								triggerAnimation();
								observer.disconnect();
							}
						});
					},
					{ threshold: 0.15, rootMargin: '0px 0px -50px 0px' }
				);

				observer.observe(stage);
			};

			initEulerFlow();
			document.addEventListener('astro:after-swap', initEulerFlow);
		</script>
	</body>
</html>

