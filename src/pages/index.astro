			<!-- Contact / Correspondence Section (Refined Paper Colophon) -->
			<section class="contact" id="contact" aria-labelledby="contact-title">
				<div class="container">
					<div class="contact-plate">
						<div class="contact-meta-header">
							<span class="contact-wordmark">
								<span class="contact-mark-glyph">信</span>
								<span>COLOPHON // DIRECT DISPATCH</span>
